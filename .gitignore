node_modules/
dist/
.astro/
.DS_Store
.env
.env.*
*.log

# Gate A screenshots regenerate from the bundle in minutes. Only the exception record is tracked.
design/gate-a/*
!design/gate-a/EXCEPTIONS.md

# Throwaway diagnostics, never part of the port.
scripts/.diag/

# Reference captures are generated, 154MB. The manifest pins the contract instead.
design/reference/*.png

# Overlay verification screenshots, regenerated by scripts/verify-overlay.mjs
design/gate-a/overlay-check/
.vercel

# Camera originals for the event-page video strips. These are 4K phone clips, roughly
# 640 MB in total. The web copies in public/videos are what ship. Anything left in
# public/ is copied verbatim into the build, so the sources are parked outside it.
design/source-video/

# Full-size artwork the client drops in for optimisation. The web copies live in
# public/images/site; anything left in public/ is copied into the build verbatim.
design/source-art/
