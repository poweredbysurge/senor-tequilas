      <div data-dc-tpl="456"><div data-dc-tpl="457" style="display: flex; align-items: center; gap: 10px; font-family: &quot;Barlow Condensed&quot;, sans-serif; font-weight: 600; font-size: 14px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(214, 188, 133);"><span data-dc-tpl="458" style="width: 26px; height: 1px; background: rgba(185, 156, 102, 0.6);"></span>Packages pending from client</div><h2 data-dc-tpl="459" style="color: rgb(246, 239, 228); font-family: &quot;Archivo Black&quot;, sans-serif; font-size: clamp(28px, 5.5vw, 46px); line-height: 1.02; margin: 8px 0px 0px; text-transform: uppercase;"><span class="sc-interp">Birthdays, Graduations and Everything Else Worth Marking</span></h2></div>
