          <a data-dc-tpl="431" href="tel:3015694574" class="scp1" style="text-align: center; border: 1.5px solid rgba(185, 156, 102, 0.75); color: rgb(234, 226, 214); font-weight: 700; font-size: 15px; padding: 16px 14px; border-radius: 12px; min-height: 52px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; background: rgba(18, 18, 16, 0.4);">Call the Events Team</a>
        </div>
        <div data-dc-tpl="432" style="display: flex; flex-wrap: wrap; gap: 8px;">
