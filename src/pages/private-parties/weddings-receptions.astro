---
import Base from '../../layouts/Base.astro';
import Header6 from '../../components/Header6.astro';
import Footer2 from '../../components/Footer2.astro';
---
<Base title="Wedding Reception & Shower Venue | Germantown, MD" description="Weddings, showers and rehearsal dinners in Germantown for up to 100 guests, with a kitchen that has fed this room for years." canonical="https://senortequilas.com/private-parties/weddings-receptions" ogImage="/images/site/open-graph.jpg" route="/private-parties/weddings-receptions" extraTypes={["EventVenue"]}>
<div class="sc-host" data-sc-name="Concept 1 Pages" data-dc-tpl="102"><div data-dc-tpl="6" data-c1p-root="" data-uid="c1pqdvwon" style="color: rgb(234, 226, 214); font-family: Barlow, system-ui, -apple-system, sans-serif; background: rgb(18, 18, 16); min-height: 100%;"><Header6 /><section data-dc-tpl="417" data-screen-label="Event hero" style="position: relative; min-height: clamp(500px, 76vh, 840px); display: flex; align-items: flex-end; overflow: hidden; background: rgb(10, 10, 9);">
  <img data-dc-tpl="418" loading="lazy" decoding="async" src="/images/site/weddings-hero.jpg" alt="A celebration cake brought out to a table of smiling guests" referrerpolicy="no-referrer" style="position: absolute; inset: 0px; width: 100%; height: 100%; object-fit: cover; object-position: center 35%;">
  <div data-dc-tpl="419" aria-hidden="true" style="position: absolute; inset: 0px; background: linear-gradient(rgba(18, 18, 16, 0.5) 0%, rgba(18, 18, 16, 0.1) 35%, rgba(18, 18, 16, 0.9) 72%, rgb(18, 18, 16) 100%);"></div>
  <span data-dc-tpl="420" style="position: absolute; top: calc(env(safe-area-inset-top) + 76px); right: 14px; font-family: &quot;Barlow Condensed&quot;, sans-serif; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: rgb(185, 156, 102); background: rgba(13, 13, 11, 0.75); padding: 5px 9px; border-radius: 999px;"><span class="sc-interp">Placeholder: long table, candles, sparklers</span></span>
  <div data-dc-tpl="421" style="position: relative; width: 100%; max-width: 1180px; margin: 0px auto; padding: 120px clamp(18px, 4.6vw, 48px) clamp(32px, 6vh, 64px); display: flex; flex-direction: column; gap: 22px;">
    <div data-dc-tpl="422">
      <div data-dc-tpl="423" style="display: flex; align-items: center; gap: 10px; font-family: &quot;Barlow Condensed&quot;, sans-serif; font-weight: 600; font-size: 14px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(214, 188, 133);"><span data-dc-tpl="424" style="width: 26px; height: 1px; background: rgba(185, 156, 102, 0.6);"></span><span class="sc-interp">Germantown, MD · Up to 100 Guests</span></div>
      <h1 data-dc-tpl="425" style="color: rgb(246, 239, 228); font-family: &quot;Archivo Black&quot;, sans-serif; font-size: clamp(2.5rem, 4.3vw, 4.5rem); line-height: 0.92; letter-spacing: -0.02em; margin: 12px 0px 0px; max-width: 100%; text-transform: uppercase; text-wrap: balance;"><span class="sc-interp">Weddings, Showers, Receptions</span></h1>
    </div>
    <div data-dc-tpl="426" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 18px 40px; align-items: start; border-top: 1px solid rgba(185, 156, 102, 0.25); padding-top: 22px;">
      <p data-dc-tpl="427" style="font-size: clamp(15px, 1.6vw, 18px); line-height: 1.6; color: rgba(234, 226, 214, 0.88); margin: 0px; max-width: 52ch; text-wrap: pretty;"><span class="sc-interp">Rehearsal dinners, welcome parties, bridal and baby showers, and intimate wedding receptions for up to 120. Real Mexican food, a real bar, and a room that already looks like a party.</span></p>
      <div data-dc-tpl="428" style="display: flex; flex-direction: column; gap: 14px;">
        <div data-dc-tpl="429" style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; max-width: 520px;">
          <a data-dc-tpl="430" href="#inquire" class="scp2" style="text-align: center; background: rgb(56, 176, 73); color: rgb(12, 18, 13); font-weight: 800; font-size: 15px; padding: 16px 14px; border-radius: 12px; min-height: 52px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; box-shadow: rgba(56, 176, 73, 0.35) 0px 0px 30px;"><span class="sc-interp">Book a Tour</span></a>
          <a data-dc-tpl="431" href="tel:3015694574" class="scp1" style="text-align: center; border: 1.5px solid rgba(185, 156, 102, 0.75); color: rgb(234, 226, 214); font-weight: 700; font-size: 15px; padding: 16px 14px; border-radius: 12px; min-height: 52px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; background: rgba(18, 18, 16, 0.4);">Call the Events Team</a>
        </div>
        <div data-dc-tpl="432" style="display: flex; flex-wrap: wrap; gap: 8px;">
          <span data-dc-tpl="434" style="display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: rgba(234, 226, 214, 0.85); border: 1px solid rgba(185, 156, 102, 0.3); border-radius: 999px; padding: 6px 11px;"><span data-dc-tpl="435" style="width: 6px; height: 6px; border-radius: 50%; background: rgb(56, 176, 73);"></span><span class="sc-interp">Four rooms, about 100 each</span></span><span data-dc-tpl="434" style="display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: rgba(234, 226, 214, 0.85); border: 1px solid rgba(185, 156, 102, 0.3); border-radius: 999px; padding: 6px 11px;"><span data-dc-tpl="435" style="width: 6px; height: 6px; border-radius: 50%; background: rgb(56, 176, 73);"></span><span class="sc-interp">Parties from 12</span></span><span data-dc-tpl="434" style="display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: rgba(234, 226, 214, 0.85); border: 1px solid rgba(185, 156, 102, 0.3); border-radius: 999px; padding: 6px 11px;"><span data-dc-tpl="435" style="width: 6px; height: 6px; border-radius: 50%; background: rgb(56, 176, 73);"></span><span class="sc-interp">Showers in the room or on a patio</span></span>
        </div>
      </div>
    </div>
  </div></section><section data-dc-tpl="436" data-screen-label="Event intro" style="background: rgb(18, 18, 16); padding: clamp(40px, 7vw, 88px) 0px;">
  <div data-dc-tpl="437" style="max-width: 1180px; margin: 0px auto; padding: 0px clamp(18px, 4.6vw, 48px); display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: clamp(24px, 5vw, 72px); align-items: start;">
    <h2 data-dc-tpl="438" style="color: rgb(246, 239, 228); font-family: &quot;Archivo Black&quot;, sans-serif; font-size: clamp(26px, 4.6vw, 48px); line-height: 1.05; margin: 0px; text-transform: uppercase; text-wrap: balance;"><span class="sc-interp">The Reception After the Reception, or Instead of It</span></h2>
    <div data-dc-tpl="439" style="display: flex; flex-direction: column; gap: 14px; font-size: 16px; line-height: 1.75; color: rgba(234, 226, 214, 0.85); text-wrap: pretty;">
      <p data-dc-tpl="440" style="margin: 0px;"><span class="sc-interp">Most couples find us for the rehearsal dinner and come back for the shower, the welcome party or the reception itself. The private room works for a plated dinner for 40 or a margarita-fuelled reception for 200 standing.</span></p>
      <p data-dc-tpl="441" style="margin: 0px;"><span class="sc-interp">Showers get the daytime version: a mimosa and paloma bar, and the patio if the weather cooperates. Every event gets a coordinator, custom menu cards, and a kitchen that doesn't do "wedding food."</span></p>
    </div>
  </div></section><section data-dc-tpl="442" data-screen-label="Included" style="background: linear-gradient(rgba(14, 14, 13, 0.78), rgba(10, 10, 9, 0.9)), url(/images/86475be0134bfc90.webp) center center / cover no-repeat; border-top: 1px solid rgba(185, 156, 102, 0.2); padding: clamp(44px, 7vw, 88px) 0px;">
