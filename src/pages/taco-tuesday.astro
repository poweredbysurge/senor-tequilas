---
import Base from '../layouts/Base.astro';
import Header5 from '../components/Header5.astro';
import Footer2 from '../components/Footer2.astro';
---
<Base title="Taco Tuesday & Weekly Specials | Germantown, MD" description="Taco Tuesday in Germantown: street tacos on tortillas pressed this morning, plus free bingo at 8 with prizes." canonical="https://senortequilas.com/taco-tuesday" ogImage="/images/eca8597506381a36.jpg">
<div class="sc-host" data-sc-name="Concept 1 Pages" data-dc-tpl="174"><div data-dc-tpl="6" data-c1p-root="" data-uid="c1pto3v2q" style="color: rgb(234, 226, 214); font-family: Barlow, system-ui, -apple-system, sans-serif; background: rgb(18, 18, 16); min-height: 100%;"><Header5 /><section data-dc-tpl="920" data-screen-label="Taco Tuesday hero" style="position: relative; min-height: clamp(500px, 78vh, 860px); display: flex; align-items: center; justify-content: center; text-align: center; overflow: hidden; background: rgb(10, 10, 9);">
  <img data-dc-tpl="921" loading="lazy" decoding="async" src="/images/eca8597506381a36.jpg" alt="Mixed street tacos with salsa roja" referrerpolicy="no-referrer" style="position: absolute; inset: 0px; width: 100%; height: 100%; object-fit: cover;">
  <div data-dc-tpl="922" aria-hidden="true" style="position: absolute; inset: 0px; background: linear-gradient(rgba(18, 18, 16, 0.7), rgba(18, 18, 16, 0.45) 50%, rgba(18, 18, 16, 0.9));"></div>
  <div data-dc-tpl="923" style="position: relative; width: 100%; max-width: 900px; margin: 0px auto; padding: 120px clamp(18px, 4.6vw, 48px) clamp(40px, 6vh, 72px);">
    <div data-dc-tpl="924" style="display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: 999px; background: rgb(191, 30, 46); color: rgb(246, 239, 228); font-family: &quot;Barlow Condensed&quot;, sans-serif; font-weight: 700; font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase;">Germantown, MD · Plus Free Bingo at 8</div>
    <h1 data-dc-tpl="925" style="color: rgb(246, 239, 228); font-family: &quot;Archivo Black&quot;, sans-serif; font-size: clamp(2.75rem, 7vw, 7rem); line-height: 0.94; letter-spacing: -0.015em; margin: 14px auto 0px; text-transform: uppercase; text-wrap: balance; max-width: 13ch;">Taco <span data-dc-tpl="926" style="color: rgb(56, 176, 73);">Tuesday</span></h1>
    <div data-dc-tpl="927" style="display: inline-flex; align-items: center; gap: 12px; margin-top: 20px; padding: 16px 22px; border-radius: 16px; background: rgba(13, 13, 11, 0.78); border: 1px solid rgba(56, 176, 73, 0.5); backdrop-filter: blur(8px);"><span data-dc-tpl="928" style="font-family: &quot;Barlow Condensed&quot;, sans-serif; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(214, 188, 133);">The deal</span><span data-dc-tpl="929" style="font-size: 15px; color: rgb(214, 188, 133); font-weight: 700;">[PENDING: the Tuesday deal itself, client decision]</span></div>
    <p data-dc-tpl="930" style="font-size: clamp(15px, 1.6vw, 17px); line-height: 1.6; color: rgba(234, 226, 214, 0.88); max-width: 46ch; margin: 18px auto 0px; text-wrap: pretty;">Street tacos on the tortillas we pressed this morning, plus free bingo at 8.</p>
    <div data-dc-tpl="931" style="display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 22px;">
      <a data-dc-tpl="932" href="https://tables.toasttab.com/restaurants/d94fa749-fbd5-4a66-90b6-d7755b8c3af3/findTime" target="_blank" class="scp2" style="display: inline-flex; align-items: center; justify-content: center; background: rgb(56, 176, 73); color: rgb(12, 18, 13); font-weight: 800; font-size: 15px; padding: 16px 22px; border-radius: 12px; min-height: 52px; box-sizing: border-box; box-shadow: rgba(56, 176, 73, 0.35) 0px 0px 30px;">Reserve Tuesday</a>
      <a data-dc-tpl="933" href="#lineup" class="scp1" style="display: inline-flex; align-items: center; justify-content: center; border: 1.5px solid rgba(185, 156, 102, 0.75); color: rgb(234, 226, 214); font-weight: 700; font-size: 15px; padding: 16px 22px; border-radius: 12px; min-height: 52px; box-sizing: border-box; background: rgba(18, 18, 16, 0.4);">The Lineup</a>
    </div>
  </div></section><section data-dc-tpl="934" id="lineup" data-screen-label="Tuesday lineup" style="background: rgb(18, 18, 16); padding: clamp(40px, 7vw, 88px) 0px; scroll-margin-top: 70px;">
  <div data-dc-tpl="935" style="max-width: 1180px; margin: 0px auto; padding: 0px clamp(18px, 4.6vw, 48px);">
    <div data-dc-tpl="936" style="display: flex; align-items: center; gap: 10px; font-family: &quot;Barlow Condensed&quot;, sans-serif; font-weight: 600; font-size: 14px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(214, 188, 133);"><span data-dc-tpl="937" style="width: 26px; height: 1px; background: rgba(185, 156, 102, 0.6);"></span>Seven nights</div>
    <h2 data-dc-tpl="938" style="color: rgb(246, 239, 228); font-family: &quot;Archivo Black&quot;, sans-serif; font-size: clamp(26px, 4.6vw, 44px); line-height: 1.02; margin: 8px 0px 22px; text-transform: uppercase; text-wrap: balance;">Every night of the week</h2>
    <div data-dc-tpl="939" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 160px), 1fr)); gap: 12px;">
      
        <div data-dc-tpl="941" class="scpe" style="display: flex; flex-direction: column; background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 16px; overflow: hidden;"><div data-dc-tpl="942" style="aspect-ratio: 1 / 1; background: url(&quot;https://senortequilas.com/wp-content/uploads/2022/03/DSC07183-HDR.jpg&quot;) center center / cover no-repeat rgb(35, 33, 28);"></div><div data-dc-tpl="943" style="padding: 12px 14px 14px;"><div data-dc-tpl="944" style="font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 15px; text-transform: uppercase; color: rgb(246, 239, 228); line-height: 1.05;"><span class="sc-interp">Tacos al Pastor</span></div><div data-dc-tpl="945" style="font-size: 12px; line-height: 1.45; color: rgba(234, 226, 214, 0.78); margin-top: 4px;"><span class="sc-interp">Sliced fresh from el trompo, salsa verde and limes</span></div><div data-dc-tpl="946" style="margin-top: 8px; font-size: 12px; color: rgb(214, 188, 133);"></div></div></div>
      
        <div data-dc-tpl="941" class="scpe" style="display: flex; flex-direction: column; background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 16px; overflow: hidden;"><div data-dc-tpl="942" style="aspect-ratio: 1 / 1; background: url(&quot;https://senortequilas.com/wp-content/uploads/2024/11/DSC00415-scaled.jpg&quot;) center center / cover no-repeat rgb(35, 33, 28);"></div><div data-dc-tpl="943" style="padding: 12px 14px 14px;"><div data-dc-tpl="944" style="font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 15px; text-transform: uppercase; color: rgb(246, 239, 228); line-height: 1.05;"><span class="sc-interp">Tacos Perrones</span></div><div data-dc-tpl="945" style="font-size: 12px; line-height: 1.45; color: rgba(234, 226, 214, 0.78); margin-top: 4px;"><span class="sc-interp">Steak, guacamole, nopales, queso fresco, chicharrón</span></div><div data-dc-tpl="946" style="margin-top: 8px; font-size: 12px; color: rgb(214, 188, 133);"></div></div></div>
      
        <div data-dc-tpl="941" class="scpe" style="display: flex; flex-direction: column; background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 16px; overflow: hidden;"><div data-dc-tpl="942" style="aspect-ratio: 1 / 1; background: url(&quot;https://senortequilas.com/wp-content/uploads/2022/04/Birria.jpg&quot;) center center / cover no-repeat rgb(35, 33, 28);"></div><div data-dc-tpl="943" style="padding: 12px 14px 14px;"><div data-dc-tpl="944" style="font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 15px; text-transform: uppercase; color: rgb(246, 239, 228); line-height: 1.05;"><span class="sc-interp">Cinco Mamalones</span></div><div data-dc-tpl="945" style="font-size: 12px; line-height: 1.45; color: rgba(234, 226, 214, 0.78); margin-top: 4px;"><span class="sc-interp">Steak, chicken, chorizo, carnitas and al pastor, one of each</span></div><div data-dc-tpl="946" style="margin-top: 8px; font-size: 12px; color: rgb(214, 188, 133);"></div></div></div>
      
    </div>
  </div></section><section data-dc-tpl="947" data-screen-label="Tuesday rules + image" style="background: linear-gradient(rgba(70, 8, 14, 0.72), rgba(40, 4, 8, 0.88)), url(/images/ecf6382a259b5884.png) center center / cover no-repeat; border-top: 1px solid rgba(191, 30, 46, 0.3); padding: clamp(44px, 7vw, 88px) 0px;">
  <div data-dc-tpl="948" style="max-width: 1180px; margin: 0px auto; padding: 0px clamp(18px, 4.6vw, 48px); display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: clamp(24px, 4vw, 56px); align-items: center;">
    <div data-dc-tpl="949" style="position: relative; aspect-ratio: 1 / 1; border-radius: 50%; overflow: hidden; border: 2px solid rgba(185, 156, 102, 0.45); background: rgb(28, 27, 24); max-width: 460px; margin: 0px auto; width: 100%;"><img data-dc-tpl="950" loading="lazy" decoding="async" src="/images/5ac1271d5937960b.jpg" alt="A molcajete of flank steak, chicken and chorizo under salsa verde" referrerpolicy="no-referrer" style="position: absolute; inset: 0px; width: 100%; height: 100%; object-fit: cover;"></div>
    <div data-dc-tpl="951">
      <div data-dc-tpl="952" style="display: flex; align-items: center; gap: 10px; font-family: &quot;Barlow Condensed&quot;, sans-serif; font-weight: 600; font-size: 14px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(214, 188, 133);"><span data-dc-tpl="953" style="width: 26px; height: 1px; background: rgba(214, 188, 133, 0.7);"></span>The rules</div>
      <h2 data-dc-tpl="954" style="color: rgb(246, 239, 228); font-family: &quot;Archivo Black&quot;, sans-serif; font-size: clamp(28px, 5.5vw, 46px); line-height: 1.02; margin: 8px 0px 0px; text-transform: uppercase; text-wrap: balance;">Why our tacos</h2>
      <div data-dc-tpl="955" style="display: grid; gap: 10px; margin-top: 18px; font-size: 15px; line-height: 1.6; color: rgba(234, 226, 214, 0.85);">
        <div data-dc-tpl="957" style="display: flex; gap: 12px;"><span data-dc-tpl="958" style="flex: 0 0 auto; color: rgb(56, 176, 73); font-weight: 800;">✓</span><span data-dc-tpl="959"><span class="sc-interp">Dine-in: dining room, bar and patio</span></span></div><div data-dc-tpl="957" style="display: flex; gap: 12px;"><span data-dc-tpl="958" style="flex: 0 0 auto; color: rgb(56, 176, 73); font-weight: 800;">✓</span><span data-dc-tpl="959"><span class="sc-interp">Free bingo, 8 to 10, with prizes</span></span></div><div data-dc-tpl="957" style="display: flex; gap: 12px;"><span data-dc-tpl="958" style="flex: 0 0 auto; color: rgb(56, 176, 73); font-weight: 800;">✓</span><span data-dc-tpl="959"><span class="sc-interp">Weekly specials in the dining room and bar</span></span></div><div data-dc-tpl="957" style="display: flex; gap: 12px;"><span data-dc-tpl="958" style="flex: 0 0 auto; color: rgb(56, 176, 73); font-weight: 800;">✓</span><span data-dc-tpl="959"><span class="sc-interp">Tuesdays after 6 run a wait. Reservations recommended</span></span></div>
      </div>
      <a data-dc-tpl="960" href="https://tables.toasttab.com/restaurants/d94fa749-fbd5-4a66-90b6-d7755b8c3af3/findTime" target="_blank" class="scp2" style="display: inline-flex; align-items: center; justify-content: center; background: rgb(56, 176, 73); color: rgb(12, 18, 13); font-weight: 800; font-size: 15px; padding: 15px 22px; border-radius: 12px; min-height: 52px; box-sizing: border-box; margin-top: 22px; box-shadow: rgba(56, 176, 73, 0.32) 0px 0px 30px;">Reserve for Tuesday</a>
    </div>
  </div></section><Footer2 /></div></div>
</Base>
