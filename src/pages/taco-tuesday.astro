---
import Base from '../layouts/Base.astro';
import Header5 from '../components/Header5.astro';
import Footer2 from '../components/Footer2.astro';
---
<Base title="Tacos in Germantown, MD | Every Day Is Taco Tuesday | Señor Tequila's" description="Handmade corn and flour tortillas pressed every morning, al pastor off the trompo, and salsas made the same day. Plus free bingo Tuesdays, 8 to 10." canonical="https://senortequilas.com/taco-tuesday" ogImage="/images/eca8597506381a36.jpg" route="/taco-tuesday">
<!--
  /taco-tuesday, rebuilt. See DESIGN-DEBT.md entry 21.

  The artboard version sold bingo in the hero, promised a weekly calendar under a heading
  that delivered three taco dishes, and answered "Why Our Tacos" with four logistics bullets.
  This version competes on the tacos instead of on a discount the restaurant does not run.

  Visual language is unchanged: same tokens, type, section rhythm and card treatments as the
  rest of the site. Content and structure only.
-->
<div class="sc-host" data-sc-name="Taco Tuesday" style="color: rgb(234, 226, 214); font-family: Barlow, system-ui, -apple-system, sans-serif; background: rgb(18, 18, 16);">
  <Header5 />

  <section data-screen-label="Taco hero" style="background: rgb(18, 18, 16); border-bottom: 1px solid rgba(185, 156, 102, 0.2);">
    <div style="max-width: 1180px; margin: 0px auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); align-items: center; gap: clamp(24px, 4vw, 56px);">
      <div style="padding: clamp(36px, 6vw, 76px) clamp(18px, 4.5vw, 48px);">
        <div style="display: flex; align-items: center; gap: 10px; font-family: 'Barlow Condensed', sans-serif; font-weight: 600; font-size: 14px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(214, 188, 133);">
          <span style="width: 26px; height: 1px; background: rgba(214, 188, 133, 0.7);"></span>Germantown, MD · Tortillas pressed this morning
        </div>
        <h1 style="color: rgb(246, 239, 228); font-family: 'Archivo Black', sans-serif; font-size: clamp(30px, 5.6vw, 56px); line-height: 1.02; margin: 10px 0px 0px; text-transform: uppercase; text-wrap: balance;">Every Day Is Taco Tuesday</h1>
        <p style="font-size: 16px; line-height: 1.7; color: rgba(234, 226, 214, 0.85); margin: 16px 0px 0px; max-width: 52ch; text-wrap: pretty;">Corn and flour tortillas pressed by hand every morning. Al pastor carved off the trompo. Salsas made the same day, in our kitchen. You do not need a Tuesday for that.</p>
        <div style="display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px;">
          <a href="https://order.toasttab.com/online/senortequilastogo" target="_blank" rel="noopener" style="display: inline-flex; align-items: center; justify-content: center; background: rgb(56, 176, 73); color: rgb(12, 18, 13); font-weight: 800; font-size: 15px; padding: 16px 24px; border-radius: 12px; min-height: 52px; box-sizing: border-box; box-shadow: rgba(56, 176, 73, 0.35) 0px 0px 30px;">Order Online</a>
          <a href="https://tables.toasttab.com/restaurants/d94fa749-fbd5-4a66-90b6-d7755b8c3af3/findTime" target="_blank" rel="noopener" style="display: inline-flex; align-items: center; justify-content: center; border: 1.5px solid rgba(185, 156, 102, 0.75); color: rgb(234, 226, 214); font-weight: 700; font-size: 15px; padding: 16px 24px; border-radius: 12px; min-height: 52px; box-sizing: border-box; background: rgba(18, 18, 16, 0.4);">Reserve a Table</a>
        </div>
        <div style="display: flex; align-items: center; gap: 8px; margin-top: 16px; font-size: 13px; color: rgba(234, 226, 214, 0.85);">
          <span style="color: rgb(185, 156, 102); letter-spacing: 2px;">★★★★★</span>
          <span>4.6 · over 5,600 Google reviews</span>
        </div>
      </div>
      <div style="position: relative; min-height: clamp(300px, 46vh, 720px); overflow: hidden; background: url(/images/eca8597506381a36.jpg) center center / cover no-repeat rgb(28, 27, 24);"></div>
    </div>
  </section>

  <section data-screen-label="Why you don't need a Tuesday" style="background: rgb(20, 18, 16); border-top: 1px solid rgba(185, 156, 102, 0.2); padding: clamp(40px, 6.4vw, 84px) 0px;">
    <div style="max-width: 1180px; margin: 0px auto; padding: 0px clamp(18px, 4.5vw, 48px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: clamp(24px, 4vw, 56px); align-items: center;">
      <div>
        <div style="display: flex; align-items: center; gap: 10px; font-family: 'Barlow Condensed', sans-serif; font-weight: 600; font-size: 14px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(214, 188, 133);">
          <span style="width: 26px; height: 1px; background: rgba(214, 188, 133, 0.7);"></span>Pressed at six in the morning
        </div>
        <h2 style="color: rgb(246, 239, 228); font-family: 'Archivo Black', sans-serif; font-size: clamp(26px, 4.6vw, 42px); line-height: 1.04; margin: 10px 0px 0px; text-transform: uppercase; text-wrap: balance;">Why You Don't Need a Tuesday</h2>
        <div style="display: grid; gap: 12px; margin-top: 22px;">
          <div style="background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 16px; padding: 18px 20px;">
            <div style="font-family: 'Archivo Black', sans-serif; font-size: 14px; text-transform: uppercase; color: rgb(246, 239, 228); line-height: 1.2;">The tortillas</div>
            <p style="font-size: 14px; line-height: 1.6; color: rgba(234, 226, 214, 0.8); margin: 7px 0px 0px;">Corn and flour, pressed by hand in our kitchen every morning. Not delivered, not reheated.</p>
          </div>
          <div style="background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 16px; padding: 18px 20px;">
            <div style="font-family: 'Archivo Black', sans-serif; font-size: 14px; text-transform: uppercase; color: rgb(246, 239, 228); line-height: 1.2;">The meats</div>
            <p style="font-size: 14px; line-height: 1.6; color: rgba(234, 226, 214, 0.8); margin: 7px 0px 0px;">Al pastor carved off the trompo. Birria braised six hours before it reaches a griddle. Carnitas, chorizo, asada, all cooked here.</p>
          </div>
          <div style="background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 16px; padding: 18px 20px;">
            <div style="font-family: 'Archivo Black', sans-serif; font-size: 14px; text-transform: uppercase; color: rgb(246, 239, 228); line-height: 1.2;">The salsas</div>
            <p style="font-size: 14px; line-height: 1.6; color: rgba(234, 226, 214, 0.8); margin: 7px 0px 0px;">Made the same day, from scratch, the way they are made at home.</p>
          </div>
          <div style="background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 16px; padding: 18px 20px;">
            <div style="font-family: 'Archivo Black', sans-serif; font-size: 14px; text-transform: uppercase; color: rgb(246, 239, 228); line-height: 1.2;">The family</div>
            <p style="font-size: 14px; line-height: 1.6; color: rgba(234, 226, 214, 0.8); margin: 7px 0px 0px;">A Mexican family and a Mexican kitchen, in Germantown since 2015. <a href="/our-story" style="color: rgb(214, 188, 133); font-weight: 700;">Our story</a>.</p>
          </div>
        </div>
      </div>
      <div style="position: relative; min-height: clamp(300px, 44vh, 640px); border-radius: 18px; overflow: hidden; border: 1px solid rgba(185, 156, 102, 0.3); background: url(/images/9120a505c92f1281.jpg) center center / cover no-repeat rgb(28, 27, 24);"></div>
    </div>
  </section>

  <section data-screen-label="The tacos" style="background: rgb(18, 18, 16); border-top: 1px solid rgba(185, 156, 102, 0.2); padding: clamp(40px, 6.4vw, 84px) 0px;">
    <div style="max-width: 1180px; margin: 0px auto; padding: 0px clamp(18px, 4.5vw, 48px);">
      <div style="display: flex; align-items: center; gap: 10px; font-family: 'Barlow Condensed', sans-serif; font-weight: 600; font-size: 14px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(214, 188, 133);">
        <span style="width: 26px; height: 1px; background: rgba(214, 188, 133, 0.7);"></span>Off the trompo, off the griddle
      </div>
      <h2 style="color: rgb(246, 239, 228); font-family: 'Archivo Black', sans-serif; font-size: clamp(26px, 4.6vw, 42px); line-height: 1.04; margin: 10px 0px 22px; text-transform: uppercase;">The Tacos</h2>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 14px;">
        <div style="display: flex; flex-direction: column; background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 16px; overflow: hidden;">
          <div style="aspect-ratio: 1 / 1; background: url(/images/dishes/tacos-al-pastor.jpg) center center / cover no-repeat rgb(35, 33, 28); border-bottom: 1px solid rgb(42, 40, 32);"></div>
          <div style="padding: 16px 18px 18px;">
            <div style="font-family: 'Archivo Black', sans-serif; font-size: 15px; text-transform: uppercase; color: rgb(246, 239, 228);">Tacos al Pastor</div>
            <p style="font-size: 13px; line-height: 1.55; color: rgba(234, 226, 214, 0.8); margin: 7px 0px 0px;">Sliced fresh from el trompo, salsa verde and limes</p>
          </div>
        </div>
        <div style="display: flex; flex-direction: column; background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 16px; overflow: hidden;">
          <div style="aspect-ratio: 1 / 1; background: url(/images/dishes/tacos-perrones.jpg) center center / cover no-repeat rgb(35, 33, 28); border-bottom: 1px solid rgb(42, 40, 32);"></div>
          <div style="padding: 16px 18px 18px;">
            <div style="font-family: 'Archivo Black', sans-serif; font-size: 15px; text-transform: uppercase; color: rgb(246, 239, 228);">Tacos Perrones</div>
            <p style="font-size: 13px; line-height: 1.55; color: rgba(234, 226, 214, 0.8); margin: 7px 0px 0px;">Steak, guacamole, nopales, queso fresco, chicharrón</p>
          </div>
        </div>
        <div style="display: flex; flex-direction: column; background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 16px; overflow: hidden;">
          <div style="aspect-ratio: 1 / 1; background: url(/images/dishes/tacos-cinco-mamalones.jpg) center center / cover no-repeat rgb(35, 33, 28); border-bottom: 1px solid rgb(42, 40, 32);"></div>
          <div style="padding: 16px 18px 18px;">
            <div style="font-family: 'Archivo Black', sans-serif; font-size: 15px; text-transform: uppercase; color: rgb(246, 239, 228);">Cinco Mamalones</div>
            <p style="font-size: 13px; line-height: 1.55; color: rgba(234, 226, 214, 0.8); margin: 7px 0px 0px;">Steak, chicken, chorizo, carnitas and al pastor, one of each</p>
          </div>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 14px; margin-top: 14px;">
        <a href="/birria-tacos" style="display: flex; flex-direction: column; background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 16px; overflow: hidden; color: rgb(234, 226, 214);">
          <div style="aspect-ratio: 1 / 1; background: url(/images/4e4e97cc03520928.jpg) center center / cover no-repeat rgb(35, 33, 28); border-bottom: 1px solid rgb(42, 40, 32);"></div>
          <div style="padding: 16px 18px 18px;">
            <div style="font-family: 'Barlow Condensed', sans-serif; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: rgb(214, 188, 133);">Six-hour braise</div>
            <div style="font-family: 'Archivo Black', sans-serif; font-size: 15px; text-transform: uppercase; color: rgb(246, 239, 228); margin-top: 4px;">Birria Tacos →</div>
          </div>
        </a>
        <a href="/quesabirria-tacos" style="display: flex; flex-direction: column; background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 16px; overflow: hidden; color: rgb(234, 226, 214);">
          <div style="aspect-ratio: 1 / 1; background: url(/images/dishes/quesabirrias-card.jpg) center center / cover no-repeat rgb(35, 33, 28); border-bottom: 1px solid rgb(42, 40, 32);"></div>
          <div style="padding: 16px 18px 18px;">
            <div style="font-family: 'Barlow Condensed', sans-serif; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: rgb(214, 188, 133);">Dipped and griddled</div>
            <div style="font-family: 'Archivo Black', sans-serif; font-size: 15px; text-transform: uppercase; color: rgb(246, 239, 228); margin-top: 4px;">Quesabirria Tacos →</div>
          </div>
        </a>
        <a href="/street-tacos" style="display: flex; flex-direction: column; background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 16px; overflow: hidden; color: rgb(234, 226, 214);">
          <div style="aspect-ratio: 1 / 1; background: url(/images/dishes/tacos-de-arrachera-card.jpg) center center / cover no-repeat rgb(35, 33, 28); border-bottom: 1px solid rgb(42, 40, 32);"></div>
          <div style="padding: 16px 18px 18px;">
            <div style="font-family: 'Barlow Condensed', sans-serif; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: rgb(214, 188, 133);">Handmade tortillas</div>
            <div style="font-family: 'Archivo Black', sans-serif; font-size: 15px; text-transform: uppercase; color: rgb(246, 239, 228); margin-top: 4px;">Street Tacos →</div>
          </div>
        </a>
      </div>

      <div style="margin-top: 18px;">
        <a href="/menu" style="display: inline-flex; align-items: center; justify-content: center; border: 1.5px solid rgba(185, 156, 102, 0.6); color: rgb(234, 226, 214); font-weight: 700; font-size: 14px; padding: 13px 20px; border-radius: 12px; min-height: 48px; box-sizing: border-box;">See the full menu</a>
      </div>
    </div>
  </section>

  <section data-dc-tpl="76" id="tonight" data-screen-label="Tonight carousel" style="padding: clamp(40px, 7vw, 80px) 0px clamp(24px, 4vw, 40px); scroll-margin-top: 70px; background: linear-gradient(rgba(14, 14, 13, 0.72), rgba(10, 10, 9, 0.88)), url(/images/86475be0134bfc90.png) center center / cover no-repeat; border-top: 1px solid rgba(56, 176, 73, 0.18); border-bottom: 1px solid rgba(56, 176, 73, 0.18);">
  <div data-dc-tpl="77" style="max-width: 1180px; margin: 0px auto; padding: 0px clamp(18px, 4.5vw, 48px); display: flex; align-items: flex-end; justify-content: space-between; gap: 16px;">
    <div data-dc-tpl="78">
      <div data-dc-tpl="79" style="display: flex; align-items: center; gap: 10px; font-family: &quot;Barlow Condensed&quot;, sans-serif; font-weight: 600; font-size: 14px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(214, 188, 133);"><span data-dc-tpl="80" style="width: 26px; height: 1px; background: rgba(185, 156, 102, 0.6);"></span><span data-dc-tpl="81"><span class="sc-interp">Thursday · every week</span></span></div>
      <h2 data-dc-tpl="82" style="color: rgb(246, 239, 228); font-family: &quot;Archivo Black&quot;, sans-serif; font-size: clamp(28px, 5.5vw, 46px); line-height: 1.02; margin: 8px 0px 0px; text-transform: uppercase;">There’s a Reason to Come Every Night</h2>
    </div>
    <div data-dc-tpl="83" style="flex: 0 0 auto; display: flex; align-items: center; gap: 10px;">
      <button data-dc-tpl="84" aria-label="Previous events" class="scp5" style="width: 44px; height: 44px; flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; border-radius: 999px; border: 1px solid rgba(185, 156, 102, 0.5); background: rgba(28, 27, 24, 0.85); color: rgb(234, 226, 214); cursor: pointer;"><svg data-dc-tpl="85" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path data-dc-tpl="86" d="M15 5l-7 7 7 7"></path></svg></button>
      <button data-dc-tpl="87" aria-label="Next events" class="scp5" style="width: 44px; height: 44px; flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; border-radius: 999px; border: 1px solid rgba(185, 156, 102, 0.5); background: rgba(28, 27, 24, 0.85); color: rgb(234, 226, 214); cursor: pointer;"><svg data-dc-tpl="88" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path data-dc-tpl="89" d="M9 5l7 7-7 7"></path></svg></button>
    </div>
  </div>
  <div data-dc-tpl="91" data-rail="" style="display: flex; gap: 12px; overflow-x: auto; scrollbar-width: none; scroll-behavior: smooth; scroll-snap-type: x; scroll-padding-left: clamp(18px, 4.5vw, 48px); padding: 20px clamp(18px, 4.5vw, 48px) 10px; max-width: 1180px; margin: 0px auto; box-sizing: border-box;">
    
      <div data-dc-tpl="93" class="scp7" style="flex: 0 0 auto; width: min(78vw, 250px); scroll-snap-align: start; display: flex; flex-direction: column; background: rgb(28, 27, 24); border: 1px solid rgb(56, 176, 73); border-radius: 16px; overflow: hidden; color: rgb(234, 226, 214); transition: transform 0.25s, border-color 0.25s;">
        <div data-dc-tpl="94" style="position: relative; aspect-ratio: 4 / 5; background: url(/images/5ac1271d5937960b.jpg) center center / cover no-repeat rgb(28, 27, 24); box-shadow: rgba(10, 10, 9, 0.9) 0px -80px 70px -20px inset; display: flex; align-items: flex-end; padding: 14px;">
          <span data-dc-tpl="96" style="position: absolute; top: 12px; left: 12px; background: rgb(191, 30, 46); color: rgb(246, 239, 228); font-size: 10px; font-weight: 800; letter-spacing: 0.09em; text-transform: uppercase; padding: 5px 9px; border-radius: 999px;">Tonight</span>
        </div>
        <div data-dc-tpl="98" style="padding: 14px 16px 16px;">
          <div data-dc-tpl="99" style="font-family: &quot;Barlow Condensed&quot;, sans-serif; font-weight: 600; font-size: 13px; color: rgb(185, 156, 102); letter-spacing: 0.12em; text-transform: uppercase;"><span class="sc-interp">Thursdays</span> · <span class="sc-interp">7:30 to midnight</span></div>
          <div data-dc-tpl="100" style="font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 17px; text-transform: uppercase; line-height: 1.1; margin-top: 4px;"><span class="sc-interp">Karaoke</span></div>
          <div data-dc-tpl="101" style="font-size: 13px; line-height: 1.5; color: rgba(234, 226, 214, 0.85); margin-top: 6px;"><span class="sc-interp">Karaoke in the bar area, hosted by DJ Willy. NFL on.</span></div>
        </div>
      </div>
    
      <div data-dc-tpl="93" class="scp7" style="flex: 0 0 auto; width: min(78vw, 250px); scroll-snap-align: start; display: flex; flex-direction: column; background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 16px; overflow: hidden; color: rgb(234, 226, 214); transition: transform 0.25s, border-color 0.25s;">
        <div data-dc-tpl="94" style="position: relative; aspect-ratio: 4 / 5; background: url(/images/24e322da4fd1060e.jpg) center center / cover no-repeat rgb(28, 27, 24); box-shadow: rgba(10, 10, 9, 0.9) 0px -80px 70px -20px inset; display: flex; align-items: flex-end; padding: 14px;">
        </div>
        <div data-dc-tpl="98" style="padding: 14px 16px 16px;">
          <div data-dc-tpl="99" style="font-family: &quot;Barlow Condensed&quot;, sans-serif; font-weight: 600; font-size: 13px; color: rgb(185, 156, 102); letter-spacing: 0.12em; text-transform: uppercase;"><span class="sc-interp">Fridays</span> · <span class="sc-interp">9 PM to 1 AM</span></div>
          <div data-dc-tpl="100" style="font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 17px; text-transform: uppercase; line-height: 1.1; margin-top: 4px;"><span class="sc-interp">Live DJ</span></div>
          <div data-dc-tpl="101" style="font-size: 13px; line-height: 1.5; color: rgba(234, 226, 214, 0.85); margin-top: 6px;"><span class="sc-interp">Live DJ in the bar area, 9 PM to 1 AM. 21 and over in the bar area after 9.</span></div>
        </div>
      </div>
    
      <div data-dc-tpl="93" class="scp7" style="flex: 0 0 auto; width: min(78vw, 250px); scroll-snap-align: start; display: flex; flex-direction: column; background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 16px; overflow: hidden; color: rgb(234, 226, 214); transition: transform 0.25s, border-color 0.25s;">
        <div data-dc-tpl="94" style="position: relative; aspect-ratio: 4 / 5; background: url(/images/d8219db4b8a2f6cf.jpg) center center / cover no-repeat rgb(28, 27, 24); box-shadow: rgba(10, 10, 9, 0.9) 0px -80px 70px -20px inset; display: flex; align-items: flex-end; padding: 14px;">
        </div>
        <div data-dc-tpl="98" style="padding: 14px 16px 16px;">
          <div data-dc-tpl="99" style="font-family: &quot;Barlow Condensed&quot;, sans-serif; font-weight: 600; font-size: 13px; color: rgb(185, 156, 102); letter-spacing: 0.12em; text-transform: uppercase;"><span class="sc-interp">Saturdays</span> · <span class="sc-interp">9 PM to 1 AM</span></div>
          <div data-dc-tpl="100" style="font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 17px; text-transform: uppercase; line-height: 1.1; margin-top: 4px;"><span class="sc-interp">Live DJ</span></div>
          <div data-dc-tpl="101" style="font-size: 13px; line-height: 1.5; color: rgba(234, 226, 214, 0.85); margin-top: 6px;"><span class="sc-interp">Live DJ in the bar area, 9 PM to 1 AM. College football on. 21 and over in the bar area after 9.</span></div>
        </div>
      </div>
    
      <div data-dc-tpl="93" class="scp7" style="flex: 0 0 auto; width: min(78vw, 250px); scroll-snap-align: start; display: flex; flex-direction: column; background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 16px; overflow: hidden; color: rgb(234, 226, 214); transition: transform 0.25s, border-color 0.25s;">
        <div data-dc-tpl="94" style="position: relative; aspect-ratio: 4 / 5; background: url(/images/0158f8e0dc2e230a.jpg) center center / cover no-repeat rgb(28, 27, 24); box-shadow: rgba(10, 10, 9, 0.9) 0px -80px 70px -20px inset; display: flex; align-items: flex-end; padding: 14px;">
        </div>
        <div data-dc-tpl="98" style="padding: 14px 16px 16px;">
          <div data-dc-tpl="99" style="font-family: &quot;Barlow Condensed&quot;, sans-serif; font-weight: 600; font-size: 13px; color: rgb(185, 156, 102); letter-spacing: 0.12em; text-transform: uppercase;"><span class="sc-interp">Sundays</span> · <span class="sc-interp">6:30 to 9:30</span></div>
          <div data-dc-tpl="100" style="font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 17px; text-transform: uppercase; line-height: 1.1; margin-top: 4px;"><span class="sc-interp">Live Mariachi</span></div>
