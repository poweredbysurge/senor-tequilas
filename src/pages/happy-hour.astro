    </div>
  </div></section><section id="sunday" data-screen-label="Sunday happy hour" style="background: rgb(20, 18, 16); border-top: 1px solid rgba(185, 156, 102, 0.2); padding: clamp(36px, 6vw, 72px) 0px; scroll-margin-top: 70px;">
