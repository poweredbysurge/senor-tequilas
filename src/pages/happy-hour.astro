<div class="sc-host" data-sc-name="Concept 1 Pages" data-dc-tpl="144"><div data-dc-tpl="6" data-c1p-root="" data-uid="c1p0pf5b3" style="color: rgb(234, 226, 214); font-family: Barlow, system-ui, -apple-system, sans-serif; background: rgb(18, 18, 16); min-height: 100%;"><Header5 /><section data-dc-tpl="739" data-screen-label="Happy hour hero" style="position: relative; background: linear-gradient(rgba(6, 52, 20, 0.82), rgba(10, 10, 9, 0.95)), url(/images/9cf29efa1cbf0c3e.png) center center / cover no-repeat; overflow: hidden; border-bottom: 1px solid rgba(185, 156, 102, 0.2);">
