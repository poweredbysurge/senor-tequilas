        <div data-dc-tpl="757" style="position: relative; aspect-ratio: 4 / 5; border-radius: 16px; overflow: hidden; border: 1px solid rgba(185, 156, 102, 0.3); background: rgb(28, 27, 24);"><img data-dc-tpl="758" loading="lazy" decoding="async" src="/images/8cd7641ffaf36916.jpg" alt="The bar area" referrerpolicy="no-referrer" style="position: absolute; inset: 0px; width: 100%; height: 100%; object-fit: cover;"></div>
