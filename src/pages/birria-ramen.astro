---
import Base from '../layouts/Base.astro';
import Header5 from '../components/Header5.astro';
import Footer2 from '../components/Footer2.astro';
import business from '../data/business.json';
import { roundedTotal } from '../lib/reviews.js';
import SeasonalMotion from '../components/seasonal/SeasonalMotion.astro';
import MobileCenter from '../components/seasonal/MobileCenter.astro';
import SignFrame from '../components/seasonal/SignFrame.astro';
import MenuBoard from '../components/seasonal/MenuBoard.astro';
import CountStat from '../components/seasonal/CountStat.astro';
import RatingLine from '../components/seasonal/RatingLine.astro';
import ReviewQuote from '../components/seasonal/ReviewQuote.astro';
import Faq from '../components/seasonal/Faq.astro';
import { EYEBROW, RULE, H2, P, LINK, WRAP, BTN_PRIMARY, BTN_GHOST, FRAME, IMG, assertFacts, faqLd, RESTAURANT_ID } from '../lib/authored.js';

/*
  /birria-ramen, concept 3c "Painted Sign" (design/concepts/2026-10-25-selected). In PREVIEW:
  listed in src/data/preview-pages.ts, so it is noindex, out of the sitemap, carries the preview
  bar, and nothing on the site links to it yet (the dish strip and the homepage dish card wait for
  the publish step). Copy is verbatim from design/copy/holiday-pages-copy-2026-10-24.md, page D;
  the mock's condensed text is never used.

  PRICES ARE ALLOWED ON THIS PAGE: $21 and the $7 happy hour comparison are the copy's own.
*/
const PAGE = '/birria-ramen';
const PAGE_URL = business.siteUrl + PAGE;
// The Local section states the address and the full weekly hours in a sentence. If business.json
// moves either, the build stops here rather than letting this page go quietly wrong.
assertFacts(PAGE, {
  street: '20021 Century Blvd',
  phone: '301-569-4574',
  hours: [
    { days: ['Monday', 'Tuesday', 'Wednesday'], opens: '15:00', closes: '22:00' },
    { days: ['Thursday'], opens: '15:00', closes: '00:00' },
    { days: ['Friday'], opens: '15:00', closes: '01:00' },
    { days: ['Saturday'], opens: '11:00', closes: '01:00' },
    { days: ['Sunday'], opens: '11:00', closes: '22:00' },
  ],
});

const HERO = { src: '/images/dishes/birria-ramen.jpg', w: 1265, h: 929, alt: 'A bowl of birria ramen: noodles in red consommé with shredded birria beef, corn, sliced radish and cilantro, limes on the side' };
const BIRRIA = { src: '/images/dishes/quesabirrias-hero.jpg', w: 1588, h: 751, alt: 'Quesabirria tacos topped with radish and cilantro, with cups of consommé and salsa and wedges of lime' };
const BROTHERS = { src: '/images/site/brothers.jpg', w: 1600, h: 1600, alt: 'Alex and Roberto Rivas, the brothers who own Señor Tequila\'s, side by side' };
const REVIEW = { name: 'Matt P.', text: "Easiest decision, we're coming back! The Birria Ramen is amazing. But every dish that came by looks phenomenal. Wish we had room for dessert." };
// PENDING ROBERTO Q3: this first-person quote is awaiting his OK. If he declines, replace it with
// his original third-person wording.
const ROBERTO_QUOTE = 'He would drive by my house every two days with a fresh batch of birria and handmade tortillas and leave it on top of my trunk. After about fifteen recipes, this one was chosen, then perfected.';
const DELIVERY = [
  ['DoorDash', 'https://www.doordash.com/store/tequilas-germantown-1382099/87487565/'],
  ['Uber Eats', 'https://www.ubereats.com/store/senor-tequilas-20021-century-blvd/VmgKaUsFRFWHMUQfd1a8NA'],
  ['Grubhub', 'https://www.grubhub.com/restaurant/seor-tequilas-20021-century-blvd-germantown/2455303'],
];
const MAP_ADDRESS = `${business.streetAddress}, ${business.addressLocality}, ${business.addressRegion} ${business.postalCode}`;
const PHONE_MAP_SRC = `https://maps.google.com/maps?q=${encodeURIComponent(MAP_ADDRESS)}&z=15&output=embed`;
const MAP_EMBED = 'https://www.google.com/maps?q=' + encodeURIComponent(`${business.streetAddress}, ${business.addressLocality}, ${business.addressRegion} ${business.postalCode}`) + '&output=embed';
const BOWL = [
  { name: 'Birria beef', sub: 'Braised 8 hours, piled on' },
  { name: 'Ramen noodles', sub: 'Japanese, wheat, underneath' },
  { name: 'Consommé', sub: 'Ladled over everything' },
  { name: 'Corn, radish, onion', sub: 'On top' },
  { name: 'Cilantro', sub: 'On top' },
  { name: 'Limes', sub: 'On the side, to cut it' },
];
const DRINKS = [
  { name: 'Michelada', sub: 'Cold and carbonated' },
  { name: 'Mexican Coke', sub: 'Cold and carbonated' },
  { name: 'Negra Modelo', sub: 'Cold and carbonated' },
];

const FAQ = [
  { q: 'What is birria ramen?',
    a: "Birria ramen is a bowl of Japanese ramen noodles in birria consommé, topped with the braised birria meat, corn, radish, onion and cilantro, with lime on the side. At Señor Tequila's the birria is beef braised for eight hours with guajillo, chile de árbol, cloves and garlic. It has been on the menu since 2021." },
  { q: 'How much is the birria ramen, and how big is it?',
    a: '$21, and it is a full meal for one person. Most people do not finish the bowl. It is not on the happy hour menu. It is available at full price any time we are open.' },
  { q: 'Is birria ramen spicy?',
    a: 'Ours is mild as served. The guajillo and chile de árbol in the braise are there for depth, not heat. If you want it hotter, ask for salsa diabla and we will bring it to the table or pack it with your takeout.' },
  { q: 'Does the birria ramen have allergens?',
    a: 'The ramen noodles are wheat. Tell your server about any other allergy and the kitchen will walk you through the bowl.' },
  { q: 'Can I get birria ramen for takeout or delivery?',
    a: 'Yes. It travels well because the consommé is packed separately. Order pickup through Toast up to 15 minutes before close, or delivery through DoorDash, Uber Eats or Grubhub.' },
  { q: 'What is the difference between birria ramen and birria tacos?',
    a: 'Same eight-hour beef braise, same consommé. The tacos put the meat in a handmade tortilla with the consommé on the side for dipping. The ramen puts the meat and consommé over noodles so the broth is in every bite. Many guests order one of each for the table.' },
  { q: 'What should I drink with birria ramen?',
    a: 'Something cold and carbonated: a michelada, a Mexican Coke, or a Negra Modelo. The bowl is rich, and the bubbles reset your palate between bites.' },
];

// /menu outputs no Menu node, so the dish stands on its own, with a stable @id the menu can point
// at later instead of repeating it
const ROBERTO_ID = business.siteUrl + '/our-story#roberto-rivas';
const dishLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'MenuItem',
    '@id': PAGE_URL + '#menuitem',
    name: 'Birria Ramen',
    description: 'Beef braised eight hours in guajillo and chile de árbol, Japanese ramen noodles, birria consommé, corn, radish, onion, cilantro and lime. Mild as served.',
    image: business.siteUrl + HERO.src,
    url: PAGE_URL,
    offers: { '@type': 'Offer', price: '21', priceCurrency: 'USD', availability: 'https://schema.org/InStock' },
    menuAddOn: { '@type': 'MenuItem', name: 'Salsa diabla' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': ROBERTO_ID,
    name: 'Roberto Rivas',
    jobTitle: 'Co-owner',
    worksFor: { '@id': RESTAURANT_ID },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Quotation',
    text: ROBERTO_QUOTE,
    creator: { '@id': ROBERTO_ID },
    about: { '@id': PAGE_URL + '#menuitem' },
  },
];
---
<Base title="Birria Ramen in Germantown, Maryland | Señor Tequila's" description="Birria ramen, $21: beef braised eight hours in guajillo and chile de árbol, Japanese ramen noodles, consommé, corn, radish, lime. Mild as served. Dine in or take out." canonical={PAGE_URL} ogImage={HERO.src} route={PAGE}>
<div class="sc-host br" data-sc-name="Birria Ramen" style="color: rgb(234, 226, 214); font-family: Barlow, 'Barlow Fallback', system-ui, -apple-system, sans-serif; background: rgb(18, 18, 16);">
  <Header5 />

  <!-- 1. the sign-frame hero -->
  <section data-screen-label="Birria ramen hero" class="br-hero">
    <div class="br-wrap">
      <SignFrame tone="dark" class="br-sign" padding="clamp(26px, 4vw, 56px)">
        <div class="br-sign-top"><span>On the menu since 2021 · $21 · Dine in, takeout, delivery</span></div>
        <div class="br-hero-grid">
          <div class="br-hero-copy">
            <div class="br-kicker">The one that makes people take a photo first</div>
            <h1 class="br-h1"><span class="br-h1-big">Birria Ramen</span> <span class="br-h1-sub"><i></i>in Germantown, Maryland<i></i></span></h1>
            <p class="br-lead">Beef braised for eight hours in guajillo and chile de árbol. Japanese ramen noodles. A consommé that took as long as the meat. One bowl, $21, and most people do not finish it.</p>
            <div class="br-ctas">
              <a href={business.orderUrl} target="_blank" rel="noopener" style={BTN_PRIMARY}>Order Takeout</a>
              <a href="/menu" style={BTN_GHOST}>See the Menu</a>
            </div>
          </div>
          <div class="br-hero-media">
            <div style={`${FRAME} aspect-ratio: 4 / 5;`}>
              <img src={HERO.src} srcset="/images/dishes/birria-ramen-800.webp 800w, /images/dishes/birria-ramen.jpg 1265w" sizes="(max-width: 767px) 92vw, min(42vw, 500px)" alt={HERO.alt} width={HERO.w} height={HERO.h} fetchpriority="high" decoding="async" style={`${IMG} object-position: center 45%;`} />
            </div>
            <div class="br-badge" data-badge-rock aria-hidden="true"><span class="br-badge-n">$21</span><span class="br-badge-l">A full meal</span></div>
          </div>
        </div>
      </SignFrame>
    </div>
  </section>

  <!-- 2. four fact tiles -->
  <section data-screen-label="Fact tiles" class="br-sec" style="padding-top: 0; border-top: 0;">
    <div class="br-wrap">
      <ul class="br-tiles">
        <li><div class="br-tile-n"><span data-countup="8" data-suffix=" hrs">8 hrs</span></div><div class="br-tile-t">In the braise</div><div class="br-tile-s">Guajillo, chile de árbol, cloves, garlic</div></li>
        <li><div class="br-tile-n">Mild</div><div class="br-tile-t">As served</div><div class="br-tile-s">Ask for salsa diabla</div></li>
        <li><div class="br-tile-n"><span data-countup="21" data-prefix="$">$21</span></div><div class="br-tile-t">A full meal</div><div class="br-tile-s">Most people do not finish the bowl</div></li>
        <li><div class="br-tile-n">2021</div><div class="br-tile-t">On the menu since</div><div class="br-tile-s">A top ten seller since</div></li>
      </ul>
    </div>
  </section>

  <!-- 3. what is in the bowl, as a menu board beside the photograph -->
  <section id="bowl" data-screen-label="The bowl" class="br-sec">
    <div class="br-wrap">
      <div class="br-split">
        <div style={`${FRAME} aspect-ratio: 1 / 1;`}>
          <img src={HERO.src} alt="The birria ramen bowl from above: noodles, shredded beef, corn, radish and cilantro in the red consommé" width={HERO.w} height={HERO.h} loading="lazy" decoding="async" style={`${IMG} object-position: 58% 40%; transform: scale(1.18); transform-origin: 58% 40%;`} />
        </div>
        <div>
          <div style={EYEBROW}><span style={RULE}></span>What is in it</div>
          <h2 style={H2}>What Is in the Bowl</h2>
          <div style="margin-top: 22px;"><MenuBoard items={BOWL} /></div>
          <p style={P}>Birria meat, piled on. Japanese ramen noodles underneath. Corn, radish, onion and cilantro on top. A ladle of birria consommé over all of it, and limes on the side to cut it when you are ready.</p>
          <p style={P}>It is a full meal for one person. Roberto's words: "You will not be hungry afterwards." Most people do not finish the bowl, and the ones who do ask for a pillow.</p>
          <p style={P}>It arrives mild. The chiles in the braise give it depth, not fire. Want it hotter? Ask for salsa diabla and we will bring it.</p>
          <p style={P}>The noodles are wheat. If that matters to you, it matters here.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. the braise: the spice word chain, then the photograph -->
  <section id="birria" data-screen-label="The birria" class="br-sec">
    <div class="br-wrap" style="text-align: center;">
      <div style={`${EYEBROW} justify-content: center;`}><span style={RULE}></span>Eight hours before it meets a noodle<span style={RULE}></span></div>
      <h2 style={`${H2} margin-left: auto; margin-right: auto;`}>How the Birria Is Made</h2>
      <p class="br-chain" aria-hidden="true"><span>Chile guajillo</span><i>✦</i><span>Chile de árbol</span><i>✦</i><span>Cloves</span><i>✦</i><span>Garlic</span><i>✦</i><span>Eight hours</span><i>✦</i><span class="is-muted">and the rest of a spice list the brothers are not going to type out for a website</span></p>
      <div class="br-braise-copy">
        <p style={P}>Tender beef, braised for eight hours with chile guajillo, chile de árbol, cloves, garlic, and the rest of a spice list the brothers are not going to type out for a website. The meat falls apart. The liquid it cooked in becomes the consommé, and that consommé is why the bowl works: it is the same red broth you dip a quesabirria taco into, except here the noodles soak it up for you.</p>
        <p style={P}>If you know our <a href="/birria-tacos" style={LINK}>birria tacos and quesabirria</a>, this is the same braise in a different shape. If you do not, start with the ramen. It is the one that makes people take a photo first.</p>
        <p style={P}>The Birria Pizza is moving to takeout only, so if that was your order, the <a href="/takeout-delivery" style={LINK}>takeout page</a> is where it lives now.</p>
      </div>
      <figure class="br-braise-fig">
        <div style={`${FRAME} aspect-ratio: 2 / 1;`}><img src={BIRRIA.src} alt={BIRRIA.alt} width={BIRRIA.w} height={BIRRIA.h} loading="lazy" decoding="async" style={IMG} /></div>
        <figcaption class="br-cap">The same braise and the same consommé, on the quesabirria tacos</figcaption>
      </figure>
    </div>
  </section>

  <!-- 5. drinks, as a menu board on the cream field -->
  <section id="drink" data-screen-label="The drink" class="br-cream">
    <div class="br-wrap">
      <SignFrame tone="cream" class="br-drinks">
        <div class="br-sign-top br-sign-top-ink"><span>Cold and carbonated</span></div>
        <div class="br-split" style="align-items: start;">
          <div>
            <h2 class="br-h2-ink">What to Drink With It</h2>
            <p class="br-p-ink">A cold michelada. A Mexican Coke. A Negra Modelo. Roberto's rule is anything cold and carbonated, because the bowl is rich and the bubbles reset your mouth between bites.</p>
            <p class="br-p-ink">The Birria Ramen is not on the <a href="/happy-hour" class="br-link-ink">happy hour</a> menu. It is a $21 dinner, not a $7 snack, and it is on the menu at full price every hour we are open. The happy hour drinks are, though, 3 to 6, Monday to Friday, in the bar area. <a href="/margaritas" class="br-link-ink">The margaritas</a></p>
          </div>
          <div>
            <MenuBoard items={DRINKS} tone="cream" numbered={false} />
            <div class="br-drink-ph">
              <img src="/images/site/drinks/michelada.webp" alt="A michelada in a glass mug with a chili-salt rim and a lime wedge, on ice" width="600" height="600" loading="lazy" decoding="async" />
              <img src="/images/site/drinks/mexican-coke.webp" alt="A cold Mexican Coca-Cola in the glass bottle" width="600" height="600" loading="lazy" decoding="async" />
              <img src="/images/site/drinks/negra-modelo.webp" alt="A cold bottle of Negra Modelo" width="600" height="600" loading="lazy" decoding="async" />
            </div>
          </div>
        </div>
      </SignFrame>
    </div>
  </section>

  <!-- 6. two sign panels: order it in, and where the bowl is -->
  <section id="takeout" data-screen-label="Takeout and local" class="br-sec">
    <div class="br-wrap">
      <div class="br-panels">
        <SignFrame tone="dark" class="br-panel">
          <div style={EYEBROW}><span style={RULE}></span>It travels</div>
          <h2 style={H2}>Order It In</h2>
          <p style={P}>Birria ramen is one of the few noodle dishes that travels well, because the consommé goes in its own container and the noodles do not sit in it until you say so. Roberto's words: "Travels great. Available in every way."</p>
          <p style={P}>Pickup through <a href="/takeout-delivery" style={LINK}>Toast</a> up to 15 minutes before close. Delivery through DoorDash, Uber Eats and Grubhub. And if you want the braise without the noodles, birria goes home by itself too, along with tamales, pozole and handmade tortillas.</p>
          <div class="br-ctas" style="margin-top: 22px;"><a href={business.orderUrl} target="_blank" rel="noopener" style={BTN_PRIMARY}>Order Takeout</a></div>
          <div class="br-delivery">{DELIVERY.map(([n, u]) => <a href={u} target="_blank" rel="noopener">{n}</a>)}</div>
        </SignFrame>
        <SignFrame tone="dark" class="br-panel" id="local">
          <div style={EYEBROW}><span style={RULE}></span>Where the bowl is</div>
          <h2 style={H2}>Birria Ramen in Germantown, Ten Minutes From Gaithersburg</h2>
          <p style={P}>We are at 20021 Century Blvd in Germantown, Maryland, next to Topgolf, with free parking at the door. Gaithersburg and Montgomery Village are about ten minutes away. Clarksburg, Boyds, Urbana and Frederick are the drive people tell us they make for this bowl.</p>
          <p style={P}>Open Monday to Friday from 3 PM, Saturday and Sunday from 11 AM. Sunday to Wednesday until 10 PM, Thursday until midnight, Friday and Saturday until 1 AM. <a href="/late-night" style={LINK}>Late night</a></p>
          <div class="br-map" data-map-facade data-map-src={MAP_EMBED}>
            <div class="br-map-art" aria-hidden="true"><span class="br-map-pin"></span><span class="br-map-ring"></span></div>
            <button type="button" data-map-title={`Map of ${business.name}, ${business.streetAddress}`}>Load the map<small>{business.streetAddress}, {business.addressLocality}, {business.addressRegion}</small></button>
            {/* phones: the real embed, the same one /mexican-restaurant-gaithersburg-md uses, shown straight
                away. Hidden at 768 and up, where the click-to-load stand-in stays, so it never loads there. */}
            <iframe class="br-map-phone" data-real-map src={PHONE_MAP_SRC} title={`Map to ${business.name}, ${MAP_ADDRESS}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
          </div>
        </SignFrame>
      </div>
    </div>
  </section>

  <!-- 7. the story, two columns with the typewriter quote -->
  <section id="story" data-screen-label="The story" class="br-sec">
    <div class="br-wrap">
      <div class="br-split" style="align-items: center;">
        <div style={`${FRAME} aspect-ratio: 1 / 1;`}><img src={BROTHERS.src} alt={BROTHERS.alt} width={BROTHERS.w} height={BROTHERS.h} loading="lazy" decoding="async" style={IMG} /></div>
        <div>
          <div style={EYEBROW}><span style={RULE}></span>2020</div>
          <h2 style={H2}>Fifteen Recipes and the Trunk of a Car</h2>
          <p style={P}>Alex Rivas loves caldos. Stews, broths, anything that takes a day. During the 2020 lockdown, with the dining rooms dark, he started cooking birria at home and testing it on the one critic he trusted.</p>
          <p style={P}>Every two days he drove to his brother Roberto's house with a fresh batch of birria and a stack of handmade tortillas, and left them on the trunk of Roberto's car, because that was the closest two people were allowed to get. Roberto ate. Alex adjusted. About fifteen recipes later, one of them was the one.</p>
          <p style={P}>It went on the menu in 2021. It has been a top ten seller since. Frequent guests mention it way too often, which we take as a compliment.</p>
          {/* PENDING ROBERTO Q3: first-person quote awaiting his OK (see ROBERTO_QUOTE above). */}
          <figure class="br-quote">
            <blockquote>"{ROBERTO_QUOTE}"</blockquote>
            <figcaption>Roberto Rivas, co-owner</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. proof, as a ruled band -->
  <section id="proof" data-screen-label="Proof" class="br-sec">
    <div class="br-wrap">
      <div class="br-proof">
        <div>
          <div style={EYEBROW}><span style={RULE}></span>{roundedTotal(business.reviews.total).replace('over', 'Over')} reviews</div>
          <h2 style={H2}>Do Not Take Our Word for It</h2>
          <p style={P}>Our Google reviews mention the birria more than any other dish except the quesabirria. {business.reviews.rating} stars across {roundedTotal(business.reviews.total)} of them. Family-owned by the Rivas brothers, Roberto and Alex, in Germantown since 2015.</p>
          <div style="margin-top: 20px;"><RatingLine /></div>
        </div>
        <ReviewQuote name={REVIEW.name} text={REVIEW.text} />
      </div>
    </div>
  </section>

  <!-- 9. FAQ, two columns of cards -->
  <section id="faq" data-screen-label="Birria ramen FAQ" class="br-sec">
    <div class="br-wrap">
      <h2 style={`${H2} margin: 0 auto; text-align: center;`}>Birria Ramen, Answered</h2>
      <div style="margin-top: 26px;"><Faq items={FAQ} columns={2} /></div>
    </div>
  </section>

  <!-- 10. come hungry, in the same frame as the hero -->
  <section data-screen-label="Close" class="br-sec">
    <div class="br-wrap">
      <SignFrame tone="dark" class="br-close" padding="clamp(40px, 7vw, 96px) clamp(18px, 4.5vw, 64px)">
        <h2 class="br-close-h2"><span>Come</span><span class="is-gold">Hungry</span></h2>
        <p style={`${P} margin-left: auto; margin-right: auto; text-align: center;`}>One bowl, eight hours of work, $21. Dine in, pick it up, or have it brought to you.</p>
        <div class="br-ctas" style="justify-content: center; margin-top: 24px;">
          <a href={business.orderUrl} target="_blank" rel="noopener" style={BTN_PRIMARY}>Order Takeout</a>
          <a href="/menu" style={BTN_GHOST}>See the Menu</a>
        </div>
      </SignFrame>
    </div>
  </section>

  {dishLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  <script type="application/ld+json" set:html={JSON.stringify(faqLd(FAQ))} />

  <Footer2 />
</div>
<SeasonalMotion />
<MobileCenter />

<style>
  .br-wrap { max-width: 1180px; margin: 0 auto; padding: 0 clamp(18px, 4.5vw, 48px); }
  .br-sec { background: rgb(18, 18, 16); border-top: 1px solid rgba(185, 156, 102, 0.2); padding: clamp(40px, 6.4vw, 84px) 0; scroll-margin-top: 70px; }
  .br-split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 56px); align-items: center; }
  .br-ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  /* the phone CTA layout Base.astro's mobileCtas() applies at runtime, set up front so nothing moves */
  @media (max-width: 767px) { .br-ctas { display: grid; grid-template-columns: minmax(0, 1fr); align-items: stretch; } .br-ctas a { width: 100%; justify-content: center; text-align: center; } }
  @media (max-width: 767px) { .br-split { grid-template-columns: 1fr; } }

  /* ---- 1. hero ---- */
  .br-hero { background: rgb(18, 18, 16); padding: clamp(18px, 3vw, 40px) 0 clamp(18px, 3vw, 32px); }
  .br-sign-top { position: absolute; top: -11px; left: 0; right: 0; text-align: center; pointer-events: none; }
  .br-sign-top span { display: inline-block; background: rgb(18, 18, 16); padding: 0 14px; font-family: 'Barlow Condensed', 'Barlow Condensed Fallback', sans-serif; font-weight: 600; font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: rgb(214, 188, 133); }
  .br-sign-top span::before, .br-sign-top span::after { content: "★"; margin: 0 10px; font-size: 10px; }
