---
import Base from '../layouts/Base.astro';
import Header5 from '../components/Header5.astro';
import Footer2 from '../components/Footer2.astro';
---
<Base title="Karaoke Thursdays in Germantown, MD | Señor Tequilas" description="Karaoke every Thursday, 7:30 to midnight in the bar with DJ Willy. Free to sing, in Germantown, MD." canonical="https://senortequilas.com/karaoke" ogImage="/images/3468c5be0b3897f2.jpg" route="/karaoke">
<div class="sc-host" data-sc-name="Concept 1 Pages" data-dc-tpl="168"><div data-dc-tpl="6" data-c1p-root="" data-uid="c1p4epz3z" style="color: rgb(234, 226, 214); font-family: Barlow, system-ui, -apple-system, sans-serif; background: rgb(18, 18, 16); min-height: 100%;"><Header5 /><section data-dc-tpl="871" data-screen-label="Karaoke hero" style="position: relative; display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); background: rgb(10, 10, 9);">
  <div data-dc-tpl="872" style="position: relative; min-height: clamp(340px, 60vh, 820px); overflow: hidden; background: rgb(28, 27, 24);">
    <img data-dc-tpl="873" decoding="async" fetchpriority="high" src="/images/3468c5be0b3897f2.jpg" alt="Karaoke night with DJ Willy" referrerpolicy="no-referrer" style="position: absolute; inset: 0px; width: 100%; height: 100%; object-fit: cover;">
    <div data-dc-tpl="874" aria-hidden="true" style="position: absolute; inset: 0px; background: linear-gradient(rgba(10, 10, 9, 0.3), rgba(10, 10, 9, 0.1) 50%, rgba(10, 10, 9, 0.6));"></div>
    
  </div>
  <div data-dc-tpl="875" style="position: relative; display: flex; align-items: center; padding: clamp(28px, 5vw, 72px) clamp(20px, 5vw, 64px); background: linear-gradient(rgba(6, 52, 20, 0.7), rgba(10, 10, 9, 0.94)), url(/images/9cf29efa1cbf0c3e.webp) center center / cover no-repeat;">
    <div data-dc-tpl="876" style="max-width: 540px;">
      <div data-dc-tpl="877" style="display: flex; align-items: center; gap: 10px; font-family: &quot;Barlow Condensed&quot;, sans-serif; font-weight: 600; font-size: 14px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(214, 188, 133);"><span data-dc-tpl="878" style="width: 26px; height: 1px; background: rgba(185, 156, 102, 0.6);"></span>Germantown, MD · 7:30 to Midnight</div>
      <h1 data-dc-tpl="879" style="color: rgb(246, 239, 228); font-family: &quot;Archivo Black&quot;, sans-serif; font-size: clamp(2.75rem, 6vw, 6.25rem); line-height: 0.94; letter-spacing: -0.015em; margin: 14px 0px 0px; text-transform: uppercase; text-wrap: balance; max-width: 14ch;">Karaoke Every <span data-dc-tpl="880" style="color: rgb(56, 176, 73);">Thursday</span></h1>
      <p data-dc-tpl="881" style="font-size: clamp(15px, 1.6vw, 17px); line-height: 1.6; color: rgba(234, 226, 214, 0.88); max-width: 44ch; margin: 16px 0px 0px; text-wrap: pretty;">7:30 until midnight in the bar. Free to sing, painful to listen to, worth it every time.</p>
      <div data-dc-tpl="882" style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; max-width: 460px; margin-top: 22px;">
        <a data-dc-tpl="883" href="https://tables.toasttab.com/restaurants/d94fa749-fbd5-4a66-90b6-d7755b8c3af3/findTime" target="_blank" class="scp2" style="text-align: center; background: rgb(56, 176, 73); color: rgb(12, 18, 13); font-weight: 800; font-size: 15px; padding: 16px 14px; border-radius: 12px; min-height: 52px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; box-shadow: rgba(56, 176, 73, 0.35) 0px 0px 30px;">Reserve Thursday</a>
        <a data-dc-tpl="884" href="#songs" class="scp1" style="text-align: center; border: 1.5px solid rgba(185, 156, 102, 0.75); color: rgb(234, 226, 214); font-weight: 700; font-size: 15px; padding: 16px 14px; border-radius: 12px; min-height: 52px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; background: rgba(18, 18, 16, 0.4);">See Every Night</a>
      </div>
    </div>
  </div></section><section data-dc-tpl="885" id="songs" data-screen-label="How karaoke works" style="background: rgb(18, 18, 16); padding: clamp(40px, 7vw, 88px) 0px; scroll-margin-top: 70px;">
  <div data-dc-tpl="886" style="max-width: 1180px; margin: 0px auto; padding: 0px clamp(18px, 4.6vw, 48px); display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: clamp(24px, 4vw, 56px); align-items: start;">
    <div data-dc-tpl="887">
      <h2 data-dc-tpl="888" style="color: rgb(246, 239, 228); font-family: &quot;Archivo Black&quot;, sans-serif; font-size: clamp(28px, 5.5vw, 46px); line-height: 1.02; margin: 0px; text-transform: uppercase;">How it works</h2>
      <div data-dc-tpl="889" style="display: grid; gap: 12px; margin-top: 22px;">
        <div data-dc-tpl="891" style="display: flex; gap: 16px; align-items: flex-start;"><div data-dc-tpl="892" style="flex: 0 0 auto; width: 44px; height: 44px; border-radius: 50%; background: rgb(28, 27, 24); border: 1px solid rgba(56, 176, 73, 0.6); display: flex; align-items: center; justify-content: center; font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 16px; color: rgb(56, 176, 73);"><span class="sc-interp">1</span></div><div data-dc-tpl="893"><div data-dc-tpl="894" style="font-weight: 700; font-size: 16px; color: rgb(246, 239, 228);"><span class="sc-interp">Put your name on DJ Willy's list</span></div><div data-dc-tpl="895" style="font-size: 14px; line-height: 1.6; color: rgba(234, 226, 214, 0.82); margin-top: 4px;"><span class="sc-interp">Show up, put your name on DJ Willy's list, order a margarita while you wait for your turn.</span></div></div></div><div data-dc-tpl="891" style="display: flex; gap: 16px; align-items: flex-start;"><div data-dc-tpl="892" style="flex: 0 0 auto; width: 44px; height: 44px; border-radius: 50%; background: rgb(28, 27, 24); border: 1px solid rgba(56, 176, 73, 0.6); display: flex; align-items: center; justify-content: center; font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 16px; color: rgb(56, 176, 73);"><span class="sc-interp">1</span></div><div data-dc-tpl="893"><div data-dc-tpl="894" style="font-weight: 700; font-size: 16px; color: rgb(246, 239, 228);"><span class="sc-interp">Scan the code on your table</span></div><div data-dc-tpl="895" style="font-size: 14px; line-height: 1.6; color: rgba(234, 226, 214, 0.82); margin-top: 4px;"><span class="sc-interp">Pulls up the catalogue. Search by song, artist or language.</span></div></div></div><div data-dc-tpl="891" style="display: flex; gap: 16px; align-items: flex-start;"><div data-dc-tpl="892" style="flex: 0 0 auto; width: 44px; height: 44px; border-radius: 50%; background: rgb(28, 27, 24); border: 1px solid rgba(56, 176, 73, 0.6); display: flex; align-items: center; justify-content: center; font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 16px; color: rgb(56, 176, 73);"><span class="sc-interp">2</span></div><div data-dc-tpl="893"><div data-dc-tpl="894" style="font-weight: 700; font-size: 16px; color: rgb(246, 239, 228);"><span class="sc-interp">Queue it</span></div><div data-dc-tpl="895" style="font-size: 14px; line-height: 1.6; color: rgba(234, 226, 214, 0.82); margin-top: 4px;"><span class="sc-interp">Add your name. The screen over the bar shows who's up next and roughly when.</span></div></div></div><div data-dc-tpl="891" style="display: flex; gap: 16px; align-items: flex-start;"><div data-dc-tpl="892" style="flex: 0 0 auto; width: 44px; height: 44px; border-radius: 50%; background: rgb(28, 27, 24); border: 1px solid rgba(56, 176, 73, 0.6); display: flex; align-items: center; justify-content: center; font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 16px; color: rgb(56, 176, 73);"><span class="sc-interp">3</span></div><div data-dc-tpl="893"><div data-dc-tpl="894" style="font-weight: 700; font-size: 16px; color: rgb(246, 239, 228);"><span class="sc-interp">Take the stage</span></div><div data-dc-tpl="895" style="font-size: 14px; line-height: 1.6; color: rgba(234, 226, 214, 0.82); margin-top: 4px;"><span class="sc-interp">Real mic, real monitor, a host who'll harmonize if you're drowning.</span></div></div></div>
      </div>
    </div>
    <div data-dc-tpl="896" style="background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 20px; padding: 24px;">
      <div data-dc-tpl="897" style="font-family: &quot;Barlow Condensed&quot;, sans-serif; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(214, 188, 133);">Most sung this month</div>
      <div data-dc-tpl="898" style="display: grid; gap: 0px; margin-top: 12px; border-top: 1px solid rgb(42, 40, 32);">
        <div data-dc-tpl="900" style="display: grid; grid-template-columns: 28px 1fr auto; gap: 12px; align-items: baseline; padding: 12px 0px; border-bottom: 1px solid rgb(42, 40, 32);"><span data-dc-tpl="901" style="font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 14px; color: rgb(56, 176, 73);"><span class="sc-interp">01</span></span><span data-dc-tpl="902" style="font-weight: 700; font-size: 15px; color: rgb(246, 239, 228);"><span class="sc-interp">Cielito Lindo</span></span><span data-dc-tpl="903" style="font-size: 13px; color: rgba(234, 226, 214, 0.7);"><span class="sc-interp">Crowd favorite</span></span></div><div data-dc-tpl="900" style="display: grid; grid-template-columns: 28px 1fr auto; gap: 12px; align-items: baseline; padding: 12px 0px; border-bottom: 1px solid rgb(42, 40, 32);"><span data-dc-tpl="901" style="font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 14px; color: rgb(56, 176, 73);"><span class="sc-interp">02</span></span><span data-dc-tpl="902" style="font-weight: 700; font-size: 15px; color: rgb(246, 239, 228);"><span class="sc-interp">Livin' on a Prayer</span></span><span data-dc-tpl="903" style="font-size: 13px; color: rgba(234, 226, 214, 0.7);"><span class="sc-interp">Bon Jovi</span></span></div><div data-dc-tpl="900" style="display: grid; grid-template-columns: 28px 1fr auto; gap: 12px; align-items: baseline; padding: 12px 0px; border-bottom: 1px solid rgb(42, 40, 32);"><span data-dc-tpl="901" style="font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 14px; color: rgb(56, 176, 73);"><span class="sc-interp">03</span></span><span data-dc-tpl="902" style="font-weight: 700; font-size: 15px; color: rgb(246, 239, 228);"><span class="sc-interp">Amor Eterno</span></span><span data-dc-tpl="903" style="font-size: 13px; color: rgba(234, 226, 214, 0.7);"><span class="sc-interp">Rocío Dúrcal</span></span></div><div data-dc-tpl="900" style="display: grid; grid-template-columns: 28px 1fr auto; gap: 12px; align-items: baseline; padding: 12px 0px; border-bottom: 1px solid rgb(42, 40, 32);"><span data-dc-tpl="901" style="font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 14px; color: rgb(56, 176, 73);"><span class="sc-interp">04</span></span><span data-dc-tpl="902" style="font-weight: 700; font-size: 15px; color: rgb(246, 239, 228);"><span class="sc-interp">Piano Man</span></span><span data-dc-tpl="903" style="font-size: 13px; color: rgba(234, 226, 214, 0.7);"><span class="sc-interp">Billy Joel</span></span></div>
      </div>
      <div data-dc-tpl="904" style="font-size: 12px; color: rgba(234, 226, 214, 0.6); margin-top: 12px;">Ask DJ Willy, he keeps the real list behind the booth.</div>
    </div>
  </div></section><section data-dc-tpl="905" data-screen-label="Karaoke specials + photo strip" style="background: linear-gradient(rgba(14, 14, 13, 0.78), rgba(10, 10, 9, 0.9)), url(/images/86475be0134bfc90.webp) center center / cover no-repeat; border-top: 1px solid rgba(185, 156, 102, 0.2); padding: clamp(44px, 7vw, 88px) 0px;">
  <div data-dc-tpl="906" style="max-width: 1180px; margin: 0px auto; padding: 0px clamp(18px, 4.6vw, 48px);">
    <div data-dc-tpl="907" style="display: flex; align-items: center; gap: 10px; font-family: &quot;Barlow Condensed&quot;, sans-serif; font-weight: 600; font-size: 14px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(214, 188, 133);"><span data-dc-tpl="908" style="width: 26px; height: 1px; background: rgba(185, 156, 102, 0.6);"></span>Every other night</div>
    <h2 data-dc-tpl="909" style="color: rgb(246, 239, 228); font-family: &quot;Archivo Black&quot;, sans-serif; font-size: clamp(26px, 4.6vw, 44px); line-height: 1.02; margin: 8px 0px 22px; text-transform: uppercase; text-wrap: balance;">The rest of the week</h2>
    <div data-dc-tpl="910" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 10px;">
      <div data-dc-tpl="912" style="position: relative; aspect-ratio: 4 / 5; border-radius: 14px; overflow: hidden; border: 1px solid rgba(185, 156, 102, 0.3); background: url(&quot;/images/8cd7641ffaf36916.jpg&quot;) center center / cover no-repeat rgb(28, 27, 24);"><span data-dc-tpl="913" style="position: absolute; left: 10px; bottom: 8px; font-family: &quot;Barlow Condensed&quot;, sans-serif; font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: rgb(185, 156, 102); background: rgba(13, 13, 11, 0.75); padding: 4px 8px; border-radius: 999px;"><span class="sc-interp">The bar, before the crowd</span></span></div><div data-dc-tpl="912" style="position: relative; aspect-ratio: 4 / 5; border-radius: 14px; overflow: hidden; border: 1px solid rgba(185, 156, 102, 0.3); background: url(&quot;/images/e6338cdda4653beb.jpg&quot;) center center / cover no-repeat rgb(28, 27, 24);"><span data-dc-tpl="913" style="position: absolute; left: 10px; bottom: 8px; font-family: &quot;Barlow Condensed&quot;, sans-serif; font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: rgb(185, 156, 102); background: rgba(13, 13, 11, 0.75); padding: 4px 8px; border-radius: 999px;"><span class="sc-interp">Tornados, lined up</span></span></div><div data-dc-tpl="912" style="position: relative; aspect-ratio: 4 / 5; border-radius: 14px; overflow: hidden; border: 1px solid rgba(185, 156, 102, 0.3); background: url(&quot;/images/20d856a9f66a9c4c.jpg&quot;) center center / cover no-repeat rgb(28, 27, 24);"><span data-dc-tpl="913" style="position: absolute; left: 10px; bottom: 8px; font-family: &quot;Barlow Condensed&quot;, sans-serif; font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: rgb(185, 156, 102); background: rgba(13, 13, 11, 0.75); padding: 4px 8px; border-radius: 999px;"><span class="sc-interp">The table, singing along</span></span></div><div data-dc-tpl="912" style="position: relative; aspect-ratio: 4 / 5; border-radius: 14px; overflow: hidden; border: 1px solid rgba(185, 156, 102, 0.3); background: url(&quot;/images/site/need-image.svg&quot;) center center / cover no-repeat rgb(28, 27, 24);"><span data-dc-tpl="913" style="position: absolute; left: 10px; bottom: 8px; font-family: &quot;Barlow Condensed&quot;, sans-serif; font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: rgb(185, 156, 102); background: rgba(13, 13, 11, 0.75); padding: 4px 8px; border-radius: 999px;"><span class="sc-interp">Placeholder: the host</span></span></div>
    </div>
    <div data-dc-tpl="914" style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 18px; margin-top: 28px; background: rgb(28, 27, 24); border: 1px solid rgba(185, 156, 102, 0.35); border-radius: 18px; padding: 22px 24px;">
      
      <a data-dc-tpl="918" href="https://tables.toasttab.com/restaurants/d94fa749-fbd5-4a66-90b6-d7755b8c3af3/findTime" target="_blank" class="scp2" style="background: rgb(56, 176, 73); color: rgb(12, 18, 13); font-weight: 800; font-size: 15px; padding: 15px 24px; border-radius: 12px; min-height: 52px; box-sizing: border-box; display: inline-flex; align-items: center; box-shadow: rgba(56, 176, 73, 0.32) 0px 0px 30px;">Book a Table for Thursday</a>
    </div>
  </div></section><Footer2 /></div></div>
</Base>
