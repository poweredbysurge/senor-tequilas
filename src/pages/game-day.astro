---
import Base from '../layouts/Base.astro';
import Header5 from '../components/Header5.astro';
import Footer2 from '../components/Footer2.astro';
---
<Base title="Where to Watch the Commanders, Eagles, Steelers & Every NFL Game in Germantown, MD | Señor Tequila's" description="Every NFL game on: Commanders, Ravens, Eagles, Steelers. World Cup and Champions League watch parties, all day Sunday happy hour, bar area seats 108. Germantown, MD." canonical="https://senortequilas.com/game-day" ogImage="/images/site/game-day-hero.jpg" extraTypes={['SportsActivityLocation', 'BarOrPub']} route="/game-day">
<!--
  /game-day, the twenty-second page. Authored, not extracted: the design never drew it.
  Written against the Sept 14 call. Soccer leads and NFL follows on purpose, because the
  World Cup and El Tri watch parties are the proof this room already has, and the NFL team
  terms are the volume.

  Visual language is unchanged: same tokens, type, section rhythm and card treatments as the
  rest of the site, and the seven-night calendar is the one from /taco-tuesday.

  No prices anywhere. Never write "Sunday Ticket"; "every NFL game" carries the same promise.
-->
<div class="sc-host" data-sc-name="Game Day" style="color: rgb(234, 226, 214); font-family: Barlow, system-ui, -apple-system, sans-serif; background: rgb(18, 18, 16);">
  <Header5 />

  <section data-screen-label="Game day hero" style="background: rgb(18, 18, 16); border-bottom: 1px solid rgba(185, 156, 102, 0.2);">
    <div style="max-width: 1180px; margin: 0px auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); align-items: center; gap: clamp(24px, 4vw, 56px);">
      <div style="padding: clamp(36px, 6vw, 76px) clamp(18px, 4.5vw, 48px);">
        <div style="display: flex; align-items: center; gap: 10px; font-family: 'Barlow Condensed', sans-serif; font-weight: 600; font-size: 14px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(214, 188, 133);">
          <span style="width: 26px; height: 1px; background: rgba(214, 188, 133, 0.7);"></span>Germantown, MD · Bar area seats 108
        </div>
        <h1 style="color: rgb(246, 239, 228); font-family: 'Archivo Black', sans-serif; font-size: clamp(30px, 5.6vw, 56px); line-height: 1.02; margin: 10px 0px 0px; text-transform: uppercase; text-wrap: balance;">Every Game, Every Night</h1>
        <p style="font-size: 16px; line-height: 1.7; color: rgba(234, 226, 214, 0.85); margin: 16px 0px 0px; max-width: 52ch; text-wrap: pretty;">The World Cup, the Champions League, Liga MX, and every NFL game from the Commanders to the Eagles, in a room built for it.</p>
        <div style="display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px;">
          <a href="#tonight" style="display: inline-flex; align-items: center; justify-content: center; background: rgb(56, 176, 73); color: rgb(12, 18, 13); font-weight: 800; font-size: 15px; padding: 16px 24px; border-radius: 12px; min-height: 52px; box-sizing: border-box; box-shadow: rgba(56, 176, 73, 0.35) 0px 0px 30px;">See Tonight</a>
          <a href="/happy-hour#sunday" style="display: inline-flex; align-items: center; justify-content: center; border: 1.5px solid rgba(185, 156, 102, 0.75); color: rgb(234, 226, 214); font-weight: 700; font-size: 15px; padding: 16px 24px; border-radius: 12px; min-height: 52px; box-sizing: border-box; background: rgba(18, 18, 16, 0.4);">Sunday Happy Hour</a>
        </div>
        <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px;">
          <a href="#soccer" style="display: inline-flex; align-items: center; justify-content: center; border: 1px solid rgba(185, 156, 102, 0.5); color: rgb(234, 226, 214); font-weight: 700; font-size: 13px; padding: 0px 14px; min-height: 44px; border-radius: 999px; box-sizing: border-box;">Soccer</a>
          <a href="#nfl" style="display: inline-flex; align-items: center; justify-content: center; border: 1px solid rgba(185, 156, 102, 0.5); color: rgb(234, 226, 214); font-weight: 700; font-size: 13px; padding: 0px 14px; min-height: 44px; border-radius: 999px; box-sizing: border-box;">NFL Sundays</a>
          <a href="#fights" style="display: inline-flex; align-items: center; justify-content: center; border: 1px solid rgba(185, 156, 102, 0.5); color: rgb(234, 226, 214); font-weight: 700; font-size: 13px; padding: 0px 14px; min-height: 44px; border-radius: 999px; box-sizing: border-box;">Fight nights</a>
          <a href="#bar-area" style="display: inline-flex; align-items: center; justify-content: center; border: 1px solid rgba(185, 156, 102, 0.5); color: rgb(234, 226, 214); font-weight: 700; font-size: 13px; padding: 0px 14px; min-height: 44px; border-radius: 999px; box-sizing: border-box;">The bar area</a>
        </div>
      </div>
      <div style="position: relative; min-height: clamp(300px, 46vh, 720px); overflow: hidden; background: url(/images/site/game-day-hero.jpg) center 30% / cover no-repeat rgb(28, 27, 24);"><video autoplay loop muted playsinline preload="metadata" poster="/videos/game-day-hero.jpg" aria-hidden="true" tabindex="-1" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 30%; display: block; pointer-events: none;"><source src="/videos/game-day-hero.mp4" type="video/mp4"></video></div>
    </div>
  </section>

  <section id="soccer" data-screen-label="Soccer" style="background: rgb(20, 18, 16); border-top: 1px solid rgba(185, 156, 102, 0.2); padding: clamp(40px, 6.4vw, 84px) 0px; scroll-margin-top: 70px;">
    <div style="max-width: 1180px; margin: 0px auto; padding: 0px clamp(18px, 4.5vw, 48px);">
      <div style="display: flex; align-items: center; gap: 10px; font-family: 'Barlow Condensed', sans-serif; font-weight: 600; font-size: 14px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(214, 188, 133);">
        <span style="width: 26px; height: 1px; background: rgba(214, 188, 133, 0.7);"></span>The room already filled up for this
      </div>
      <h2 style="color: rgb(246, 239, 228); font-family: 'Archivo Black', sans-serif; font-size: clamp(26px, 4.6vw, 42px); line-height: 1.04; margin: 10px 0px 0px; text-transform: uppercase; text-wrap: balance;">Every Match, Every League: World Cup, Champions League, Liga MX</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: clamp(20px, 3vw, 40px); margin-top: 22px;">
        <p style="font-size: 15px; line-height: 1.7; color: rgba(234, 226, 214, 0.85); margin: 0px; text-wrap: pretty;">We hosted the 2026 World Cup and the room was full. Mexico matches are the ones that pack it: jerseys on, sound up, every table taken well before kickoff.</p>
        <p style="font-size: 15px; line-height: 1.7; color: rgba(234, 226, 214, 0.85); margin: 0px; text-wrap: pretty;">European matches carry the rest of the year. Champions League and Premier League go on in the bar area through the weekend, which is when most people turn up looking for somewhere to watch the game.</p>
        <p style="font-size: 15px; line-height: 1.7; color: rgba(234, 226, 214, 0.85); margin: 0px; text-wrap: pretty;">Liga MX is on too, and so is every Mexico match. If you are working out where to watch Liga MX in Montgomery County, this is a room that already knows the fixture list.</p>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 12px; margin-top: 26px;">
        <div style="aspect-ratio: 4 / 5; border-radius: 16px; overflow: hidden; border: 1px solid rgb(42, 40, 32); background: url(/images/site/watch-party-room.jpg) center center / cover no-repeat rgb(28, 27, 24);" role="img" aria-label="A full table of guests in jerseys at a watch party, the lit bar and the screens behind them"></div>
        <div style="aspect-ratio: 4 / 5; border-radius: 16px; overflow: hidden; border: 1px solid rgb(42, 40, 32); background: url(/images/site/watch-party-trophy.jpg) center center / cover no-repeat rgb(28, 27, 24);" role="img" aria-label="Guests raising a World Cup trophy replica under the flower ceiling, the match on the screens behind"></div>
        <div style="aspect-ratio: 4 / 5; border-radius: 16px; overflow: hidden; border: 1px solid rgb(42, 40, 32); background: url(/images/site/watch-party-crowd.jpg) center center / cover no-repeat rgb(28, 27, 24);" role="img" aria-label="A crowd celebrating during a World Cup watch party in the bar area"></div>
      </div>
    </div>
  </section>

  <section id="nfl" data-screen-label="NFL Sundays" style="background: rgb(18, 18, 16); border-top: 1px solid rgba(185, 156, 102, 0.2); padding: clamp(40px, 6.4vw, 84px) 0px; scroll-margin-top: 70px;">
    <div style="max-width: 1180px; margin: 0px auto; padding: 0px clamp(18px, 4.5vw, 48px);">
      <div style="display: flex; align-items: center; gap: 10px; font-family: 'Barlow Condensed', sans-serif; font-weight: 600; font-size: 14px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(214, 188, 133);">
        <span style="width: 26px; height: 1px; background: rgba(214, 188, 133, 0.7);"></span>Every day we are open, in season
      </div>
      <h2 style="color: rgb(246, 239, 228); font-family: 'Archivo Black', sans-serif; font-size: clamp(26px, 4.6vw, 42px); line-height: 1.04; margin: 10px 0px 0px; text-transform: uppercase; text-wrap: balance;">Every NFL Game, Every Sunday</h2>
      <p style="font-size: 15px; line-height: 1.7; color: rgba(234, 226, 214, 0.85); margin: 14px 0px 0px; max-width: 62ch; text-wrap: pretty;">Every NFL game is on, every day we are open during the season, with the sound up on the big ones. Big games are first come, first served, so get here early if you want the table you want.</p>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); gap: 12px; margin-top: 24px;">
        <div style="background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 16px; padding: 18px 20px;">
          <h3 style="font-family: 'Archivo Black', sans-serif; font-size: 16px; text-transform: uppercase; color: rgb(246, 239, 228); margin: 0px; line-height: 1.15;">Commanders</h3>
          <p style="font-size: 13px; line-height: 1.55; color: rgba(234, 226, 214, 0.8); margin: 8px 0px 0px;">The home team, and the one the room follows first. Where to watch the Commanders game in Germantown: right here, every week, sound on for the big ones.</p>
        </div>
        <div style="background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 16px; padding: 18px 20px;">
          <h3 style="font-family: 'Archivo Black', sans-serif; font-size: 16px; text-transform: uppercase; color: rgb(246, 239, 228); margin: 0px; line-height: 1.15;">Eagles</h3>
          <p style="font-size: 13px; line-height: 1.55; color: rgba(234, 226, 214, 0.8); margin: 8px 0px 0px;">Every Eagles game is on. If you have been looking for an Eagles bar in Montgomery County rather than driving to Philadelphia, this is where to watch the Eagles game.</p>
        </div>
        <div style="background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 16px; padding: 18px 20px;">
          <h3 style="font-family: 'Archivo Black', sans-serif; font-size: 16px; text-transform: uppercase; color: rgb(246, 239, 228); margin: 0px; line-height: 1.15;">Steelers</h3>
          <p style="font-size: 13px; line-height: 1.55; color: rgba(234, 226, 214, 0.8); margin: 8px 0px 0px;">A long way from Pittsburgh, and every Steelers game is still on. Where to watch the Steelers game without the drive: a Steelers bar for the people who moved here and kept the team.</p>
        </div>
        <div style="background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 16px; padding: 18px 20px;">
          <h3 style="font-family: 'Archivo Black', sans-serif; font-size: 16px; text-transform: uppercase; color: rgb(246, 239, 228); margin: 0px; line-height: 1.15;">Ravens</h3>
          <p style="font-size: 13px; line-height: 1.55; color: rgba(234, 226, 214, 0.8); margin: 8px 0px 0px;">Baltimore is straight up the road. Every Ravens game is on, so where to watch the Ravens game is ten minutes off 270 in a Ravens bar that is not a chain.</p>
        </div>
      </div>

      <div style="margin-top: 14px; background: linear-gradient(rgba(60, 44, 18, 0.5), rgba(28, 20, 8, 0.72)); border: 1px solid rgba(185, 156, 102, 0.4); border-radius: 18px; padding: 22px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px;">
        <div>
          <h3 style="color: rgb(246, 239, 228); font-family: 'Archivo Black', sans-serif; font-size: clamp(20px, 3vw, 28px); text-transform: uppercase; line-height: 1.05; margin: 0px;">Sunday Happy Hour, All Day in the Bar Area</h3>
          <p style="font-size: 14px; line-height: 1.6; color: rgba(234, 226, 214, 0.85); margin: 8px 0px 0px; max-width: 52ch;">Game day specials every Sunday, open to close.</p>
        </div>
        <a href="/happy-hour#sunday" style="display: inline-flex; align-items: center; justify-content: center; background: rgb(185, 156, 102); color: rgb(18, 18, 16); font-weight: 800; font-size: 14px; padding: 14px 22px; border-radius: 12px; min-height: 48px; box-sizing: border-box;">The happy hour menu →</a>
      </div>

      <p style="font-size: 14px; line-height: 1.7; color: rgba(234, 226, 214, 0.8); margin: 18px 0px 0px; max-width: 66ch; text-wrap: pretty;">Thursday night football runs alongside karaoke in the bar area, 7:30 to midnight. Saturday carries college football, and the DJ takes over from 9. <a href="/late-night" style="color: rgb(214, 188, 133); font-weight: 700;">Late night</a>.</p>
    </div>
  </section>

  <section id="fights" data-screen-label="Fight nights" style="background: rgb(20, 18, 16); border-top: 1px solid rgba(185, 156, 102, 0.2); padding: clamp(36px, 5.6vw, 72px) 0px; scroll-margin-top: 70px;">
    <div style="max-width: 1180px; margin: 0px auto; padding: 0px clamp(18px, 4.5vw, 48px);">
      <div style="display: flex; align-items: center; gap: 10px; font-family: 'Barlow Condensed', sans-serif; font-weight: 600; font-size: 14px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(214, 188, 133);">
        <span style="width: 26px; height: 1px; background: rgba(214, 188, 133, 0.7);"></span>When the big one lands
      </div>
      <h2 style="color: rgb(246, 239, 228); font-family: 'Archivo Black', sans-serif; font-size: clamp(26px, 4.6vw, 42px); line-height: 1.04; margin: 10px 0px 0px; text-transform: uppercase;">Fight Nights</h2>
      <!-- [PENDING: confirm UFC]. If Roberto confirms they show it, this copy adds "and UFC". -->
      <p style="font-size: 15px; line-height: 1.7; color: rgba(234, 226, 214, 0.85); margin: 14px 0px 0px; max-width: 62ch; text-wrap: pretty;">We put the big fights on, Canelo nights included, with the sound up. Fight nights are first come, first served like every other big game, so get here early. The bar area is where it happens, and it fills.</p>
    </div>
  </section>

  <section id="bar-area" data-screen-label="The bar area" style="background: rgb(18, 18, 16); border-top: 1px solid rgba(185, 156, 102, 0.2); padding: clamp(40px, 6.4vw, 84px) 0px; scroll-margin-top: 70px;">
    <div style="max-width: 1180px; margin: 0px auto; padding: 0px clamp(18px, 4.5vw, 48px);">
      <div style="display: flex; align-items: center; gap: 10px; font-family: 'Barlow Condensed', sans-serif; font-weight: 600; font-size: 14px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(214, 188, 133);">
        <span style="width: 26px; height: 1px; background: rgba(214, 188, 133, 0.7);"></span>Where you watch it
      </div>
      <h2 style="color: rgb(246, 239, 228); font-family: 'Archivo Black', sans-serif; font-size: clamp(26px, 4.6vw, 42px); line-height: 1.04; margin: 10px 0px 22px; text-transform: uppercase;">The Bar Area</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); gap: 12px;">
        <div style="background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 16px; padding: 18px 20px;">
          <div style="font-family: 'Barlow Condensed', sans-serif; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: rgb(214, 188, 133);">The seats</div>
          <div style="font-family: 'Archivo Black', sans-serif; font-size: 16px; text-transform: uppercase; color: rgb(246, 239, 228); margin-top: 5px; line-height: 1.15;">108 Seated, 150 Capacity</div>
          <p style="font-size: 13px; line-height: 1.55; color: rgba(234, 226, 214, 0.8); margin: 8px 0px 0px;">Sixteen tables of four, two long tables that seat twelve, and a twenty-seat counter.</p>
        </div>
        <div style="background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 16px; padding: 18px 20px;">
          <div style="font-family: 'Barlow Condensed', sans-serif; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: rgb(214, 188, 133);">The screens</div>
          <div style="font-family: 'Archivo Black', sans-serif; font-size: 16px; text-transform: uppercase; color: rgb(246, 239, 228); margin-top: 5px; line-height: 1.15;">Three Rooms of TVs</div>
          <p style="font-size: 13px; line-height: 1.55; color: rgba(234, 226, 214, 0.8); margin: 8px 0px 0px;">TVs in the bar area, the International Room and the patio. <span style="font-family: 'Barlow Condensed', sans-serif; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: rgb(185, 156, 102);">[PENDING: TV count, 20 or 25]</span></p>
        </div>
        <div style="background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 16px; padding: 18px 20px;">
          <div style="font-family: 'Barlow Condensed', sans-serif; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: rgb(214, 188, 133);">Getting a table</div>
          <div style="font-family: 'Archivo Black', sans-serif; font-size: 16px; text-transform: uppercase; color: rgb(246, 239, 228); margin-top: 5px; line-height: 1.15;">First Come, First Served</div>
          <p style="font-size: 13px; line-height: 1.55; color: rgba(234, 226, 214, 0.8); margin: 8px 0px 0px;">No reservations for the big games. The two long tables are the ones to aim for if you are bringing people.</p>
        </div>
        <div style="background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 16px; padding: 18px 20px;">
          <div style="font-family: 'Barlow Condensed', sans-serif; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: rgb(214, 188, 133);">After 9</div>
          <div style="font-family: 'Archivo Black', sans-serif; font-size: 16px; text-transform: uppercase; color: rgb(246, 239, 228); margin-top: 5px; line-height: 1.15;">21 and Over, Fri and Sat</div>
          <p style="font-size: 13px; line-height: 1.55; color: rgba(234, 226, 214, 0.8); margin: 8px 0px 0px;">The bar area is 21 and over after 9 PM on Friday and Saturday. Under 21 leaves the bar area by 10.</p>
        </div>
      </div>
      <p style="font-size: 14px; line-height: 1.7; color: rgba(234, 226, 214, 0.8); margin: 16px 0px 0px; max-width: 62ch; text-wrap: pretty;">Bringing more than twelve? That goes through <a href="/private-parties" style="color: rgb(214, 188, 133); font-weight: 700;">private events</a> so we can hold a room for you. We are next to Topgolf with free parking at the door.</p>
    </div>
  </section>

  <section data-screen-label="What to order during the game" style="background: rgb(20, 18, 16); border-top: 1px solid rgba(185, 156, 102, 0.2); padding: clamp(40px, 6.4vw, 84px) 0px;">
    <div style="max-width: 1180px; margin: 0px auto; padding: 0px clamp(18px, 4.5vw, 48px);">
      <div style="display: flex; align-items: center; gap: 10px; font-family: 'Barlow Condensed', sans-serif; font-weight: 600; font-size: 14px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(214, 188, 133);">
        <span style="width: 26px; height: 1px; background: rgba(214, 188, 133, 0.7);"></span>For the table
      </div>
      <h2 style="color: rgb(246, 239, 228); font-family: 'Archivo Black', sans-serif; font-size: clamp(26px, 4.6vw, 42px); line-height: 1.04; margin: 10px 0px 22px; text-transform: uppercase;">What to Order During the Game</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 14px;">
        <a href="/margaritas" style="display: flex; flex-direction: column; background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 18px; overflow: hidden; color: rgb(234, 226, 214);">
          <div style="aspect-ratio: 5 / 4; background: url(/images/dishes/big-mami.jpg) center center / cover no-repeat rgb(35, 33, 28);"></div>
          <div style="padding: 16px 18px 18px;">
            <div style="font-family: 'Archivo Black', sans-serif; font-size: 17px; text-transform: uppercase; color: rgb(246, 239, 228);">The Big Mami</div>
            <p style="font-size: 14px; line-height: 1.55; color: rgba(234, 226, 214, 0.82); margin: 6px 0px 0px;">Fifty-four ounces, one glass, for the whole table. Two-for-one on the rocks every Monday.</p>
            <span style="display: inline-flex; margin-top: 10px; font-weight: 700; font-size: 14px; color: rgb(56, 176, 73);">The margaritas →</span>
          </div>
        </a>
        <a href="/street-tacos" style="display: flex; flex-direction: column; background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 18px; overflow: hidden; color: rgb(234, 226, 214);">
          <div style="aspect-ratio: 5 / 4; background: url(/images/dishes/tacos-de-arrachera-card.jpg) center center / cover no-repeat rgb(35, 33, 28);"></div>
          <div style="padding: 16px 18px 18px;">
            <div style="font-family: 'Archivo Black', sans-serif; font-size: 17px; text-transform: uppercase; color: rgb(246, 239, 228);">Street Tacos</div>
            <p style="font-size: 14px; line-height: 1.55; color: rgba(234, 226, 214, 0.82); margin: 6px 0px 0px;">By the pair or by the five, on tortillas pressed that morning. Easy to eat without looking away.</p>
            <span style="display: inline-flex; margin-top: 10px; font-weight: 700; font-size: 14px; color: rgb(56, 176, 73);">Street tacos →</span>
          </div>
        </a>
        <a href="/menu" style="display: flex; flex-direction: column; background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 18px; overflow: hidden; color: rgb(234, 226, 214);">
          <div style="aspect-ratio: 5 / 4; background: url(/images/dishes/nachos.jpg) center center / cover no-repeat rgb(35, 33, 28);"></div>
          <div style="padding: 16px 18px 18px;">
            <div style="font-family: 'Archivo Black', sans-serif; font-size: 17px; text-transform: uppercase; color: rgb(246, 239, 228);">Nachos</div>
            <p style="font-size: 14px; line-height: 1.55; color: rgba(234, 226, 214, 0.82); margin: 6px 0px 0px;">House-made chips under beans, cheese and queso. The one everybody reaches for at halftime.</p>
            <span style="display: inline-flex; margin-top: 10px; font-weight: 700; font-size: 14px; color: rgb(56, 176, 73);">The full menu →</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section id="tonight" data-screen-label="Every night of the week" style="background: rgb(18, 18, 16); border-top: 1px solid rgba(185, 156, 102, 0.2); padding: clamp(40px, 6.4vw, 84px) 0px; scroll-margin-top: 70px;">
    <div style="max-width: 1180px; margin: 0px auto; padding: 0px clamp(18px, 4.5vw, 48px);">
      <div style="display: flex; align-items: center; gap: 10px; font-family: 'Barlow Condensed', sans-serif; font-weight: 600; font-size: 14px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(214, 188, 133);">
