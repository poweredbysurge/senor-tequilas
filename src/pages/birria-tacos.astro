          <div data-dc-tpl="323" style="aspect-ratio: 4 / 3; background: url(&quot;https://senortequilas.com/wp-content/uploads/2022/04/Birria.jpg&quot;) center center / cover no-repeat rgb(35, 33, 28); border-bottom: 1px solid rgb(42, 40, 32);"></div>
          <div data-dc-tpl="324" style="padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 6px;"><div data-dc-tpl="325" style="display: flex; justify-content: space-between; gap: 8px; align-items: baseline;"><span data-dc-tpl="326" style="font-weight: 700; font-size: 15px; color: rgb(246, 239, 228);"><span class="sc-interp">Quesabirria</span></span></div><div data-dc-tpl="327" style="font-size: 13px; line-height: 1.5; color: rgba(234, 226, 214, 0.8);"><span class="sc-interp">Dipped and griddled with cheese, consommé for dipping</span></div></div>
        </div>
      
        <div data-dc-tpl="322" class="scpa" style="display: flex; flex-direction: column; background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 16px; overflow: hidden;">
          <div data-dc-tpl="323" style="aspect-ratio: 4 / 3; background: url(&quot;https://senortequilas.com/wp-content/uploads/2022/04/Birria.jpg&quot;) center center / cover no-repeat rgb(35, 33, 28); border-bottom: 1px solid rgb(42, 40, 32);"></div>
          <div data-dc-tpl="324" style="padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 6px;"><div data-dc-tpl="325" style="display: flex; justify-content: space-between; gap: 8px; align-items: baseline;"><span data-dc-tpl="326" style="font-weight: 700; font-size: 15px; color: rgb(246, 239, 228);"><span class="sc-interp">Birria</span></span></div><div data-dc-tpl="327" style="font-size: 13px; line-height: 1.5; color: rgba(234, 226, 214, 0.8);"><span class="sc-interp">Slow-braised beef, handmade tortillas, consommé</span></div></div>
        </div>
      
        <div data-dc-tpl="322" class="scpa" style="display: flex; flex-direction: column; background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 16px; overflow: hidden;">
          <div data-dc-tpl="323" style="aspect-ratio: 4 / 3; background: url(&quot;https://senortequilas.com/wp-content/uploads/2022/03/DSC07183-HDR.jpg&quot;) center center / cover no-repeat rgb(35, 33, 28); border-bottom: 1px solid rgb(42, 40, 32);"></div>
          <div data-dc-tpl="324" style="padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 6px;"><div data-dc-tpl="325" style="display: flex; justify-content: space-between; gap: 8px; align-items: baseline;"><span data-dc-tpl="326" style="font-weight: 700; font-size: 15px; color: rgb(246, 239, 228);"><span class="sc-interp">To go</span></span></div><div data-dc-tpl="327" style="font-size: 13px; line-height: 1.5; color: rgba(234, 226, 214, 0.8);"><span class="sc-interp">Packed with the consommé sealed. Order on Toast</span></div></div>
        </div>
      
    </div>
  </div></section><section data-dc-tpl="328" data-screen-label="Pair it" style="background: linear-gradient(rgba(70, 8, 14, 0.7), rgba(40, 4, 8, 0.86)), url(/images/ecf6382a259b5884.png) center center / cover no-repeat; border-top: 1px solid rgba(191, 30, 46, 0.3); padding: clamp(44px, 7vw, 88px) 0px;">
  <div data-dc-tpl="329" style="max-width: 1180px; margin: 0px auto; padding: 0px clamp(18px, 4.6vw, 48px); display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: clamp(24px, 4vw, 56px); align-items: center;">
    <div data-dc-tpl="330">
      <div data-dc-tpl="331" style="display: flex; align-items: center; gap: 10px; font-family: &quot;Barlow Condensed&quot;, sans-serif; font-weight: 600; font-size: 14px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(214, 188, 133);"><span data-dc-tpl="332" style="width: 26px; height: 1px; background: rgba(214, 188, 133, 0.7);"></span>Pair it</div>
      <h2 data-dc-tpl="333" style="color: rgb(246, 239, 228); font-family: &quot;Archivo Black&quot;, sans-serif; font-size: clamp(28px, 5.5vw, 46px); line-height: 1.02; margin: 8px 0px 0px; text-transform: uppercase; text-wrap: balance;"><span class="sc-interp">Birria wants a Cantarito.</span></h2>
      <p data-dc-tpl="334" style="font-size: 15px; line-height: 1.7; color: rgba(234, 226, 214, 0.85); margin: 14px 0px 20px; max-width: 48ch; text-wrap: pretty;"><span class="sc-interp">Rich broth, bright drink. Tequila, lime, orange and grapefruit soda in a clay cup, salted rim. Or a Modelo with lime, no judgment.</span></p>
      <a data-dc-tpl="335" href="/tequila-bar" class="scp9" style="display: inline-flex; align-items: center; justify-content: center; border: 1.5px solid rgba(185, 156, 102, 0.75); color: rgb(234, 226, 214); font-weight: 700; font-size: 15px; padding: 15px 22px; border-radius: 12px; min-height: 52px; box-sizing: border-box; background: rgba(18, 18, 16, 0.4);">See the Bar →</a>
    </div>
    <div data-dc-tpl="336" style="position: relative; aspect-ratio: 4 / 3; border-radius: 18px; overflow: hidden; border: 1px solid rgba(185, 156, 102, 0.3); background: rgb(28, 27, 24);">
      <img data-dc-tpl="337" loading="lazy" decoding="async" src="https://senortequilas.com/wp-content/uploads/2022/02/Margaritas.jpg" alt="Two margaritas on the bar, one turquoise, one mango with a chile-salt rim" referrerpolicy="no-referrer" style="position: absolute; inset: 0px; width: 100%; height: 100%; object-fit: cover;">
    </div>
  </div></section><DishCrossLinks1 /><section data-dc-tpl="344" data-screen-label="Also try" style="background: rgb(20, 18, 16); border-top: 1px solid rgba(185, 156, 102, 0.2); padding: clamp(36px, 6vw, 72px) 0px;">
  <div data-dc-tpl="345" style="max-width: 1180px; margin: 0px auto; padding: 0px clamp(18px, 4.6vw, 48px);">
    <div data-dc-tpl="346" style="display: flex; align-items: center; gap: 10px; font-family: &quot;Barlow Condensed&quot;, sans-serif; font-weight: 600; font-size: 14px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(214, 188, 133);"><span data-dc-tpl="347" style="width: 26px; height: 1px; background: rgba(185, 156, 102, 0.6);"></span>Keep eating</div>
    <div data-dc-tpl="348" data-m-rail="" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 12px; margin-top: 16px;">
      
        <a data-dc-tpl="350" href="/quesabirria-tacos" class="scp3" style="position: relative; display: flex; flex-direction: column; justify-content: flex-end; min-height: 180px; padding: 16px; border-radius: 16px; overflow: hidden; border: 1px solid rgb(42, 40, 32); background: url(/images/81c82458b034e717.jpg) center center / cover no-repeat rgb(28, 27, 24); color: rgb(234, 226, 214);"><span data-dc-tpl="351" style="position: absolute; inset: 0px; background: linear-gradient(rgba(18, 18, 16, 0.05), rgba(18, 18, 16, 0.92) 75%);"></span><span data-dc-tpl="352" style="position: relative; font-family: &quot;Barlow Condensed&quot;, sans-serif; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(214, 188, 133);"><span class="sc-interp">Dipped and griddled</span></span><span data-dc-tpl="353" style="position: relative; font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 20px; text-transform: uppercase; line-height: 1.05; margin-top: 4px;"><span class="sc-interp">Quesabirria Tacos</span></span></a>
      
        <a data-dc-tpl="350" href="/street-tacos" class="scp3" style="position: relative; display: flex; flex-direction: column; justify-content: flex-end; min-height: 180px; padding: 16px; border-radius: 16px; overflow: hidden; border: 1px solid rgb(42, 40, 32); background: url(/images/0158f8e0dc2e230a.jpg) center center / cover no-repeat rgb(28, 27, 24); color: rgb(234, 226, 214);"><span data-dc-tpl="351" style="position: absolute; inset: 0px; background: linear-gradient(rgba(18, 18, 16, 0.05), rgba(18, 18, 16, 0.92) 75%);"></span><span data-dc-tpl="352" style="position: relative; font-family: &quot;Barlow Condensed&quot;, sans-serif; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(214, 188, 133);"><span class="sc-interp">Handmade tortillas</span></span><span data-dc-tpl="353" style="position: relative; font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 20px; text-transform: uppercase; line-height: 1.05; margin-top: 4px;"><span class="sc-interp">Street Tacos</span></span></a>
      
        <a data-dc-tpl="350" href="/la-dulceria" class="scp3" style="position: relative; display: flex; flex-direction: column; justify-content: flex-end; min-height: 180px; padding: 16px; border-radius: 16px; overflow: hidden; border: 1px solid rgb(42, 40, 32); background: url(/images/0e000bad1f66aea4.jpg) center center / cover no-repeat rgb(28, 27, 24); color: rgb(234, 226, 214);"><span data-dc-tpl="351" style="position: absolute; inset: 0px; background: linear-gradient(rgba(18, 18, 16, 0.05), rgba(18, 18, 16, 0.92) 75%);"></span><span data-dc-tpl="352" style="position: relative; font-family: &quot;Barlow Condensed&quot;, sans-serif; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(214, 188, 133);"><span class="sc-interp">Made in house</span></span><span data-dc-tpl="353" style="position: relative; font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 20px; text-transform: uppercase; line-height: 1.05; margin-top: 4px;"><span class="sc-interp">La Dulcería</span></span></a>
      
