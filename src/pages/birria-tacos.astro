    <div data-dc-tpl="283" data-m-hide="" style="position: absolute; left: clamp(14px, 2vw, 24px); bottom: clamp(14px, 2vw, 24px); display: flex; flex-direction: column; gap: 4px; background: rgba(13, 13, 11, 0.88); border: 1px solid rgba(185, 156, 102, 0.3); border-radius: 12px; padding: 12px 16px; backdrop-filter: blur(8px);"><span data-dc-tpl="284" style="font-family: &quot;Barlow Condensed&quot;, sans-serif; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(56, 176, 73);"><span class="sc-interp">Six-hour braise</span></span><span data-dc-tpl="285" style="font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 16px; text-transform: uppercase;"><span class="sc-interp">Birria de Res</span></span><span data-dc-tpl="286" style="font-size: 13px; color: rgba(234, 226, 214, 0.8);"><span class="sc-interp">The bowl: broth, meat, onion, cilantro, tortillas</span></span></div>
  </div>
  <div data-dc-tpl="287" data-m-overlap="" style="position: relative; overflow: hidden; display: flex; align-items: center; padding: clamp(28px, 5vw, 72px) clamp(20px, 5vw, 64px); background: linear-gradient(rgba(14, 14, 13, 0.78), rgba(10, 10, 9, 0.92)), url(/images/86475be0134bfc90.png) center center / cover no-repeat; order: 1;">
    <div data-dc-tpl="288" style="position: relative; max-width: 560px;">
      <div data-dc-tpl="289" style="display: inline-flex; align-items: center; gap: 8px; padding: 7px 12px; border-radius: 999px; background: rgba(28, 27, 24, 0.78); border: 1px solid rgba(185, 156, 102, 0.32); font-size: 12px; color: rgba(234, 226, 214, 0.9);"><span data-dc-tpl="290" style="width: 7px; height: 7px; border-radius: 50%; background: rgb(56, 176, 73);"></span><span data-dc-tpl="291"><span class="sc-interp">Open now, until 12am</span></span></div>
      <div data-dc-tpl="292" style="display: flex; align-items: center; gap: 10px; margin-top: 18px; font-family: &quot;Barlow Condensed&quot;, sans-serif; font-weight: 600; font-size: 14px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(214, 188, 133);"><span data-dc-tpl="293" style="width: 26px; height: 1px; background: rgba(185, 156, 102, 0.6);"></span><span class="sc-interp">Germantown, MD · Six-Hour Braise</span></div>
      <h1 data-dc-tpl="294" style="color: rgb(246, 239, 228); font-family: &quot;Archivo Black&quot;, sans-serif; font-size: clamp(2.5rem, 4.4vw, 4.5rem); line-height: 0.94; letter-spacing: -0.02em; margin: 8px 0px 0px; max-width: 100%; text-transform: uppercase; text-wrap: balance;"><span class="sc-interp">Birria Tacos</span></h1>
      <p data-dc-tpl="295" style="font-size: clamp(15px, 1.6vw, 17px); line-height: 1.65; color: rgba(234, 226, 214, 0.85); max-width: 50ch; margin: 14px 0px 0px; text-wrap: pretty;"><span class="sc-interp">The real thing: slow-braised beef, handmade tortillas, consommé for dipping.</span></p>
      <div data-dc-tpl="296" style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; max-width: 480px; margin-top: 22px;">
        <a data-dc-tpl="297" href="https://order.toasttab.com/online/senortequilastogo" target="_blank" class="scp2" style="text-align: center; background: rgb(56, 176, 73); color: rgb(12, 18, 13); font-weight: 800; font-size: 15px; padding: 16px 14px; border-radius: 12px; min-height: 52px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; box-shadow: rgba(56, 176, 73, 0.35) 0px 0px 30px;">Order Online</a>
        <a data-dc-tpl="298" href="https://tables.toasttab.com/restaurants/d94fa749-fbd5-4a66-90b6-d7755b8c3af3/findTime" target="_blank" class="scp1" style="text-align: center; border: 1.5px solid rgba(185, 156, 102, 0.75); color: rgb(234, 226, 214); font-weight: 700; font-size: 15px; padding: 16px 14px; border-radius: 12px; min-height: 52px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; background: rgba(18, 18, 16, 0.4);">Reserve</a>
      </div>
      <div data-dc-tpl="299" style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px;">
        <span data-dc-tpl="301" style="display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: rgba(234, 226, 214, 0.85); border: 1px solid rgba(185, 156, 102, 0.3); border-radius: 999px; padding: 6px 11px;"><span data-dc-tpl="302" style="width: 6px; height: 6px; border-radius: 50%; background: rgb(56, 176, 73);"></span><span class="sc-interp">Braised six hours, daily</span></span><span data-dc-tpl="301" style="display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: rgba(234, 226, 214, 0.85); border: 1px solid rgba(185, 156, 102, 0.3); border-radius: 999px; padding: 6px 11px;"><span data-dc-tpl="302" style="width: 6px; height: 6px; border-radius: 50%; background: rgb(56, 176, 73);"></span><span class="sc-interp">Consommé on every order</span></span><span data-dc-tpl="301" style="display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: rgba(234, 226, 214, 0.85); border: 1px solid rgba(185, 156, 102, 0.3); border-radius: 999px; padding: 6px 11px;"><span data-dc-tpl="302" style="width: 6px; height: 6px; border-radius: 50%; background: rgb(56, 176, 73);"></span><span class="sc-interp">Gluten-free as a bowl</span></span>
      </div>
    </div>
  </div></section><section data-dc-tpl="303" data-screen-label="The story of the dish" style="background: rgb(18, 18, 16); padding: clamp(40px, 7vw, 88px) 0px;">
