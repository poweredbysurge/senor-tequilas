---
import Base from '../layouts/Base.astro';
import Header5 from '../components/Header5.astro';
import Footer2 from '../components/Footer2.astro';
---
<Base title="Late Night Food & Drinks | Open to 1 AM, Germantown" description="Open late in Germantown, with the kitchen on until close and the bar to 1 AM Friday and Saturday. Live DJ, 21 and over after 9." canonical="https://senortequilas.com/late-night" ogImage="/images/24e322da4fd1060e.jpg" route="/late-night">
<div class="sc-host" data-sc-name="Concept 1 Pages" data-dc-tpl="156"><div data-dc-tpl="6" data-c1p-root="" data-uid="c1prcrkhk" style="color: rgb(234, 226, 214); font-family: Barlow, system-ui, -apple-system, sans-serif; background: rgb(18, 18, 16); min-height: 100%;"><Header5 /><section data-dc-tpl="816" data-screen-label="Late night hero" style="position: relative; min-height: clamp(520px, 82vh, 880px); display: grid; align-items: end; overflow: hidden; background: rgb(5, 5, 4);">
  <img data-dc-tpl="817" decoding="async" fetchpriority="high" src="/images/24e322da4fd1060e.jpg" alt="The bar after midnight" referrerpolicy="no-referrer" style="position: absolute; inset: 0px; width: 100%; height: 100%; object-fit: cover; filter: saturate(1.1) brightness(0.8);">
  <div data-dc-tpl="818" aria-hidden="true" style="position: absolute; inset: 0px; background: linear-gradient(rgba(5, 5, 4, 0.5), rgba(5, 5, 4, 0.15) 40%, rgba(5, 5, 4, 0.95) 85%);"></div>
  <div data-dc-tpl="819" style="position: relative; width: 100%; max-width: 1180px; margin: 0px auto; padding: 120px clamp(18px, 4.6vw, 48px) clamp(32px, 6vh, 64px); display: flex; flex-direction: column; align-items: flex-start;">
    <div data-dc-tpl="820" class="st-openpill" hidden style="display: inline-flex; align-items: center; gap: 8px; padding: 7px 12px; border-radius: 999px; background: rgba(28, 27, 24, 0.78); border: 1px solid rgba(185, 156, 102, 0.32); font-size: 12px; color: rgba(234, 226, 214, 0.9);"><span data-dc-tpl="821" class="st-openpill-dot" style="width: 7px; height: 7px; border-radius: 50%; background: rgb(56, 176, 73);"></span><span data-dc-tpl="822"><span class="sc-interp">Open now, until 12am</span></span></div>
    <div data-dc-tpl="823" style="font-family: &quot;Barlow Condensed&quot;, sans-serif; font-weight: 600; font-size: 13px; letter-spacing: 0.16em; text-transform: uppercase; color: rgb(214, 188, 133); margin-top: 14px;">Germantown, MD · Open to 1 AM</div>
    <h1 data-dc-tpl="824" style="color: rgb(246, 239, 228); font-family: &quot;Archivo Black&quot;, sans-serif; font-size: clamp(2.75rem, 6.4vw, 6.5rem); line-height: 0.94; letter-spacing: -0.015em; margin: 6px 0px 0px; text-transform: uppercase; text-wrap: balance; max-width: 15ch;">Still Open. <span data-dc-tpl="825" style="color: rgb(191, 30, 46);">Still Cooking.</span></h1>
    <div data-dc-tpl="826" data-m-first="" data-m-3="" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 12px; margin-top: 22px; max-width: 900px; width: 100%; box-sizing: border-box;">
      <div data-dc-tpl="828" style="background: rgba(13, 13, 11, 0.72); border: 1px solid rgba(185, 156, 102, 0.3); border-radius: 14px; padding: 14px 16px; backdrop-filter: blur(8px);"><div data-dc-tpl="829" style="font-family: &quot;Barlow Condensed&quot;, sans-serif; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(214, 188, 133);"><span class="sc-interp">Sun to Wed</span></div><div data-dc-tpl="830" style="font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 26px; color: rgb(234, 226, 214); line-height: 1; margin-top: 6px;"><span class="sc-interp">10pm</span></div><div data-dc-tpl="831" style="font-size: 12px; color: rgba(234, 226, 214, 0.75); margin-top: 4px;"><span class="sc-interp">Kitchen and bar</span></div></div><div data-dc-tpl="828" style="background: rgba(13, 13, 11, 0.72); border: 1px solid rgba(185, 156, 102, 0.3); border-radius: 14px; padding: 14px 16px; backdrop-filter: blur(8px);"><div data-dc-tpl="829" style="font-family: &quot;Barlow Condensed&quot;, sans-serif; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(214, 188, 133);"><span class="sc-interp">Thursday</span></div><div data-dc-tpl="830" style="font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 26px; color: rgb(234, 226, 214); line-height: 1; margin-top: 6px;"><span class="sc-interp">12am</span></div><div data-dc-tpl="831" style="font-size: 12px; color: rgba(234, 226, 214, 0.75); margin-top: 4px;"><span class="sc-interp">Karaoke 7:30 to midnight</span></div></div><div data-dc-tpl="828" style="background: rgba(13, 13, 11, 0.72); border: 1px solid rgba(185, 156, 102, 0.3); border-radius: 14px; padding: 14px 16px; backdrop-filter: blur(8px);"><div data-dc-tpl="829" style="font-family: &quot;Barlow Condensed&quot;, sans-serif; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(214, 188, 133);"><span class="sc-interp">Fri &amp; Sat</span></div><div data-dc-tpl="830" style="font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 26px; color: rgb(56, 176, 73); line-height: 1; margin-top: 6px;"><span class="sc-interp">1am</span></div><div data-dc-tpl="831" style="font-size: 12px; color: rgba(234, 226, 214, 0.75); margin-top: 4px;"><span class="sc-interp">Fri 3 PM to 1 AM · Sat 11 AM to 1 AM</span></div></div>
    </div>
  </div></section><section data-dc-tpl="832" data-screen-label="Late menu rail" style="background: rgb(18, 18, 16); padding: clamp(36px, 6vw, 72px) 0px clamp(20px, 3vw, 32px);">
  <div data-dc-tpl="833" style="max-width: 1180px; margin: 0px auto; padding: 0px clamp(18px, 4.6vw, 48px);">
    <div data-dc-tpl="834" style="display: flex; align-items: center; gap: 10px; font-family: &quot;Barlow Condensed&quot;, sans-serif; font-weight: 600; font-size: 14px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(214, 188, 133);"><span data-dc-tpl="835" style="width: 26px; height: 1px; background: rgba(185, 156, 102, 0.6);"></span>After 11</div>
    <h2 data-dc-tpl="836" style="color: rgb(246, 239, 228); font-family: &quot;Archivo Black&quot;, sans-serif; font-size: clamp(28px, 5.2vw, 52px); line-height: 1.02; margin: 10px 0px 0px; max-width: 18ch; text-transform: uppercase; text-wrap: balance;">It’s 11:30 and Everything Else Is Closed</h2>
  </div>
  <div data-dc-tpl="837" style="max-width: 1180px; margin: clamp(28px, 4vw, 44px) auto 0px; padding: 0px clamp(18px, 4.6vw, 48px); display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; flex-wrap: wrap;">
    <div data-dc-tpl="838"><div data-dc-tpl="839" style="display: flex; align-items: center; gap: 10px; font-family: &quot;Barlow Condensed&quot;, sans-serif; font-weight: 600; font-size: 14px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(214, 188, 133);"><span data-dc-tpl="840" style="width: 26px; height: 1px; background: rgba(185, 156, 102, 0.6);"></span>After 10pm</div><h3 data-dc-tpl="841" style="color: rgb(246, 239, 228); font-family: &quot;Archivo Black&quot;, sans-serif; font-size: clamp(22px, 3.4vw, 32px); line-height: 1.05; margin: 8px 0px 0px; text-transform: uppercase;">What to order late</h3></div>
    <p data-dc-tpl="842" style="font-size: 14px; line-height: 1.6; color: rgba(234, 226, 214, 0.78); max-width: 40ch; margin: 0px;">A shorter list, built for the bar. Tacos by the pair, birria ramen, and everything fried.</p>
  </div>
  <div data-dc-tpl="843" data-rail="" style="display: flex; gap: 12px; overflow-x: auto; scrollbar-width: none; scroll-snap-type: x; padding: 20px clamp(18px, 4.6vw, 48px) 10px; max-width: 1180px; margin: 0px auto; box-sizing: border-box;">
    
      <div data-dc-tpl="845" style="flex: 0 0 auto; width: min(260px, 72vw); scroll-snap-align: start; background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 16px; overflow: hidden;"><div data-dc-tpl="846" style="aspect-ratio: 4 / 3; background: url(&quot;/images/dishes/tacos-perrones.jpg&quot;) center center / cover no-repeat rgb(35, 33, 28);"></div><div data-dc-tpl="847" style="padding: 14px 16px 16px;"><div data-dc-tpl="848" style="display: flex; justify-content: space-between; gap: 8px; align-items: baseline;"><span data-dc-tpl="849" style="font-weight: 700; font-size: 15px; color: rgb(246, 239, 228);"><span class="sc-interp">Full menu until close</span></span></div><div data-dc-tpl="850" style="font-size: 13px; line-height: 1.5; color: rgba(234, 226, 214, 0.8); margin-top: 4px;"><span class="sc-interp">If you're seated before we lock the door, you eat.</span></div></div></div>
    
      <div data-dc-tpl="845" style="flex: 0 0 auto; width: min(260px, 72vw); scroll-snap-align: start; background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 16px; overflow: hidden;"><div data-dc-tpl="846" style="aspect-ratio: 4 / 3; background: url(&quot;/images/dishes/quesabirrias-card.jpg&quot;) center center / cover no-repeat rgb(35, 33, 28);"></div><div data-dc-tpl="847" style="padding: 14px 16px 16px;"><div data-dc-tpl="848" style="display: flex; justify-content: space-between; gap: 8px; align-items: baseline;"><span data-dc-tpl="849" style="font-weight: 700; font-size: 15px; color: rgb(246, 239, 228);"><span class="sc-interp">Quesabirria Tacos</span></span></div><div data-dc-tpl="850" style="font-size: 13px; line-height: 1.5; color: rgba(234, 226, 214, 0.8); margin-top: 4px;"><span class="sc-interp">Braised 12+ hours, consommé on the side</span></div></div></div>
    
      <div data-dc-tpl="845" style="flex: 0 0 auto; width: min(260px, 72vw); scroll-snap-align: start; background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 16px; overflow: hidden;"><div data-dc-tpl="846" style="aspect-ratio: 4 / 3; background: url(&quot;/images/dishes/tacos-cinco-mamalones.jpg&quot;) center center / cover no-repeat rgb(35, 33, 28);"></div><div data-dc-tpl="847" style="padding: 14px 16px 16px;"><div data-dc-tpl="848" style="display: flex; justify-content: space-between; gap: 8px; align-items: baseline;"><span data-dc-tpl="849" style="font-weight: 700; font-size: 15px; color: rgb(246, 239, 228);"><span class="sc-interp">Cinco Mamalones</span></span></div><div data-dc-tpl="850" style="font-size: 13px; line-height: 1.5; color: rgba(234, 226, 214, 0.8); margin-top: 4px;"><span class="sc-interp">Five tacos, five fillings</span></div></div></div>
    
  </div></section><section data-dc-tpl="851" data-screen-label="What happens late" style="background: linear-gradient(rgba(70, 8, 14, 0.72), rgba(40, 4, 8, 0.88)), url(/images/ecf6382a259b5884.webp) center center / cover no-repeat; border-top: 1px solid rgba(191, 30, 46, 0.3); padding: clamp(44px, 7vw, 88px) 0px;">
  <div data-dc-tpl="852" style="max-width: 1180px; margin: 0px auto; padding: 0px clamp(18px, 4.6vw, 48px);">
    <div data-dc-tpl="853" style="display: flex; align-items: center; gap: 10px; font-family: &quot;Barlow Condensed&quot;, sans-serif; font-weight: 600; font-size: 14px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(214, 188, 133);"><span data-dc-tpl="854" style="width: 26px; height: 1px; background: rgba(185, 156, 102, 0.6);"></span>Friday and Saturday</div>
    <h2 data-dc-tpl="855" style="color: rgb(246, 239, 228); font-family: &quot;Archivo Black&quot;, sans-serif; font-size: clamp(26px, 4.6vw, 44px); line-height: 1.02; margin: 10px 0px 0px; max-width: 16ch; text-transform: uppercase; text-wrap: balance;">The Cantina Wakes Up</h2>
    <p style="font-size: 14px; line-height: 1.7; color: rgba(234, 226, 214, 0.8); margin: 12px 0px 0px; max-width: 58ch;">Every NFL game is on, every day we are open in season, plus college football on Saturday. <a href="/game-day" style="color: rgb(214, 188, 133); font-weight: 700;">Game day at Senor Tequila's</a>.</p>
  </div>
  <div data-dc-tpl="856" data-m-rail="" style="max-width: 1180px; margin: clamp(22px, 3vw, 32px) auto 0px; padding: 0px clamp(18px, 4.6vw, 48px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 14px;">
    
      <div data-dc-tpl="858" style="position: relative; min-height: 300px; border-radius: 18px; overflow: hidden; border: 1px solid rgba(185, 156, 102, 0.3); background: url(/images/3468c5be0b3897f2.jpg) center center / cover no-repeat rgb(28, 27, 24); display: flex; flex-direction: column; justify-content: flex-end; padding: 22px;"><span data-dc-tpl="859" style="position: absolute; inset: 0px; background: linear-gradient(rgba(18, 18, 16, 0.05), rgba(18, 18, 16, 0.94) 70%);"></span><div data-dc-tpl="860" style="position: relative;"><div data-dc-tpl="861" style="font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 30px; color: rgb(214, 188, 133); line-height: 1;"><span class="sc-interp">Thu</span></div><div data-dc-tpl="862" style="font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 20px; text-transform: uppercase; line-height: 1.05; margin-top: 6px; color: rgb(246, 239, 228);"><span class="sc-interp">Karaoke Thursdays</span></div><div data-dc-tpl="863" style="font-size: 14px; line-height: 1.55; color: rgba(234, 226, 214, 0.85); margin-top: 6px;"><span class="sc-interp">Karaoke in the bar area, 7:30 to midnight, hosted by DJ Willy. NFL on.</span></div></div></div>
    
      <div data-dc-tpl="858" style="position: relative; min-height: 300px; border-radius: 18px; overflow: hidden; border: 1px solid rgba(185, 156, 102, 0.3); background: url(/images/d8219db4b8a2f6cf.jpg) center center / cover no-repeat rgb(28, 27, 24); display: flex; flex-direction: column; justify-content: flex-end; padding: 22px;"><span data-dc-tpl="859" style="position: absolute; inset: 0px; background: linear-gradient(rgba(18, 18, 16, 0.05), rgba(18, 18, 16, 0.94) 70%);"></span><div data-dc-tpl="860" style="position: relative;"><div data-dc-tpl="861" style="font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 30px; color: rgb(214, 188, 133); line-height: 1;"><span class="sc-interp">Fri</span></div><div data-dc-tpl="862" style="font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 20px; text-transform: uppercase; line-height: 1.05; margin-top: 6px; color: rgb(246, 239, 228);"><span class="sc-interp">The Cantina Wakes Up</span></div><div data-dc-tpl="863" style="font-size: 14px; line-height: 1.55; color: rgba(234, 226, 214, 0.85); margin-top: 6px;"><span class="sc-interp">Live DJ in the bar area, 9 PM to 1 AM. 21 and over in the bar area after 9.</span></div></div></div>
    
      <div data-dc-tpl="858" style="position: relative; min-height: 300px; border-radius: 18px; overflow: hidden; border: 1px solid rgba(185, 156, 102, 0.3); background: url(&quot;/images/df43e9ee488c58d3.jpg&quot;) center center / cover no-repeat rgb(28, 27, 24); display: flex; flex-direction: column; justify-content: flex-end; padding: 22px;"><span data-dc-tpl="859" style="position: absolute; inset: 0px; background: linear-gradient(rgba(18, 18, 16, 0.05), rgba(18, 18, 16, 0.94) 70%);"></span><div data-dc-tpl="860" style="position: relative;"><div data-dc-tpl="861" style="font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 30px; color: rgb(214, 188, 133); line-height: 1;"><span class="sc-interp">Sat</span></div><div data-dc-tpl="862" style="font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 20px; text-transform: uppercase; line-height: 1.05; margin-top: 6px; color: rgb(246, 239, 228);"><span class="sc-interp">Open Until 1</span></div><div data-dc-tpl="863" style="font-size: 14px; line-height: 1.55; color: rgba(234, 226, 214, 0.85); margin-top: 6px;"><span class="sc-interp">Live DJ in the bar area, 9 PM to 1 AM. College football on. 21 and over in the bar area after 9.</span></div></div></div>
    
  </div></section><section data-dc-tpl="864" data-screen-label="Late CTA" style="background: rgb(20, 18, 16); border-top: 1px solid rgba(185, 156, 102, 0.2); padding: clamp(36px, 6vw, 64px) 0px;">
  <div data-dc-tpl="865" style="max-width: 1180px; margin: 0px auto; padding: 0px clamp(18px, 4.6vw, 48px); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 18px;">
    <div data-dc-tpl="866"><div data-dc-tpl="867" style="font-family: &quot;Archivo Black&quot;, sans-serif; font-size: clamp(24px, 3.4vw, 36px); text-transform: uppercase; line-height: 1.05; color: rgb(246, 239, 228);">Friday and Saturday until 1 AM. Thursday until midnight.</div><div data-dc-tpl="868" style="font-size: 14px; color: rgba(234, 226, 214, 0.8); margin-top: 6px;">Full menu until close. Last call for drinks is 15 minutes before closing. Fridays and Saturdays after 9, the bar area is 21 and over; the dining rooms stay all ages.</div><div style="font-size: 14px; margin-top: 8px;"><a href="/happy-hour" style="color: rgb(185, 156, 102); font-weight: 700;">Happy hour runs 3 to 6, then the night starts →</a></div></div>
    <a data-dc-tpl="869" href="https://order.toasttab.com/online/senortequilastogo" target="_blank" class="scp1" style="border: 1.5px solid rgba(185, 156, 102, 0.75); color: rgb(234, 226, 214); font-weight: 700; font-size: 15px; padding: 15px 24px; border-radius: 12px; min-height: 52px; box-sizing: border-box; display: inline-flex; align-items: center;">Late-Night Takeout →</a>
  </div></section><Footer2 /></div></div>
</Base>
