      <img data-dc-tpl="640" decoding="async" fetchpriority="high" src="/images/20d856a9f66a9c4c.jpg" alt="The Big Mami margarita arriving at the table" referrerpolicy="no-referrer" style="position: absolute; inset: 0px; width: 100%; height: 100%; object-fit: cover;">
      <span data-dc-tpl="641" style="position: absolute; top: 14px; left: 14px; background: rgb(191, 30, 46); color: rgb(246, 239, 228); font-size: 10px; font-weight: 800; letter-spacing: 0.09em; text-transform: uppercase; padding: 5px 9px; border-radius: 999px;">The Big Mami · 54 oz</span>
