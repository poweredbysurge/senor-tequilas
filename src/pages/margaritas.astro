        <div data-dc-tpl="649" style="position: relative; border-radius: 18px; overflow: hidden; border: 1px solid rgb(42, 40, 32); background: rgb(28, 27, 24); padding: 24px; display: flex; flex-direction: column; gap: 10px; min-height: 220px;"><span data-dc-tpl="650" style="position: absolute; top: 0px; left: 0px; right: 0px; height: 5px; background: rgb(56, 176, 73);"></span><div data-dc-tpl="651" style="font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 26px; text-transform: uppercase; color: rgb(246, 239, 228); line-height: 1;"><span class="sc-interp">Jalapeño</span></div><div data-dc-tpl="652" style="font-family: &quot;Barlow Condensed&quot;, sans-serif; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(214, 188, 133);"><span class="sc-interp">Cooked in house</span></div><div data-dc-tpl="653" style="font-size: 14px; line-height: 1.6; color: rgba(234, 226, 214, 0.82);"><span class="sc-interp">Fresh jalapeño, bright and green, cut with lime.</span></div><div data-dc-tpl="654" style="margin-top: auto; font-size: 13px; color: rgb(56, 176, 73); font-weight: 700;"><span class="sc-interp">House pulp</span></div></div>
      
