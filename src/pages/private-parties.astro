---
import Base from '../layouts/Base.astro';
import Header6 from '../components/Header6.astro';
import Footer2 from '../components/Footer2.astro';
---
<Base title="Private Party Rooms & Event Venue | Señor Tequilas" description="Four private rooms and two patios for parties from 12 to 400, with the lights hung, the sound wired and the kitchen already here." canonical="https://senortequilas.com/private-parties" ogImage="/images/24e322da4fd1060e.jpg" route="/private-parties" extraTypes={["EventVenue"]}>
<div class="sc-host" data-sc-name="Concept 1 Pages" data-dc-tpl="120"><div data-dc-tpl="6" data-c1p-root="" data-uid="c1pp6r1t7" style="color: rgb(234, 226, 214); font-family: Barlow, system-ui, -apple-system, sans-serif; background: rgb(18, 18, 16); min-height: 100%;"><Header6 /><section data-dc-tpl="536" data-screen-label="Hub hero" style="position: relative; min-height: clamp(480px, 70vh, 780px); display: flex; align-items: center; overflow: hidden; background: rgb(10, 10, 9);">
  <img data-dc-tpl="537" loading="lazy" decoding="async" src="/images/24e322da4fd1060e.jpg" alt="The private room" referrerpolicy="no-referrer" style="position: absolute; inset: 0px; width: 100%; height: 100%; object-fit: cover;">
  <div data-dc-tpl="538" aria-hidden="true" style="position: absolute; inset: 0px; background: linear-gradient(90deg, rgba(18, 18, 16, 0.94) 0%, rgba(18, 18, 16, 0.75) 45%, rgba(18, 18, 16, 0.2) 100%);"></div>
  <div data-dc-tpl="539" style="position: relative; width: 100%; max-width: 1180px; margin: 0px auto; padding: 110px clamp(18px, 4.6vw, 48px) clamp(40px, 6vh, 72px);">
    <div data-dc-tpl="540" style="display: flex; align-items: center; gap: 10px; font-family: &quot;Barlow Condensed&quot;, sans-serif; font-weight: 600; font-size: 14px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(214, 188, 133);"><span data-dc-tpl="541" style="width: 26px; height: 1px; background: rgba(185, 156, 102, 0.6);"></span>Germantown, MD · Four Rooms, Two Patios</div>
    <h1 data-dc-tpl="542" style="color: rgb(246, 239, 228); font-family: &quot;Archivo Black&quot;, sans-serif; font-size: clamp(2.75rem, 6vw, 6.5rem); line-height: 0.94; letter-spacing: -0.015em; margin: 14px 0px 0px; text-transform: uppercase; text-wrap: balance; max-width: 16ch;">Private Rooms for <span data-dc-tpl="543" style="color: rgb(56, 176, 73);">12 to 400</span></h1>
    <p data-dc-tpl="544" style="font-size: clamp(15px, 1.6vw, 18px); line-height: 1.6; color: rgba(234, 226, 214, 0.88); max-width: 50ch; margin: 16px 0px 0px; text-wrap: pretty;">Most party venues hand you an empty room and a list of caterers to call. We hand you a room with the lights already hung, the sound already wired, and a kitchen that's been feeding Germantown since 2015.</p>
    <div data-dc-tpl="545" style="display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px;">
      <a data-dc-tpl="546" href="#types" class="scp2" style="display: inline-flex; align-items: center; justify-content: center; background: rgb(56, 176, 73); color: rgb(12, 18, 13); font-weight: 800; font-size: 15px; padding: 16px 22px; border-radius: 12px; min-height: 52px; box-sizing: border-box; box-shadow: rgba(56, 176, 73, 0.35) 0px 0px 30px;">Book a Tour</a>
      <a data-dc-tpl="547" href="tel:3015694574" class="scp1" style="display: inline-flex; align-items: center; justify-content: center; border: 1.5px solid rgba(185, 156, 102, 0.75); color: rgb(234, 226, 214); font-weight: 700; font-size: 15px; padding: 16px 22px; border-radius: 12px; min-height: 52px; box-sizing: border-box; background: rgba(18, 18, 16, 0.4);">Call the Events Team</a>
    </div>
  </div></section><section data-dc-tpl="548" id="types" data-screen-label="Party types" style="background: rgb(18, 18, 16); padding: clamp(40px, 7vw, 88px) 0px; scroll-margin-top: 70px;">
