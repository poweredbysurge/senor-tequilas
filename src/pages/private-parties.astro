          <span data-dc-tpl="560" style="position: relative; display: inline-flex; align-items: center; gap: 8px; margin-top: 14px; font-weight: 700; font-size: 14px; color: rgb(56, 176, 73);"><span class="sc-interp">See quinceañeras</span> →</span>
        </a>
      
        <a data-dc-tpl="555" href="/private-parties/weddings-receptions" class="scp3" style="position: relative; display: flex; flex-direction: column; justify-content: flex-end; min-height: clamp(320px, 40vh, 460px); padding: 24px; border-radius: 20px; overflow: hidden; border: 1px solid rgb(42, 40, 32); background: url(&quot;/images/site/celebration-cake.jpg&quot;) center center / cover no-repeat rgb(28, 27, 24); color: rgb(234, 226, 214);">
