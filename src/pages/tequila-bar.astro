---
import Base from '../layouts/Base.astro';
import Header5 from '../components/Header5.astro';
import Footer2 from '../components/Footer2.astro';
---
<Base title="It's in the Name for a Reason">
<div class="sc-host" data-sc-name="Concept 1 Pages" data-dc-tpl="138"><div data-dc-tpl="6" data-c1p-root="" data-uid="c1pfhkltv" style="color: rgb(234, 226, 214); font-family: Barlow, system-ui, -apple-system, sans-serif; background: rgb(18, 18, 16); min-height: 100%;"><Header5 /><section data-dc-tpl="678" data-screen-label="Tequila hero" style="position: relative; min-height: clamp(520px, 80vh, 860px); display: flex; align-items: flex-end; overflow: hidden; background: rgb(10, 10, 9);">
  <img data-dc-tpl="679" loading="lazy" decoding="async" src="/images/0fcbe6ef39392a93.jpg" alt="Backlit tequila and mezcal bottle wall" referrerpolicy="no-referrer" style="position: absolute; inset: 0px; width: 100%; height: 100%; object-fit: cover;">
  <div data-dc-tpl="680" aria-hidden="true" style="position: absolute; inset: 0px; background: linear-gradient(rgba(18, 18, 16, 0.4) 0%, rgba(18, 18, 16, 0.05) 40%, rgba(18, 18, 16, 0.92) 78%, rgb(18, 18, 16) 100%);"></div>
  <div data-dc-tpl="681" style="position: relative; width: 100%; max-width: 1180px; margin: 0px auto; padding: 120px clamp(18px, 4.6vw, 48px) clamp(32px, 6vh, 64px); text-align: center;">
    <div data-dc-tpl="682" style="font-family: &quot;Barlow Condensed&quot;, sans-serif; font-weight: 600; font-size: 14px; letter-spacing: 0.14em; text-transform: uppercase; color: rgb(214, 188, 133);">Germantown, MD · Tequila &amp; Mezcal</div>
    <h1 data-dc-tpl="683" style="color: rgb(246, 239, 228); font-family: &quot;Archivo Black&quot;, sans-serif; font-size: clamp(2.75rem, 6vw, 6.25rem); line-height: 0.94; letter-spacing: -0.015em; margin: 14px auto 0px; text-transform: uppercase; text-wrap: balance; max-width: 14ch;">It's in the Name <span data-dc-tpl="684" style="color: rgb(185, 156, 102);">for a Reason</span></h1>
    <p data-dc-tpl="685" style="font-size: clamp(15px, 1.6vw, 18px); line-height: 1.6; color: rgba(234, 226, 214, 0.88); max-width: 52ch; margin: 16px auto 0px; text-wrap: pretty;">A tequila and mezcal list built for people who want to taste the difference, not just order a shot.</p>
    <div data-dc-tpl="686" style="display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 24px;">
      <a data-dc-tpl="687" href="#shelf" class="scpc" style="display: inline-flex; align-items: center; justify-content: center; background: rgb(185, 156, 102); color: rgb(18, 18, 16); font-weight: 800; font-size: 15px; padding: 16px 22px; border-radius: 12px; min-height: 52px; box-sizing: border-box; box-shadow: rgba(185, 156, 102, 0.35) 0px 0px 30px;">Ask About a Flight</a>
      <a data-dc-tpl="688" href="https://tables.toasttab.com/restaurants/d94fa749-fbd5-4a66-90b6-d7755b8c3af3/findTime" target="_blank" class="scp1" style="display: inline-flex; align-items: center; justify-content: center; border: 1.5px solid rgba(185, 156, 102, 0.75); color: rgb(234, 226, 214); font-weight: 700; font-size: 15px; padding: 16px 22px; border-radius: 12px; min-height: 52px; box-sizing: border-box; background: rgba(18, 18, 16, 0.4);">Reserve a Table</a>
    </div>
  </div></section><section data-dc-tpl="689" id="shelf" data-screen-label="The shelf" style="background: rgb(18, 18, 16); padding: clamp(40px, 7vw, 88px) 0px; scroll-margin-top: 70px;">
  <div data-dc-tpl="690" style="max-width: 1180px; margin: 0px auto; padding: 0px clamp(18px, 4.6vw, 48px);">
    <div data-dc-tpl="691" style="display: flex; align-items: center; gap: 10px; font-family: &quot;Barlow Condensed&quot;, sans-serif; font-weight: 600; font-size: 14px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(214, 188, 133);"><span data-dc-tpl="692" style="width: 26px; height: 1px; background: rgba(185, 156, 102, 0.6);"></span>Four categories</div>
    <h2 data-dc-tpl="693" style="color: rgb(246, 239, 228); font-family: &quot;Archivo Black&quot;, sans-serif; font-size: clamp(24px, 4vw, 40px); line-height: 1.02; margin: 8px 0px 22px; text-transform: uppercase; text-wrap: balance;">Blanco, Reposado, Añejo, and What That Actually Means</h2>
    <div data-dc-tpl="694" data-rail="" style="display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; padding-bottom: 4px;">
      
        <button data-dc-tpl="696" style="flex: 0 0 auto; font-style: inherit; font-variant: inherit; font-weight: 700; font-stretch: inherit; font-size: 14px; line-height: inherit; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; font-language-override: inherit; padding: 11px 18px; border-radius: 999px; min-height: 44px; cursor: pointer; background: rgb(185, 156, 102); color: rgb(18, 18, 16); border: 1px solid rgb(185, 156, 102);"><span class="sc-interp">Blanco</span></button>
      
        <button data-dc-tpl="696" style="flex: 0 0 auto; font-style: inherit; font-variant: inherit; font-weight: 700; font-stretch: inherit; font-size: 14px; line-height: inherit; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; font-language-override: inherit; padding: 11px 18px; border-radius: 999px; min-height: 44px; cursor: pointer; background: transparent; color: rgb(234, 226, 214); border: 1px solid rgb(58, 56, 47);"><span class="sc-interp">Reposado</span></button>
      
        <button data-dc-tpl="696" style="flex: 0 0 auto; font-style: inherit; font-variant: inherit; font-weight: 700; font-stretch: inherit; font-size: 14px; line-height: inherit; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; font-language-override: inherit; padding: 11px 18px; border-radius: 999px; min-height: 44px; cursor: pointer; background: transparent; color: rgb(234, 226, 214); border: 1px solid rgb(58, 56, 47);"><span class="sc-interp">Añejo</span></button>
      
        <button data-dc-tpl="696" style="flex: 0 0 auto; font-style: inherit; font-variant: inherit; font-weight: 700; font-stretch: inherit; font-size: 14px; line-height: inherit; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; font-language-override: inherit; padding: 11px 18px; border-radius: 999px; min-height: 44px; cursor: pointer; background: transparent; color: rgb(234, 226, 214); border: 1px solid rgb(58, 56, 47);"><span class="sc-interp">Extra Añejo</span></button>
      
        <button data-dc-tpl="696" style="flex: 0 0 auto; font-style: inherit; font-variant: inherit; font-weight: 700; font-stretch: inherit; font-size: 14px; line-height: inherit; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; font-language-override: inherit; padding: 11px 18px; border-radius: 999px; min-height: 44px; cursor: pointer; background: transparent; color: rgb(234, 226, 214); border: 1px solid rgb(58, 56, 47);"><span class="sc-interp">Mezcal</span></button>
      
    </div>
    <div data-dc-tpl="697" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: clamp(20px, 4vw, 48px); margin-top: 24px; align-items: start;">
      <div data-dc-tpl="698">
        <h2 data-dc-tpl="699" style="color: rgb(246, 239, 228); font-family: &quot;Archivo Black&quot;, sans-serif; font-size: clamp(28px, 5vw, 44px); line-height: 1.02; margin: 0px; text-transform: uppercase;"><span class="sc-interp">Blanco</span></h2>
        <p data-dc-tpl="700" style="font-size: 15px; line-height: 1.7; color: rgba(234, 226, 214, 0.85); margin: 12px 0px 0px; max-width: 44ch; text-wrap: pretty;"><span class="sc-interp">Unaged or rested under two months. Agave at its loudest: pepper, citrus, cooked sweetness. What every margarita here is built on.</span></p>
        <div data-dc-tpl="701" style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 20px; max-width: 360px;"><div data-dc-tpl="702" style="background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 12px; padding: 14px;"><div data-dc-tpl="703" style="font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 22px; color: rgb(246, 239, 228); line-height: 1;"><span class="sc-interp">14</span></div><div data-dc-tpl="704" style="font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: rgb(214, 188, 133); margin-top: 5px;">bottles</div></div><div data-dc-tpl="705" style="background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 12px; padding: 14px;"><div data-dc-tpl="706" style="font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 22px; color: rgb(246, 239, 228); line-height: 1;"><span class="sc-interp">0 to 2 mo</span></div><div data-dc-tpl="707" style="font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: rgb(214, 188, 133); margin-top: 5px;">in barrel</div></div></div>
      </div>
      <div data-dc-tpl="708" style="display: grid; gap: 8px;">
        
          <div data-dc-tpl="710" style="display: grid; grid-template-columns: 1fr auto; gap: 4px 14px; background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 14px; padding: 14px 16px; align-items: baseline;"><div data-dc-tpl="711" style="font-weight: 700; font-size: 15px; color: rgb(246, 239, 228);"><span class="sc-interp">1800</span></div><div data-dc-tpl="712" style="font-size: 13px; color: rgba(234, 226, 214, 0.75); grid-column: 1 / -1;"><span class="sc-interp"></span></div></div>
        
          <div data-dc-tpl="710" style="display: grid; grid-template-columns: 1fr auto; gap: 4px 14px; background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 14px; padding: 14px 16px; align-items: baseline;"><div data-dc-tpl="711" style="font-weight: 700; font-size: 15px; color: rgb(246, 239, 228);"><span class="sc-interp">Avión</span></div><div data-dc-tpl="712" style="font-size: 13px; color: rgba(234, 226, 214, 0.75); grid-column: 1 / -1;"><span class="sc-interp"></span></div></div>
        
          <div data-dc-tpl="710" style="display: grid; grid-template-columns: 1fr auto; gap: 4px 14px; background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 14px; padding: 14px 16px; align-items: baseline;"><div data-dc-tpl="711" style="font-weight: 700; font-size: 15px; color: rgb(246, 239, 228);"><span class="sc-interp">Casamigos</span></div><div data-dc-tpl="712" style="font-size: 13px; color: rgba(234, 226, 214, 0.75); grid-column: 1 / -1;"><span class="sc-interp"></span></div></div>
        
          <div data-dc-tpl="710" style="display: grid; grid-template-columns: 1fr auto; gap: 4px 14px; background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 14px; padding: 14px 16px; align-items: baseline;"><div data-dc-tpl="711" style="font-weight: 700; font-size: 15px; color: rgb(246, 239, 228);"><span class="sc-interp">Casa Noble</span></div><div data-dc-tpl="712" style="font-size: 13px; color: rgba(234, 226, 214, 0.75); grid-column: 1 / -1;"><span class="sc-interp"></span></div></div>
        
          <div data-dc-tpl="710" style="display: grid; grid-template-columns: 1fr auto; gap: 4px 14px; background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 14px; padding: 14px 16px; align-items: baseline;"><div data-dc-tpl="711" style="font-weight: 700; font-size: 15px; color: rgb(246, 239, 228);"><span class="sc-interp">Clase Azul</span></div><div data-dc-tpl="712" style="font-size: 13px; color: rgba(234, 226, 214, 0.75); grid-column: 1 / -1;"><span class="sc-interp"></span></div></div>
        
          <div data-dc-tpl="710" style="display: grid; grid-template-columns: 1fr auto; gap: 4px 14px; background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 14px; padding: 14px 16px; align-items: baseline;"><div data-dc-tpl="711" style="font-weight: 700; font-size: 15px; color: rgb(246, 239, 228);"><span class="sc-interp">Don Julio</span></div><div data-dc-tpl="712" style="font-size: 13px; color: rgba(234, 226, 214, 0.75); grid-column: 1 / -1;"><span class="sc-interp"></span></div></div>
        
          <div data-dc-tpl="710" style="display: grid; grid-template-columns: 1fr auto; gap: 4px 14px; background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 14px; padding: 14px 16px; align-items: baseline;"><div data-dc-tpl="711" style="font-weight: 700; font-size: 15px; color: rgb(246, 239, 228);"><span class="sc-interp">El Jimador</span></div><div data-dc-tpl="712" style="font-size: 13px; color: rgba(234, 226, 214, 0.75); grid-column: 1 / -1;"><span class="sc-interp"></span></div></div>
        
          <div data-dc-tpl="710" style="display: grid; grid-template-columns: 1fr auto; gap: 4px 14px; background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 14px; padding: 14px 16px; align-items: baseline;"><div data-dc-tpl="711" style="font-weight: 700; font-size: 15px; color: rgb(246, 239, 228);"><span class="sc-interp">Espolón</span></div><div data-dc-tpl="712" style="font-size: 13px; color: rgba(234, 226, 214, 0.75); grid-column: 1 / -1;"><span class="sc-interp"></span></div></div>
        
          <div data-dc-tpl="710" style="display: grid; grid-template-columns: 1fr auto; gap: 4px 14px; background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 14px; padding: 14px 16px; align-items: baseline;"><div data-dc-tpl="711" style="font-weight: 700; font-size: 15px; color: rgb(246, 239, 228);"><span class="sc-interp">Herradura</span></div><div data-dc-tpl="712" style="font-size: 13px; color: rgba(234, 226, 214, 0.75); grid-column: 1 / -1;"><span class="sc-interp"></span></div></div>
        
          <div data-dc-tpl="710" style="display: grid; grid-template-columns: 1fr auto; gap: 4px 14px; background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 14px; padding: 14px 16px; align-items: baseline;"><div data-dc-tpl="711" style="font-weight: 700; font-size: 15px; color: rgb(246, 239, 228);"><span class="sc-interp">Hornitos</span></div><div data-dc-tpl="712" style="font-size: 13px; color: rgba(234, 226, 214, 0.75); grid-column: 1 / -1;"><span class="sc-interp"></span></div></div>
        
          <div data-dc-tpl="710" style="display: grid; grid-template-columns: 1fr auto; gap: 4px 14px; background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 14px; padding: 14px 16px; align-items: baseline;"><div data-dc-tpl="711" style="font-weight: 700; font-size: 15px; color: rgb(246, 239, 228);"><span class="sc-interp">Lobos 1707</span></div><div data-dc-tpl="712" style="font-size: 13px; color: rgba(234, 226, 214, 0.75); grid-column: 1 / -1;"><span class="sc-interp"></span></div></div>
        
          <div data-dc-tpl="710" style="display: grid; grid-template-columns: 1fr auto; gap: 4px 14px; background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 14px; padding: 14px 16px; align-items: baseline;"><div data-dc-tpl="711" style="font-weight: 700; font-size: 15px; color: rgb(246, 239, 228);"><span class="sc-interp">Milagro Select</span></div><div data-dc-tpl="712" style="font-size: 13px; color: rgba(234, 226, 214, 0.75); grid-column: 1 / -1;"><span class="sc-interp"></span></div></div>
        
          <div data-dc-tpl="710" style="display: grid; grid-template-columns: 1fr auto; gap: 4px 14px; background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 14px; padding: 14px 16px; align-items: baseline;"><div data-dc-tpl="711" style="font-weight: 700; font-size: 15px; color: rgb(246, 239, 228);"><span class="sc-interp">Patrón Silver</span></div><div data-dc-tpl="712" style="font-size: 13px; color: rgba(234, 226, 214, 0.75); grid-column: 1 / -1;"><span class="sc-interp"></span></div></div>
        
          <div data-dc-tpl="710" style="display: grid; grid-template-columns: 1fr auto; gap: 4px 14px; background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 14px; padding: 14px 16px; align-items: baseline;"><div data-dc-tpl="711" style="font-weight: 700; font-size: 15px; color: rgb(246, 239, 228);"><span class="sc-interp">1942 Alma Miel</span></div><div data-dc-tpl="712" style="font-size: 13px; color: rgba(234, 226, 214, 0.75); grid-column: 1 / -1;"><span class="sc-interp"></span></div></div>
        
      </div>
    </div>
  </div></section><section data-dc-tpl="713" data-screen-label="Flights" style="background: linear-gradient(rgba(60, 44, 18, 0.72), rgba(28, 20, 8, 0.9)), url(/images/86475be0134bfc90.png) center center / cover no-repeat; border-top: 1px solid rgba(185, 156, 102, 0.3); padding: clamp(44px, 7vw, 88px) 0px;">
  <div data-dc-tpl="714" style="max-width: 1180px; margin: 0px auto; padding: 0px clamp(18px, 4.6vw, 48px);">
    <div data-dc-tpl="715" style="display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap;">
      <div data-dc-tpl="716"><div data-dc-tpl="717" style="display: flex; align-items: center; gap: 10px; font-family: &quot;Barlow Condensed&quot;, sans-serif; font-weight: 600; font-size: 14px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(214, 188, 133);"><span data-dc-tpl="718" style="width: 26px; height: 1px; background: rgba(214, 188, 133, 0.7);"></span>Try three</div><h2 data-dc-tpl="719" style="color: rgb(246, 239, 228); font-family: &quot;Archivo Black&quot;, sans-serif; font-size: clamp(28px, 5.5vw, 46px); line-height: 1.02; margin: 8px 0px 0px; text-transform: uppercase;">Try Three</h2></div>
      <p data-dc-tpl="720" style="font-size: 14px; line-height: 1.6; color: rgba(234, 226, 214, 0.8); max-width: 40ch; margin: 0px;">Don't know where to start? Start here. The bartender picks unless you do.</p>
    </div>
    <div data-dc-tpl="721" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 12px; margin-top: 24px;">
      
        <div data-dc-tpl="723" style="background: rgba(18, 18, 16, 0.7); border: 1px solid rgba(185, 156, 102, 0.3); border-radius: 18px; padding: 22px; display: flex; flex-direction: column; gap: 8px;"><div data-dc-tpl="724" style="display: flex; justify-content: space-between; align-items: baseline; gap: 8px;"><div data-dc-tpl="725" style="font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 20px; text-transform: uppercase; color: rgb(246, 239, 228);"><span class="sc-interp">Los Ilegales</span></div></div><div data-dc-tpl="726" style="font-size: 14px; line-height: 1.55; color: rgba(234, 226, 214, 0.82);"><span class="sc-interp">Ilegal Mezcal Joven, Ilegal Reposado, Ilegal Añejo.</span></div></div>
      
        <div data-dc-tpl="723" style="background: rgba(18, 18, 16, 0.7); border: 1px solid rgba(185, 156, 102, 0.3); border-radius: 18px; padding: 22px; display: flex; flex-direction: column; gap: 8px;"><div data-dc-tpl="724" style="display: flex; justify-content: space-between; align-items: baseline; gap: 8px;"><div data-dc-tpl="725" style="font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 20px; text-transform: uppercase; color: rgb(246, 239, 228);"><span class="sc-interp">Con Billete</span></div></div><div data-dc-tpl="726" style="font-size: 14px; line-height: 1.55; color: rgba(234, 226, 214, 0.82);"><span class="sc-interp">Don Julio 70, 1942 Primavera, 1942 Añejo.</span></div></div>
      
        <div data-dc-tpl="723" style="background: rgba(18, 18, 16, 0.7); border: 1px solid rgba(185, 156, 102, 0.3); border-radius: 18px; padding: 22px; display: flex; flex-direction: column; gap: 8px;"><div data-dc-tpl="724" style="display: flex; justify-content: space-between; align-items: baseline; gap: 8px;"><div data-dc-tpl="725" style="font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 20px; text-transform: uppercase; color: rgb(246, 239, 228);"><span class="sc-interp">Primera Clase</span></div></div><div data-dc-tpl="726" style="font-size: 14px; line-height: 1.55; color: rgba(234, 226, 214, 0.82);"><span class="sc-interp">Clase Azul Blanco, Clase Azul Reposado, Clase Azul Gold.</span></div></div>
      
    </div>
  </div></section><section data-dc-tpl="727" data-screen-label="Bar photo + hours" style="background: rgb(20, 18, 16); border-top: 1px solid rgba(185, 156, 102, 0.2); padding: clamp(44px, 7vw, 88px) 0px;">
  <div data-dc-tpl="728" style="max-width: 1180px; margin: 0px auto; padding: 0px clamp(18px, 4.6vw, 48px); display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: clamp(24px, 4vw, 56px); align-items: center;">
    <div data-dc-tpl="729" style="position: relative; aspect-ratio: 16 / 10; border-radius: 18px; overflow: hidden; border: 1px solid rgba(185, 156, 102, 0.3); background: rgb(28, 27, 24);"><img data-dc-tpl="730" loading="lazy" decoding="async" src="/images/3468c5be0b3897f2.jpg" alt="" referrerpolicy="no-referrer" style="position: absolute; inset: 0px; width: 100%; height: 100%; object-fit: cover; opacity: 0.9;"></div>
    <div data-dc-tpl="731">
