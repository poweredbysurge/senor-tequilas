---
import Base from '../layouts/Base.astro';
import Header5 from '../components/Header5.astro';
import Footer2 from '../components/Footer2.astro';
import { TEQUILA } from '../data/tequila.js';
---
<Base title="Tequila Bar & Tastings | Señor Tequilas Germantown" description="A tequila and mezcal list built for tasting, not just shots. Flights, Clase Azul and the full menu until the kitchen closes." canonical="https://senortequilas.com/tequila-bar" ogImage="/images/0fcbe6ef39392a93.jpg" route="/tequila-bar">
<div class="sc-host" data-sc-name="Concept 1 Pages" data-dc-tpl="138"><div data-dc-tpl="6" data-c1p-root="" data-uid="c1pfhkltv" style="color: rgb(234, 226, 214); font-family: Barlow, system-ui, -apple-system, sans-serif; background: rgb(18, 18, 16); min-height: 100%;"><Header5 /><section data-dc-tpl="678" data-screen-label="Tequila hero" style="position: relative; min-height: clamp(520px, 80vh, 860px); display: flex; align-items: flex-end; overflow: hidden; background: rgb(10, 10, 9);">
  <img data-dc-tpl="679" decoding="async" fetchpriority="high" src="/images/0fcbe6ef39392a93.jpg" alt="Backlit tequila and mezcal bottle wall" referrerpolicy="no-referrer" style="position: absolute; inset: 0px; width: 100%; height: 100%; object-fit: cover;">
  <div data-dc-tpl="680" aria-hidden="true" style="position: absolute; inset: 0px; background: linear-gradient(rgba(18, 18, 16, 0.4) 0%, rgba(18, 18, 16, 0.05) 40%, rgba(18, 18, 16, 0.92) 78%, rgb(18, 18, 16) 100%);"></div>
  <div data-dc-tpl="681" style="position: relative; width: 100%; max-width: 1180px; margin: 0px auto; padding: 120px clamp(18px, 4.6vw, 48px) clamp(32px, 6vh, 64px); text-align: center;">
    <div data-dc-tpl="682" style="font-family: &quot;Barlow Condensed&quot;, sans-serif; font-weight: 600; font-size: 14px; letter-spacing: 0.14em; text-transform: uppercase; color: rgb(214, 188, 133);">Germantown, MD · Tequila &amp; Mezcal</div>
    <h1 data-dc-tpl="683" style="color: rgb(246, 239, 228); font-family: &quot;Archivo Black&quot;, sans-serif; font-size: clamp(2.75rem, 6vw, 6.25rem); line-height: 0.94; letter-spacing: -0.015em; margin: 14px auto 0px; text-transform: uppercase; text-wrap: balance; max-width: 14ch;">It's in the Name <span data-dc-tpl="684" style="color: rgb(185, 156, 102);">for a Reason</span></h1>
    <p data-dc-tpl="685" style="font-size: clamp(15px, 1.6vw, 18px); line-height: 1.6; color: rgba(234, 226, 214, 0.88); max-width: 52ch; margin: 16px auto 0px; text-wrap: pretty;">A tequila and mezcal list built for people who want to taste the difference, not just order a shot.</p>
    <div data-dc-tpl="686" style="display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 24px;">
      <a data-dc-tpl="687" href="#shelf" class="scpc" style="display: inline-flex; align-items: center; justify-content: center; background: rgb(185, 156, 102); color: rgb(18, 18, 16); font-weight: 800; font-size: 15px; padding: 16px 22px; border-radius: 12px; min-height: 52px; box-sizing: border-box; box-shadow: rgba(185, 156, 102, 0.35) 0px 0px 30px;">Ask About a Flight</a>
      <a data-dc-tpl="688" href="https://tables.toasttab.com/restaurants/d94fa749-fbd5-4a66-90b6-d7755b8c3af3/findTime" target="_blank" class="scp1" style="display: inline-flex; align-items: center; justify-content: center; border: 1.5px solid rgba(185, 156, 102, 0.75); color: rgb(234, 226, 214); font-weight: 700; font-size: 15px; padding: 16px 22px; border-radius: 12px; min-height: 52px; box-sizing: border-box; background: rgba(18, 18, 16, 0.4);">Reserve a Table</a>
    </div>
  </div></section><section data-dc-tpl="689" id="shelf" data-screen-label="The shelf" style="background: rgb(18, 18, 16); padding: clamp(40px, 7vw, 88px) 0px; scroll-margin-top: 70px;">
  <div data-dc-tpl="690" style="max-width: 1180px; margin: 0px auto; padding: 0px clamp(18px, 4.6vw, 48px);">
    <div data-dc-tpl="691" style="display: flex; align-items: center; gap: 10px; font-family: &quot;Barlow Condensed&quot;, sans-serif; font-weight: 600; font-size: 14px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(214, 188, 133);"><span data-dc-tpl="692" style="width: 26px; height: 1px; background: rgba(185, 156, 102, 0.6);"></span>Tequila and mezcal</div>
    <h2 data-dc-tpl="693" style="color: rgb(246, 239, 228); font-family: &quot;Archivo Black&quot;, sans-serif; font-size: clamp(24px, 4vw, 40px); line-height: 1.02; margin: 8px 0px 22px; text-transform: uppercase; text-wrap: balance;">Blanco, Reposado, Añejo, and What That Actually Means</h2>
    <div data-dc-tpl="694" data-rail="" role="tablist" aria-label="Tequila and mezcal categories" class="shelf-tabs" style="display: flex; flex-wrap: wrap; gap: 8px; padding-bottom: 4px;">
      {TEQUILA.map((c, i) => (
        <button data-dc-tpl="696" type="button" role="tab" class="shelf-tab" id={`shelf-tab-${c.id}`} aria-controls={`shelf-panel-${c.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} style="flex: 0 0 auto; font: inherit; font-weight: 700; font-size: 14px; padding: 11px 18px; border-radius: 999px; min-height: 44px; cursor: pointer;"><span class="sc-interp">{c.tab}</span></button>
      ))}
    </div>
    {TEQUILA.map((c, i) => (
      <div role="tabpanel" class="shelf-panel" id={`shelf-panel-${c.id}`} aria-labelledby={`shelf-tab-${c.id}`} tabindex="0" hidden={i !== 0}>
        <div data-dc-tpl="697" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 290px), 1fr)); gap: clamp(20px, 4vw, 48px); margin-top: 24px; align-items: start;">
          <div data-dc-tpl="698">
            <h3 data-dc-tpl="699" style="color: rgb(246, 239, 228); font-family: &quot;Archivo Black&quot;, sans-serif; font-size: clamp(28px, 5vw, 44px); line-height: 1.02; margin: 0px; text-transform: uppercase;"><span class="sc-interp">{c.tab}</span></h3>
            <p data-dc-tpl="700" style="font-size: 15px; line-height: 1.7; color: rgba(234, 226, 214, 0.85); margin: 12px 0px 0px; max-width: 44ch; text-wrap: pretty;"><span class="sc-interp">{c.description}</span></p>
            <div data-dc-tpl="701" style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 20px; max-width: 360px;">
              <div data-dc-tpl="702" style="background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 12px; padding: 14px;"><div data-dc-tpl="703" data-bottle-count style="font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 22px; color: rgb(246, 239, 228); line-height: 1;"><span class="sc-interp">{c.bottles.length}</span></div><div data-dc-tpl="704" style="font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: rgb(214, 188, 133); margin-top: 5px;">bottles</div></div>
              {c.age && <div data-dc-tpl="705" style="background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 12px; padding: 14px;"><div data-dc-tpl="706" style="font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 22px; color: rgb(246, 239, 228); line-height: 1;"><span class="sc-interp">{c.age}</span></div><div data-dc-tpl="707" style="font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: rgb(214, 188, 133); margin-top: 5px;">in barrel</div></div>}
            </div>
          </div>
          <ul data-dc-tpl="708" data-bottle-list style="display: grid; gap: 8px; list-style: none; margin: 0px; padding: 0px;">
            {c.bottles.map((b) => (
              <li data-dc-tpl="710" style="background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 14px; padding: 14px 16px; font-weight: 700; font-size: 15px; color: rgb(246, 239, 228);"><span class="sc-interp">{b}</span></li>
            ))}
          </ul>
        </div>
      </div>
    ))}
  </div></section><section data-dc-tpl="713" data-screen-label="Flights" style="background: linear-gradient(rgba(60, 44, 18, 0.72), rgba(28, 20, 8, 0.9)), url(/images/86475be0134bfc90.webp) center center / cover no-repeat; border-top: 1px solid rgba(185, 156, 102, 0.3); padding: clamp(44px, 7vw, 88px) 0px;">
  <div data-dc-tpl="714" style="max-width: 1180px; margin: 0px auto; padding: 0px clamp(18px, 4.6vw, 48px);">
    <div data-dc-tpl="715" style="display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap;">
      <div data-dc-tpl="716"><div data-dc-tpl="717" style="display: flex; align-items: center; gap: 10px; font-family: &quot;Barlow Condensed&quot;, sans-serif; font-weight: 600; font-size: 14px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(214, 188, 133);"><span data-dc-tpl="718" style="width: 26px; height: 1px; background: rgba(214, 188, 133, 0.7);"></span>Try three</div><h2 data-dc-tpl="719" style="color: rgb(246, 239, 228); font-family: &quot;Archivo Black&quot;, sans-serif; font-size: clamp(28px, 5.5vw, 46px); line-height: 1.02; margin: 8px 0px 0px; text-transform: uppercase;">Try Three</h2></div>
      <p data-dc-tpl="720" style="font-size: 14px; line-height: 1.6; color: rgba(234, 226, 214, 0.8); max-width: 40ch; margin: 0px;">Don't know where to start? Start here. The bartender picks unless you do.</p>
    </div>
    <div data-dc-tpl="721" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 12px; margin-top: 24px;">
      
        <div data-dc-tpl="723" style="background: rgba(18, 18, 16, 0.7); border: 1px solid rgba(185, 156, 102, 0.3); border-radius: 18px; padding: 22px; display: flex; flex-direction: column; gap: 8px;"><div data-dc-tpl="724" style="display: flex; justify-content: space-between; align-items: baseline; gap: 8px;"><div data-dc-tpl="725" style="font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 20px; text-transform: uppercase; color: rgb(246, 239, 228);"><span class="sc-interp">Los Ilegales</span></div></div><div data-dc-tpl="726" style="font-size: 14px; line-height: 1.55; color: rgba(234, 226, 214, 0.82);"><span class="sc-interp">Ilegal Mezcal Joven, Ilegal Reposado, Ilegal Añejo.</span></div></div>
      
        <div data-dc-tpl="723" style="background: rgba(18, 18, 16, 0.7); border: 1px solid rgba(185, 156, 102, 0.3); border-radius: 18px; padding: 22px; display: flex; flex-direction: column; gap: 8px;"><div data-dc-tpl="724" style="display: flex; justify-content: space-between; align-items: baseline; gap: 8px;"><div data-dc-tpl="725" style="font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 20px; text-transform: uppercase; color: rgb(246, 239, 228);"><span class="sc-interp">Con Billete</span></div></div><div data-dc-tpl="726" style="font-size: 14px; line-height: 1.55; color: rgba(234, 226, 214, 0.82);"><span class="sc-interp">Don Julio 70, 1942 Primavera, 1942 Añejo.</span></div></div>
      
        <div data-dc-tpl="723" style="background: rgba(18, 18, 16, 0.7); border: 1px solid rgba(185, 156, 102, 0.3); border-radius: 18px; padding: 22px; display: flex; flex-direction: column; gap: 8px;"><div data-dc-tpl="724" style="display: flex; justify-content: space-between; align-items: baseline; gap: 8px;"><div data-dc-tpl="725" style="font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 20px; text-transform: uppercase; color: rgb(246, 239, 228);"><span class="sc-interp">Primera Clase</span></div></div><div data-dc-tpl="726" style="font-size: 14px; line-height: 1.55; color: rgba(234, 226, 214, 0.82);"><span class="sc-interp">Clase Azul Blanco, Clase Azul Reposado, Clase Azul Gold.</span></div></div>
      
    </div>
  </div></section><section data-dc-tpl="727" data-screen-label="Bar photo + hours" style="background: rgb(20, 18, 16); border-top: 1px solid rgba(185, 156, 102, 0.2); padding: clamp(44px, 7vw, 88px) 0px;">
  <div data-dc-tpl="728" style="max-width: 1180px; margin: 0px auto; padding: 0px clamp(18px, 4.6vw, 48px); display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: clamp(24px, 4vw, 56px); align-items: center;">
    <div data-dc-tpl="729" style="position: relative; aspect-ratio: 16 / 10; border-radius: 18px; overflow: hidden; border: 1px solid rgba(185, 156, 102, 0.3); background: rgb(28, 27, 24);"><img data-dc-tpl="730" loading="lazy" decoding="async" src="/images/8cd7641ffaf36916.jpg" alt="The bar counter and its painted chairs, before service" referrerpolicy="no-referrer" style="position: absolute; inset: 0px; width: 100%; height: 100%; object-fit: cover; opacity: 0.9;"></div>
    <div data-dc-tpl="731">
      <h2 data-dc-tpl="732" style="color: rgb(246, 239, 228); font-family: &quot;Archivo Black&quot;, sans-serif; font-size: clamp(28px, 5.5vw, 46px); line-height: 1.02; margin: 0px; text-transform: uppercase; text-wrap: balance;">Beyond margaritas</h2>
      <p data-dc-tpl="733" style="font-size: 15px; line-height: 1.7; color: rgba(234, 226, 214, 0.85); margin: 14px 0px 20px; max-width: 46ch; text-wrap: pretty;">Sunday through Thursday the full menu runs until close. Friday and Saturday it runs until midnight, then the late night menu until 1 AM. The bar area seats 108: sixteen tables, two long tables, and twenty stools at the counter. Every NFL game and every big match go on in here. <a href="/game-day" style="color: rgb(185, 156, 102); font-weight: 700;">Game day</a>. <a href="/bar" style="color: rgb(185, 156, 102); font-weight: 700;">The bar</a>.</p>
      <div data-dc-tpl="734" style="display: grid; grid-template-columns: 1fr auto; row-gap: 8px; font-size: 14px; color: rgb(234, 226, 214); max-width: 360px;"><span data-dc-tpl="736" style="color: rgba(234, 226, 214, 0.75); font-weight: 600;"><span class="sc-interp">Mon to Wed</span></span><span data-dc-tpl="737" style="font-weight: 600; color: rgb(234, 226, 214);"><span class="sc-interp">3 PM to 10 PM</span></span><span data-dc-tpl="736" style="color: rgb(246, 239, 228); font-weight: 800;"><span class="sc-interp">Thu</span></span><span data-dc-tpl="737" style="font-weight: 800; color: rgb(56, 176, 73);"><span class="sc-interp">3 PM to midnight</span></span><span data-dc-tpl="736" style="color: rgba(234, 226, 214, 0.75); font-weight: 600;"><span class="sc-interp">Fri</span></span><span data-dc-tpl="737" style="font-weight: 600; color: rgb(234, 226, 214);"><span class="sc-interp">3 PM to 1 AM</span></span><span data-dc-tpl="736" style="color: rgba(234, 226, 214, 0.75); font-weight: 600;"><span class="sc-interp">Sat</span></span><span data-dc-tpl="737" style="font-weight: 600; color: rgb(234, 226, 214);"><span class="sc-interp">11 AM to 1 AM</span></span><span data-dc-tpl="736" style="color: rgba(234, 226, 214, 0.75); font-weight: 600;"><span class="sc-interp">Sun</span></span><span data-dc-tpl="737" style="font-weight: 600; color: rgb(234, 226, 214);"><span class="sc-interp">11 AM to 10 PM</span></span></div>
    </div>
  </div></section><Footer2 /></div></div>
<style is:global>
  .shelf-tab { background: transparent; color: rgb(234, 226, 214); border: 1px solid rgb(58, 56, 47); transition: background 0.15s, color 0.15s, border-color 0.15s; }
  .shelf-tab:hover { border-color: rgba(185, 156, 102, 0.75); }
  .shelf-tab[aria-selected="true"] { background: rgb(185, 156, 102); color: rgb(18, 18, 16); border-color: rgb(185, 156, 102); }
  .shelf-tab:focus-visible { outline: 2px solid rgb(214, 188, 133); outline-offset: 3px; }
  .shelf-panel:focus-visible { outline: 2px solid rgba(214, 188, 133, 0.6); outline-offset: 6px; border-radius: 12px; }
</style>
<script>
  // Category tabs on the shelf: WAI-ARIA tabs with automatic activation.
  // All five panels ship in the HTML; this only toggles which one shows.
  const list = document.querySelector(".shelf-tabs");
  if (list) {
    const tabs = Array.from(list.querySelectorAll("[role=tab]"));
    const select = (tab, focus) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute("aria-selected", on ? "true" : "false");
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute("aria-controls"));
        if (panel) panel.hidden = !on;
      }
      if (focus) tab.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(tab, false));
      tab.addEventListener("keydown", (e) => {
        const n = tabs.length;
        const to = { ArrowRight: (i + 1) % n, ArrowLeft: (i - 1 + n) % n, Home: 0, End: n - 1 }[e.key];
        if (to === undefined) return;
        e.preventDefault();
        select(tabs[to], true);
      });
    });
  }
</script>
</Base>
