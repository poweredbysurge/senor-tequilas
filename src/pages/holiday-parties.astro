<script is:inline>
  /* The Company field is named org, never company (the API's honeypot). On submit, in the capture
     phase so it runs before the site's form handler reads the fields, the company is put at the top
     of the message, then the textarea is put back as the guest typed it. */
  (function () {
    var form = document.querySelector('form[data-ap-company]');
    if (!form) return;
    form.addEventListener('submit', function () {
      var org = form.elements.org, msg = form.elements.details;
      if (!org || !msg || !org.value.trim()) return;
      var typed = msg.value;
      msg.value = 'Company: ' + org.value.trim() + (typed.trim() ? '\n\n' + typed : '');
      setTimeout(function () { msg.value = typed; }, 0);
    }, true);
  })();
</script>

