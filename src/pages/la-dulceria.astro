---
import Base from '../layouts/Base.astro';
import Header5 from '../components/Header5.astro';
import Footer2 from '../components/Footer2.astro';
---
<Base title="Mexican Desserts & Churros | La Dulcería Germantown" description="Churros, flan, tres leches and Volcan de Xocolate, made in house by our dessert chef. Germantown, MD." canonical="https://senortequilas.com/la-dulceria" ogImage="/images/dishes/churros-hero.jpg" route="/la-dulceria">
<div class="sc-host" data-sc-name="Concept 1 Pages" data-dc-tpl="90"><div data-dc-tpl="6" data-c1p-root="" data-uid="c1ph0ke4h" style="color: rgb(234, 226, 214); font-family: Barlow, system-ui, -apple-system, sans-serif; background: rgb(18, 18, 16); min-height: 100%;"><Header5 /><section data-dc-tpl="355" data-screen-label="Dulcería hero" style="position: relative; min-height: clamp(480px, 74vh, 820px); display: flex; align-items: flex-end; overflow: hidden; background: rgb(10, 10, 9);">
  <img data-dc-tpl="356" loading="lazy" decoding="async" src="/images/dishes/churros-hero.jpg" alt="Churros, fried to order" referrerpolicy="no-referrer" style="position: absolute; inset: 0px; width: 100%; height: 100%; object-fit: cover;">
  <div data-dc-tpl="357" aria-hidden="true" style="position: absolute; inset: 0px; background: linear-gradient(rgba(18, 18, 16, 0.45) 0%, rgba(18, 18, 16, 0.1) 35%, rgba(28, 20, 10, 0.9) 75%, rgb(18, 18, 16) 100%);"></div>
  
  <div data-dc-tpl="358" style="position: relative; width: 100%; max-width: 1180px; margin: 0px auto; padding: 120px clamp(18px, 4.6vw, 48px) clamp(32px, 6vh, 64px); display: flex; flex-direction: column; gap: 22px;">
    <div data-dc-tpl="359">
      <div data-dc-tpl="360" style="display: flex; align-items: center; gap: 10px; font-family: &quot;Barlow Condensed&quot;, sans-serif; font-weight: 600; font-size: 14px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(214, 188, 133);"><span data-dc-tpl="361" style="width: 26px; height: 1px; background: rgba(185, 156, 102, 0.6);"></span>Germantown, MD · Made by Our Dessert Chef</div>
      <h1 data-dc-tpl="362" style="color: rgb(246, 239, 228); font-family: &quot;Archivo Black&quot;, sans-serif; font-size: clamp(3rem, 9vw, 9rem); line-height: 0.92; letter-spacing: -0.015em; margin: 14px 0px 0px; text-transform: uppercase; text-wrap: balance;">La <span data-dc-tpl="363" style="color: rgb(185, 156, 102);">Dulcería</span></h1>
    </div>
    <div data-dc-tpl="364" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 18px 40px; align-items: start; border-top: 1px solid rgba(185, 156, 102, 0.25); padding-top: 22px;">
      <p data-dc-tpl="365" style="font-size: clamp(15px, 1.6vw, 18px); line-height: 1.6; color: rgba(234, 226, 214, 0.88); margin: 0px; max-width: 52ch; text-wrap: pretty;">Churros fried to order. Flan with real caramel. Tres leches soaked properly. Every dessert made here, by a chef whose whole job is the sweet end of the menu.</p>
      <div data-dc-tpl="366" style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; max-width: 520px;">
        <a data-dc-tpl="367" href="https://order.toasttab.com/online/senortequilastogo" target="_blank" class="scpc" style="text-align: center; background: rgb(185, 156, 102); color: rgb(18, 18, 16); font-weight: 800; font-size: 15px; padding: 16px 14px; border-radius: 12px; min-height: 52px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; box-shadow: rgba(185, 156, 102, 0.35) 0px 0px 30px;">Order Dessert</a>
        <a data-dc-tpl="368" href="https://tables.toasttab.com/restaurants/d94fa749-fbd5-4a66-90b6-d7755b8c3af3/findTime" target="_blank" class="scp1" style="text-align: center; border: 1.5px solid rgba(185, 156, 102, 0.75); color: rgb(234, 226, 214); font-weight: 700; font-size: 15px; padding: 16px 14px; border-radius: 12px; min-height: 52px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; background: rgba(18, 18, 16, 0.4);">Reserve</a>
      </div>
    </div>
  </div></section><section data-dc-tpl="369" data-screen-label="Don't skip this part" style="background: rgb(18, 18, 16); padding: clamp(40px, 7vw, 88px) 0px;">
  <div data-dc-tpl="370" style="max-width: 1180px; margin: 0px auto; padding: 0px clamp(18px, 4.6vw, 48px); display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: clamp(24px, 5vw, 72px); align-items: start;">
    <h2 data-dc-tpl="371" style="color: rgb(246, 239, 228); font-family: &quot;Archivo Black&quot;, sans-serif; font-size: clamp(28px, 4.6vw, 52px); line-height: 1.02; margin: 0px; text-transform: uppercase; text-wrap: balance;">Don’t Skip This Part</h2>
    <div data-dc-tpl="372" style="display: flex; flex-direction: column; gap: 14px; font-size: 16px; line-height: 1.75; color: rgba(234, 226, 214, 0.85); text-wrap: pretty;">
      <p data-dc-tpl="373" style="margin: 0px;">Most restaurants order dessert in frozen. We hired a pastry chef instead. Cajeta cooked down for hours, caramel that's actually caramelized, sponge that drinks up all three milks and stays standing.</p>
      <p data-dc-tpl="374" style="margin: 0px;">Order it with coffee, with a café de olla, or with an añejo. Or take a box home. Ask about custom cakes for any occasion.</p>
    </div>
  </div></section><section data-dc-tpl="375" data-screen-label="The case" style="background: linear-gradient(rgba(60, 44, 18, 0.72), rgba(28, 20, 8, 0.9)), url(/images/86475be0134bfc90.webp) center center / cover no-repeat; border-top: 1px solid rgba(185, 156, 102, 0.3); padding: clamp(44px, 7vw, 88px) 0px;">
  <div data-dc-tpl="376" style="max-width: 1180px; margin: 0px auto; padding: 0px clamp(18px, 4.6vw, 48px);">
    <div data-dc-tpl="377" style="display: flex; align-items: center; gap: 10px; font-family: &quot;Barlow Condensed&quot;, sans-serif; font-weight: 600; font-size: 14px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(214, 188, 133);"><span data-dc-tpl="378" style="width: 26px; height: 1px; background: rgba(214, 188, 133, 0.7);"></span>In the case tonight</div>
    <h2 data-dc-tpl="379" style="color: rgb(246, 239, 228); font-family: &quot;Archivo Black&quot;, sans-serif; font-size: clamp(28px, 5.5vw, 46px); line-height: 1.02; margin: 8px 0px 0px; text-transform: uppercase;">Don’t Skip This Part</h2>
    <div data-dc-tpl="380" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 14px; margin-top: 24px;">
      
        <div data-dc-tpl="382" class="scpd" style="display: flex; flex-direction: column; background: rgba(18, 18, 16, 0.7); border: 1px solid rgba(185, 156, 102, 0.3); border-radius: 18px; overflow: hidden;">
          <div data-dc-tpl="383" style="aspect-ratio: 5 / 4; background: url(/images/dishes/churros-card.jpg) center center / cover no-repeat rgb(35, 33, 28);"></div>
          <div data-dc-tpl="384" style="padding: 16px 18px 18px; display: flex; flex-direction: column; gap: 6px;"><div data-dc-tpl="385" style="display: flex; justify-content: space-between; gap: 8px; align-items: baseline;"><span data-dc-tpl="386" style="font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 17px; text-transform: uppercase; color: rgb(246, 239, 228);"><span class="sc-interp">Churros</span></span></div><div data-dc-tpl="387" style="font-size: 14px; line-height: 1.55; color: rgba(234, 226, 214, 0.82);"><span class="sc-interp">Crispy golden dough, cinnamon sugar, chocolate and caramel dipping sauce</span></div><div data-dc-tpl="388" style="font-family: &quot;Barlow Condensed&quot;, sans-serif; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: rgb(214, 188, 133); margin-top: 4px;"><span class="sc-interp">Pair · café de olla</span></div></div>
        </div>
      
        <div data-dc-tpl="382" class="scpd" style="display: flex; flex-direction: column; background: rgba(18, 18, 16, 0.7); border: 1px solid rgba(185, 156, 102, 0.3); border-radius: 18px; overflow: hidden;">
          <div data-dc-tpl="383" style="aspect-ratio: 5 / 4; background: url(/images/dishes/tres-leches.jpg) center center / cover no-repeat rgb(35, 33, 28);"></div>
          <div data-dc-tpl="384" style="padding: 16px 18px 18px; display: flex; flex-direction: column; gap: 6px;"><div data-dc-tpl="385" style="display: flex; justify-content: space-between; gap: 8px; align-items: baseline;"><span data-dc-tpl="386" style="font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 17px; text-transform: uppercase; color: rgb(246, 239, 228);"><span class="sc-interp">Tres Leches</span></span></div><div data-dc-tpl="387" style="font-size: 14px; line-height: 1.55; color: rgba(234, 226, 214, 0.82);"><span class="sc-interp">Vanilla bread, three milks, homemade whipped cream and cinnamon</span></div><div data-dc-tpl="388" style="font-family: &quot;Barlow Condensed&quot;, sans-serif; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: rgb(214, 188, 133); margin-top: 4px;"><span class="sc-interp">Pair · reposado</span></div></div>
        </div>
      
        <div data-dc-tpl="382" class="scpd" style="display: flex; flex-direction: column; background: rgba(18, 18, 16, 0.7); border: 1px solid rgba(185, 156, 102, 0.3); border-radius: 18px; overflow: hidden;">
          <div data-dc-tpl="383" style="aspect-ratio: 5 / 4; background: url(&quot;/images/dishes/flan.jpg&quot;) center center / cover no-repeat rgb(35, 33, 28);"></div>
          <div data-dc-tpl="384" style="padding: 16px 18px 18px; display: flex; flex-direction: column; gap: 6px;"><div data-dc-tpl="385" style="display: flex; justify-content: space-between; gap: 8px; align-items: baseline;"><span data-dc-tpl="386" style="font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 17px; text-transform: uppercase; color: rgb(246, 239, 228);"><span class="sc-interp">Flan</span></span></div><div data-dc-tpl="387" style="font-size: 14px; line-height: 1.55; color: rgba(234, 226, 214, 0.82);"><span class="sc-interp">Rich caramel custard, silky, golden caramel sauce</span></div><div data-dc-tpl="388" style="font-family: &quot;Barlow Condensed&quot;, sans-serif; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: rgb(214, 188, 133); margin-top: 4px;"><span class="sc-interp">Pair · espresso</span></div></div>
        </div>
      
        <div data-dc-tpl="382" class="scpd" style="display: flex; flex-direction: column; background: rgba(18, 18, 16, 0.7); border: 1px solid rgba(185, 156, 102, 0.3); border-radius: 18px; overflow: hidden;">
          <div data-dc-tpl="383" style="aspect-ratio: 5 / 4; background: url(&quot;/images/dishes/volcan-de-xocolate.jpg&quot;) center center / cover no-repeat rgb(35, 33, 28);"></div>
          <div data-dc-tpl="384" style="padding: 16px 18px 18px; display: flex; flex-direction: column; gap: 6px;"><div data-dc-tpl="385" style="display: flex; justify-content: space-between; gap: 8px; align-items: baseline;"><span data-dc-tpl="386" style="font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 17px; text-transform: uppercase; color: rgb(246, 239, 228);"><span class="sc-interp">Volcán de Xocolate</span></span></div><div data-dc-tpl="387" style="font-size: 14px; line-height: 1.55; color: rgba(234, 226, 214, 0.82);"><span class="sc-interp">Warm chocolate cake, melted center, vanilla ice cream, cajeta or leche condensada</span></div><div data-dc-tpl="388" style="font-family: &quot;Barlow Condensed&quot;, sans-serif; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: rgb(214, 188, 133); margin-top: 4px;"><span class="sc-interp">Pair · añejo</span></div></div>
        </div>
      
        <div data-dc-tpl="382" class="scpd" style="display: flex; flex-direction: column; background: rgba(18, 18, 16, 0.7); border: 1px solid rgba(185, 156, 102, 0.3); border-radius: 18px; overflow: hidden;">
          <div data-dc-tpl="383" style="aspect-ratio: 5 / 4; background: url(&quot;/images/dishes/fried-ice-cream.jpg&quot;) center center / cover no-repeat rgb(35, 33, 28);"></div>
          <div data-dc-tpl="384" style="padding: 16px 18px 18px; display: flex; flex-direction: column; gap: 6px;"><div data-dc-tpl="385" style="display: flex; justify-content: space-between; gap: 8px; align-items: baseline;"><span data-dc-tpl="386" style="font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 17px; text-transform: uppercase; color: rgb(246, 239, 228);"><span class="sc-interp">Fried Ice Cream</span></span></div><div data-dc-tpl="387" style="font-size: 14px; line-height: 1.55; color: rgba(234, 226, 214, 0.82);"><span class="sc-interp">Crispy golden shell, chocolate, whipped cream, strawberry, cinnamon sugar bowl</span></div><div data-dc-tpl="388" style="font-family: &quot;Barlow Condensed&quot;, sans-serif; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: rgb(214, 188, 133); margin-top: 4px;"><span class="sc-interp">Pair · café</span></div></div>
        </div>
      
        <div data-dc-tpl="382" class="scpd" style="display: flex; flex-direction: column; background: rgba(18, 18, 16, 0.7); border: 1px solid rgba(185, 156, 102, 0.3); border-radius: 18px; overflow: hidden;">
          <div data-dc-tpl="383" style="aspect-ratio: 5 / 4; background: url(&quot;/images/dishes/cheesecake-chimichanga.jpg&quot;) center center / cover no-repeat rgb(35, 33, 28);"></div>
          <div data-dc-tpl="384" style="padding: 16px 18px 18px; display: flex; flex-direction: column; gap: 6px;"><div data-dc-tpl="385" style="display: flex; justify-content: space-between; gap: 8px; align-items: baseline;"><span data-dc-tpl="386" style="font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 17px; text-transform: uppercase; color: rgb(246, 239, 228);"><span class="sc-interp">Cheesecake Chimichanga</span></span></div><div data-dc-tpl="387" style="font-size: 14px; line-height: 1.55; color: rgba(234, 226, 214, 0.82);"><span class="sc-interp">Golden-fried tortilla, cheesecake, cinnamon sugar, wildberry sauce</span></div><div data-dc-tpl="388" style="font-family: &quot;Barlow Condensed&quot;, sans-serif; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: rgb(214, 188, 133); margin-top: 4px;"><span class="sc-interp">Pair · malteada</span></div></div>
        </div>
      
    </div>
  </div></section><section data-dc-tpl="389" data-screen-label="Café + digestivos" style="background: rgb(20, 18, 16); border-top: 1px solid rgba(185, 156, 102, 0.2); padding: clamp(40px, 7vw, 80px) 0px;">
  <div data-dc-tpl="390" style="max-width: 1180px; margin: 0px auto; padding: 0px clamp(18px, 4.6vw, 48px); display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 16px;">
    <div data-dc-tpl="391" style="background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 18px; padding: 22px;">
      <div data-dc-tpl="392" style="font-family: &quot;Barlow Condensed&quot;, sans-serif; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(214, 188, 133);">Café</div>
      <div data-dc-tpl="393" style="font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 20px; text-transform: uppercase; color: rgb(246, 239, 228); margin-top: 6px;">Café de Olla &amp; Espresso</div>
      <p data-dc-tpl="394" style="font-size: 14px; line-height: 1.6; color: rgba(234, 226, 214, 0.82); margin: 8px 0px 0px;">Cinnamon and piloncillo, brewed in clay. Or a proper espresso, cortado, or Mexican hot chocolate.</p>
    </div>
    <div data-dc-tpl="395" style="background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 18px; padding: 22px;">
      <div data-dc-tpl="396" style="font-family: &quot;Barlow Condensed&quot;, sans-serif; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(214, 188, 133);">Digestivos</div>
      <div data-dc-tpl="397" style="font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 20px; text-transform: uppercase; color: rgb(246, 239, 228); margin-top: 6px;">Añejo, Extra Añejo, Mezcal</div>
      <p data-dc-tpl="398" style="font-size: 14px; line-height: 1.6; color: rgba(234, 226, 214, 0.82); margin: 8px 0px 0px;">A one-ounce pour to finish. Ask the bar for the aged list; the churros like an añejo.</p>
    </div>
    <div data-dc-tpl="399" style="background: rgb(28, 27, 24); border: 1px solid rgb(42, 40, 32); border-radius: 18px; padding: 22px;">
      <div data-dc-tpl="400" style="font-family: &quot;Barlow Condensed&quot;, sans-serif; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(214, 188, 133);">To go</div>
      <div data-dc-tpl="401" style="font-family: &quot;Archivo Black&quot;, sans-serif; font-size: 20px; text-transform: uppercase; color: rgb(246, 239, 228); margin-top: 6px;">Boxed by the Half Dozen</div>
      <p data-dc-tpl="402" style="font-size: 14px; line-height: 1.6; color: rgba(234, 226, 214, 0.82); margin: 8px 0px 14px;">Churros and tres leches travel well. Order with dinner or on their own.</p>
      <a data-dc-tpl="403" href="https://order.toasttab.com/online/senortequilastogo" target="_blank" style="display: inline-flex; align-items: center; min-height: 44px; font-weight: 700; font-size: 14px; color: rgb(185, 156, 102);">Order dessert to go →</a>
    </div>
  </div></section><section data-dc-tpl="404" data-screen-label="For parties" style="background: linear-gradient(rgba(70, 8, 14, 0.7), rgba(40, 4, 8, 0.86)), url(/images/ecf6382a259b5884.webp) center center / cover no-repeat; border-top: 1px solid rgba(191, 30, 46, 0.3); padding: clamp(44px, 7vw, 88px) 0px;">
  <div data-dc-tpl="405" style="max-width: 1180px; margin: 0px auto; padding: 0px clamp(18px, 4.6vw, 48px); display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: clamp(24px, 4vw, 56px); align-items: center;">
    <div data-dc-tpl="406">
      <div data-dc-tpl="407" style="display: flex; align-items: center; gap: 10px; font-family: &quot;Barlow Condensed&quot;, sans-serif; font-weight: 600; font-size: 14px; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(214, 188, 133);"><span data-dc-tpl="408" style="width: 26px; height: 1px; background: rgba(214, 188, 133, 0.7);"></span>For parties</div>
      <h2 data-dc-tpl="409" style="color: rgb(246, 239, 228); font-family: &quot;Archivo Black&quot;, sans-serif; font-size: clamp(28px, 5.5vw, 46px); line-height: 1.02; margin: 8px 0px 0px; text-transform: uppercase; text-wrap: balance;">For parties</h2>
      <p data-dc-tpl="410" style="font-size: 15px; line-height: 1.7; color: rgba(234, 226, 214, 0.85); margin: 14px 0px 20px; max-width: 48ch; text-wrap: pretty;">Churro towers, mini flans, tres leches by the tray for quinceañeras, weddings and birthdays. And yes, you can still bring your own cake.</p>
      <a data-dc-tpl="411" href="/private-parties" class="scp2" style="display: inline-flex; align-items: center; justify-content: center; background: rgb(56, 176, 73); color: rgb(12, 18, 13); font-weight: 800; font-size: 15px; padding: 15px 22px; border-radius: 12px; min-height: 52px; box-sizing: border-box; box-shadow: rgba(56, 176, 73, 0.32) 0px 0px 30px;">Plan a Private Event</a>
    </div>
    <div data-dc-tpl="412" style="position: relative; aspect-ratio: 4 / 3; border-radius: 18px; overflow: hidden; border: 1px solid rgba(185, 156, 102, 0.3); background: rgb(28, 27, 24);">
      <img data-dc-tpl="413" loading="lazy" decoding="async" src="/images/dishes/dessert-table.jpg" alt="A spread of desserts laid out on a table: churros, tres leches and a layered strawberry sundae" referrerpolicy="no-referrer" style="position: absolute; inset: 0px; width: 100%; height: 100%; object-fit: cover; opacity: 0.85;">
      
    </div>
  </div>
  <div data-dc-tpl="414" style="max-width: 1180px; margin: 0px auto; padding: 22px clamp(18px, 4.6vw, 48px) 0px;"><a data-dc-tpl="415" href="/private-parties" class="scp3" style="display: inline-flex; align-items: center; justify-content: center; border: 1.5px solid rgba(185, 156, 102, 0.6); color: rgb(234, 226, 214); font-weight: 700; font-size: 14px; padding: 13px 20px; border-radius: 12px; min-height: 48px; box-sizing: border-box;">See private events</a></div></section><Footer2 /></div></div>
</Base>
