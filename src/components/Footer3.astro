---
// Footer, concept layout under test on the homepage only. The rest of the site still uses
// Footer2. Same tokens, type and colours as the rest of the port; the agave is inline SVG
// line art authored here rather than a sourced image, so it carries no asset dependency.
//
// Every fact comes from src/data/business.json: the address, the phone number, the five
// distinct opening-hour rows and the four social profiles the business actually has.
---
<footer data-screen-label="Footer" style="position: relative; background: linear-gradient(rgba(10, 10, 9, 0.9), rgba(10, 10, 9, 0.95)), url(/images/site/texture-black.jpg) center center / cover no-repeat rgb(13, 13, 11); border-top: 1px solid rgba(185, 156, 102, 0.3); padding: clamp(44px, 7vw, 88px) 0px clamp(24px, 3vw, 36px); overflow: hidden;">
  <div style="position: relative; max-width: 1180px; margin: 0px auto; padding: 0px clamp(18px, 4.6vw, 48px);">

    <div data-agave aria-hidden="true"><svg viewBox="-160 -250 320 262" preserveAspectRatio="xMidYMax meet" fill="none" stroke="rgb(185, 156, 102)" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true" focusable="false" style="width: 100%; height: auto; display: block;"><g transform="translate(0,6)"><path d="M0 0 C-22 -40 -16 -87 0 -118 C16 -87 22 -40 0 0 Z" transform="rotate(-104)"/><path d="M0 -8 L0 -97" transform="rotate(-104)" opacity="0.5"/><path d="M0 0 C-30 -54 -22 -117 0 -158 C22 -117 30 -54 0 0 Z" transform="rotate(-88)"/><path d="M0 -8 L0 -130" transform="rotate(-88)" opacity="0.5"/><path d="M0 0 C-37 -67 -27 -145 0 -196 C27 -145 37 -67 0 0 Z" transform="rotate(-72)"/><path d="M0 -8 L0 -161" transform="rotate(-72)" opacity="0.5"/><path d="M0 0 C-32 -57 -23 -124 0 -168 C23 -124 32 -57 0 0 Z" transform="rotate(-57)"/><path d="M0 -8 L0 -138" transform="rotate(-57)" opacity="0.5"/><path d="M0 0 C-41 -73 -29 -158 0 -214 C29 -158 41 -73 0 0 Z" transform="rotate(-43)"/><path d="M0 -8 L0 -175" transform="rotate(-43)" opacity="0.5"/><path d="M0 0 C-35 -63 -25 -138 0 -186 C25 -138 35 -63 0 0 Z" transform="rotate(-29)"/><path d="M0 -8 L0 -153" transform="rotate(-29)" opacity="0.5"/><path d="M0 0 C-43 -78 -31 -169 0 -228 C31 -169 43 -78 0 0 Z" transform="rotate(-15)"/><path d="M0 -8 L0 -187" transform="rotate(-15)" opacity="0.5"/><path d="M0 0 C-38 -68 -27 -148 0 -200 C27 -148 38 -68 0 0 Z" transform="rotate(0)"/><path d="M0 -8 L0 -164" transform="rotate(0)" opacity="0.5"/><path d="M0 0 C-44 -79 -32 -172 0 -232 C32 -172 44 -79 0 0 Z" transform="rotate(15)"/><path d="M0 -8 L0 -190" transform="rotate(15)" opacity="0.5"/><path d="M0 0 C-36 -65 -26 -141 0 -190 C26 -141 36 -65 0 0 Z" transform="rotate(29)"/><path d="M0 -8 L0 -156" transform="rotate(29)" opacity="0.5"/><path d="M0 0 C-41 -73 -30 -160 0 -216 C30 -160 41 -73 0 0 Z" transform="rotate(43)"/><path d="M0 -8 L0 -177" transform="rotate(43)" opacity="0.5"/><path d="M0 0 C-33 -58 -24 -127 0 -172 C24 -127 33 -58 0 0 Z" transform="rotate(57)"/><path d="M0 -8 L0 -141" transform="rotate(57)" opacity="0.5"/><path d="M0 0 C-38 -67 -27 -147 0 -198 C27 -147 38 -67 0 0 Z" transform="rotate(72)"/><path d="M0 -8 L0 -162" transform="rotate(72)" opacity="0.5"/><path d="M0 0 C-29 -52 -21 -112 0 -152 C21 -112 29 -52 0 0 Z" transform="rotate(88)"/><path d="M0 -8 L0 -125" transform="rotate(88)" opacity="0.5"/><path d="M0 0 C-23 -41 -17 -90 0 -122 C17 -90 23 -41 0 0 Z" transform="rotate(104)"/><path d="M0 -8 L0 -100" transform="rotate(104)" opacity="0.5"/></g></svg></div>

    <div style="position: relative; text-align: center;">
      <div style="font-family: 'Barlow Condensed', sans-serif; font-weight: 600; font-size: 14px; letter-spacing: 0.22em; text-transform: uppercase; color: rgb(214, 188, 133);">Señor Tequila&#39;s</div>
      <h2 style="font-family: 'Archivo Black', sans-serif; font-size: clamp(34px, 7vw, 76px); line-height: 0.98; letter-spacing: -0.01em; margin: 10px 0px 0px; text-transform: uppercase; color: rgb(246, 239, 228);">From Mexico,<br><span style="color: rgb(185, 156, 102);">With Love.</span></h2>
      <div style="font-family: 'Barlow Condensed', sans-serif; font-weight: 600; font-size: clamp(13px, 1.5vw, 16px); letter-spacing: 0.18em; text-transform: uppercase; color: rgba(234, 226, 214, 0.82); margin-top: 14px;">Folklore &nbsp;·&nbsp; Kitchen &nbsp;·&nbsp; Cantina</div>
      <div style="display: flex; flex-wrap: wrap; gap: 14px; justify-content: center; margin-top: 26px;">
        <a href="https://order.toasttab.com/online/senortequilastogo" target="_blank" rel="noopener" style="display: inline-flex; align-items: center; justify-content: center; background: rgb(56, 176, 73); color: rgb(12, 18, 13); font-weight: 800; font-size: 15px; padding: 16px 40px; border-radius: 12px; min-height: 56px; box-sizing: border-box; box-shadow: rgba(56, 176, 73, 0.32) 0px 0px 30px;">Order Online</a>
        <a href="https://tables.toasttab.com/restaurants/d94fa749-fbd5-4a66-90b6-d7755b8c3af3/findTime" target="_blank" rel="noopener" style="display: inline-flex; align-items: center; justify-content: center; border: 1.5px solid rgba(185, 156, 102, 0.75); color: rgb(246, 239, 228); font-weight: 700; font-size: 15px; padding: 16px 40px; border-radius: 12px; min-height: 56px; box-sizing: border-box; background: rgba(13, 13, 11, 0.4);">Reserve a Table</a>
      </div>
    </div>

    <nav aria-label="Footer" style="position: relative; display: flex; flex-wrap: wrap; justify-content: center; gap: 14px clamp(18px, 3vw, 40px); margin-top: clamp(30px, 4vw, 48px);"><a href="/our-story" style="color: rgba(234, 226, 214, 0.88); font-size: 15px;">Our Story</a><a href="/menu" style="color: rgba(234, 226, 214, 0.88); font-size: 15px;">Menu</a><a href="/takeout-delivery" style="color: rgba(234, 226, 214, 0.88); font-size: 15px;">Takeout</a><a href="/taco-tuesday" style="color: rgba(234, 226, 214, 0.88); font-size: 15px;">Tacos</a><a href="/catering" style="color: rgba(234, 226, 214, 0.88); font-size: 15px;">Catering</a><a href="/private-parties" style="color: rgba(234, 226, 214, 0.88); font-size: 15px;">Private Events</a><a href="/happy-hour" style="color: rgba(234, 226, 214, 0.88); font-size: 15px;">Happy Hour</a><a href="/game-day" style="color: rgba(234, 226, 214, 0.88); font-size: 15px;">Game Day</a><a href="/contact" style="color: rgba(234, 226, 214, 0.88); font-size: 15px;">Contact</a></nav>

    <div data-footer-info style="border-top: 1px solid rgba(185, 156, 102, 0.28); margin-top: clamp(22px, 3vw, 34px); padding-top: clamp(22px, 3vw, 34px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 26px; align-items: start;">

      <div style="display: flex; gap: 14px; align-items: flex-start;">
        <span style="flex: 0 0 auto; color: rgb(214, 188, 133); margin-top: 1px;"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11z"/><circle cx="12" cy="10" r="2.6"/></svg></span>
        <div style="font-size: 15px; line-height: 1.7; color: rgba(234, 226, 214, 0.88);">
          <a href="https://maps.google.com/?q=20021+Century+Blvd+Germantown+MD+20874" target="_blank" rel="noopener" style="color: rgba(234, 226, 214, 0.88);">20021 Century Blvd<br>Germantown, MD 20874</a><br>
          <a href="tel:3015694574" style="color: rgb(185, 156, 102); font-weight: 700;">301-569-4574</a>
        </div>
      </div>

      <div data-footer-col style="display: flex; gap: 14px; align-items: flex-start;">
        <span style="flex: 0 0 auto; color: rgb(214, 188, 133); margin-top: 1px;"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5.2l3.4 2"/></svg></span>
        <div style="display: grid; grid-template-columns: auto auto; column-gap: 18px; row-gap: 6px; font-size: 15px; line-height: 1.5;"><span style="color: rgba(234, 226, 214, 0.65);">Mon to Wed</span><span style="color: rgba(234, 226, 214, 0.9); font-weight: 600;">3 PM to 10</span><span style="color: rgba(234, 226, 214, 0.65);">Thu</span><span style="color: rgba(234, 226, 214, 0.9); font-weight: 600;">3 PM to midnight</span><span style="color: rgba(234, 226, 214, 0.65);">Fri</span><span style="color: rgba(234, 226, 214, 0.9); font-weight: 600;">3 PM to 1 AM</span><span style="color: rgba(234, 226, 214, 0.65);">Sat</span><span style="color: rgba(234, 226, 214, 0.9); font-weight: 600;">11 AM to 1 AM</span><span style="color: rgba(234, 226, 214, 0.65);">Sun</span><span style="color: rgba(234, 226, 214, 0.9); font-weight: 600;">11 AM to 10 PM</span></div>
      </div>

      <div data-footer-col style="display: flex; gap: 10px; align-items: center; justify-content: flex-start; flex-wrap: wrap;"><a href="https://www.instagram.com/senortequilas_/" target="_blank" rel="noopener" data-social="instagram" aria-label="Instagram" style="display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 50%; color: rgb(234, 226, 214);"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a><a href="https://www.facebook.com/senortequilasDMV" target="_blank" rel="noopener" data-social="facebook" aria-label="Facebook" style="display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 50%; color: rgb(234, 226, 214);"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-8h2.7l.4-3h-3.1V8.2c0-.9.3-1.5 1.5-1.5h1.7V4.1C16.4 4 15.5 4 14.5 4c-2.2 0-3.7 1.3-3.7 3.8V10H8v3h2.8v8h2.7z"/></svg></a><a href="https://www.google.com/maps/place/?q=place_id:ChIJfQWUP2wstokR0hf-aq2yO5Y" target="_blank" rel="noopener" data-social="google" aria-label="Google" style="display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 50%; color: rgb(234, 226, 214);"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M21.6 12.2c0-.7-.1-1.3-.2-1.9H12v3.6h5.4a4.6 4.6 0 0 1-2 3v2.5h3.2c1.9-1.7 3-4.3 3-7.2z"/><path d="M12 22c2.7 0 5-.9 6.6-2.4l-3.2-2.5c-.9.6-2 1-3.4 1-2.6 0-4.8-1.7-5.6-4.1H3.1v2.6A10 10 0 0 0 12 22z"/><path d="M6.4 14c-.2-.6-.3-1.3-.3-2s.1-1.4.3-2V7.4H3.1a10 10 0 0 0 0 9.2L6.4 14z"/><path d="M12 5.9c1.5 0 2.8.5 3.8 1.5l2.8-2.8A10 10 0 0 0 3.1 7.4L6.4 10C7.2 7.6 9.4 5.9 12 5.9z"/></svg></a><a href="https://www.yelp.com/biz/senor-tequilas-germantown-2" target="_blank" rel="noopener" data-social="yelp" aria-label="Yelp" style="display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 50%; color: rgb(234, 226, 214);"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M11 3.2v8.3c0 .7-.9 1-1.3.4L5.4 6.3c-.3-.4-.2-1 .3-1.2A12 12 0 0 1 9.8 3c.6-.1 1.2.5 1.2 1.1zM10.3 13.6c.5.3.5 1 0 1.3l-3.7 2.4c-.5.3-1.1 0-1.2-.5a11 11 0 0 1-.3-3.2c0-.6.6-1 1.1-.8zM13.4 14.6c-.3-.6.2-1.3.9-1.2l4.3.7c.6.1.9.7.6 1.2a11 11 0 0 1-2 2.5c-.4.4-1.1.2-1.4-.3zM13.6 11.2c-.6.2-1.2-.4-1-1l1.4-4.1c.2-.6.9-.8 1.3-.4a11 11 0 0 1 2 2.4c.3.5 0 1.2-.5 1.3zM12.3 16.4c.6-.2 1.2.3 1.1.9l-.3 4.4c0 .6-.6 1-1.2.8a11 11 0 0 1-3-1.3c-.5-.3-.5-1 0-1.3z"/></svg></a></div>

    </div>

    <div style="border-top: 1px solid rgba(185, 156, 102, 0.28); margin-top: clamp(20px, 3vw, 30px); padding-top: 18px; display: flex; flex-wrap: wrap; gap: 10px 20px; justify-content: space-between; align-items: center; font-size: 13px; color: rgba(234, 226, 214, 0.6);">
      <span>© 2026 Señor Tequila&#39;s · Family-owned in Germantown since 2015</span>
      <span style="letter-spacing: 0.08em;">From Mexico, With Love.</span>
    </div>

  </div>
</footer>

<style>
  /* The port is inline-styled throughout; this block exists only for the things an inline
     style cannot express: media queries. Astro scopes it to this component. */
  footer [data-agave] { display: none; }

  @media (min-width: 1024px) {
    footer [data-agave] {
      display: block;
      position: absolute;
      left: -26px;
      top: 0;
      width: 290px;
      opacity: 0.8;
      pointer-events: none;
    }
  }

  /* The concept rules a hairline between the three information columns. Only once they
     actually sit side by side; stacked, a left border would read as a stray mark. */
  @media (min-width: 900px) {
    footer [data-footer-col] {
      border-left: 1px solid rgba(185, 156, 102, 0.22);
      padding-left: clamp(20px, 3vw, 40px);
    }
  }

  @media (max-width: 899px) {
    footer [data-footer-info] { justify-items: center; text-align: center; }
    footer [data-footer-info] > div { justify-content: center; }
  }
</style>
